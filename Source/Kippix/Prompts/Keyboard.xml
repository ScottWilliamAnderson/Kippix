<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Keyboard button icons for Kippix (Options > General > Look and feel > Button icons). Same keys as Playnite's own sets. -->
    <!-- Every key is close to square: the hints give each icon a square box (26 x 26), and a wide key cap ("Enter" at 150 x 64)
         came out a few pixels high there, too small to read. So Enter is its arrow, and Page Up / Down are Pg with an arrow. -->
    <DataTemplate x:Key="ButtonPromptA">
        <Viewbox>
            <Grid Width="72" Height="64">
                <Border CornerRadius="10" BorderBrush="{DynamicResource TextBrush}" BorderThickness="5" />
                <Path Data="M 49,20 V 37 H 23 M 32,28 L 23,37 L 32,46" Stroke="{DynamicResource TextBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Grid>
        </Viewbox>
    </DataTemplate>
    <DataTemplate x:Key="ButtonPromptB">
        <Viewbox>
            <Grid Width="72" Height="64">
                <Border CornerRadius="10" BorderBrush="{DynamicResource TextBrush}" BorderThickness="5" />
                <TextBlock Text="Esc" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="30"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
            </Grid>
        </Viewbox>
    </DataTemplate>
