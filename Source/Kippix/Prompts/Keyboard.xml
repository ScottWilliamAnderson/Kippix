                    <Path Data="M 9,25 V 3 M 2,11 L 9,3 L 16,11" Stroke="{DynamicResource TextBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="28" Margin="5,0,0,0" VerticalAlignment="Center" />
