                                                Visibility="{PluginSettings Plugin=Kippix, Path=IsGalleryPickingProfile, FallbackValue=Collapsed}">
                                            <TextBlock Text="{DynamicResource LOC_KX_PickProfilePic}" Style="{StaticResource KX_Text}" />
