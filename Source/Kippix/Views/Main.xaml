                                                                            <TextBlock Text="{Binding Text}" Style="{StaticResource KX_Text}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,10,2,0" />
                                                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource KX_TextDim}" FontSize="15" TextTrimming="CharacterEllipsis" Margin="2,0,2,0"
