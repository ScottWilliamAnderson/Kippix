                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                                                    <ButtonEx Style="{StaticResource KX_TopBarButton}" Command="{PluginSettings Plugin=Kippix, Path=AchPrevCommand}" ToolTip="{DynamicResource LOC_KX_Previous}">
                                                        <Path Data="{StaticResource KX_IconChevron}" Style="{StaticResource KX_IconPath}" RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
                                                        </Path>
                                                    </ButtonEx>
                                                    <ButtonEx Style="{StaticResource KX_TopBarButton}" Command="{PluginSettings Plugin=Kippix, Path=AchNextCommand}" ToolTip="{DynamicResource LOC_KX_Next}" Margin="10,0,0,0">
                                                        <Path Data="{StaticResource KX_IconChevron}" Style="{StaticResource KX_IconPath}" />
                                                    </ButtonEx>
                                                </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <!-- details + tip -->
                                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden" Focusable="False">
                                                <StackPanel Margin="30,0,0,0" Width="1040" HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=AchDetailAlign, FallbackValue=Left}">
                                                    <!-- (0.90) Showcase: the icon big and in the middle, edged and glowing in the rarity colour -->
                                                    <StackPanel Margin="0,0,0,22" HorizontalAlignment="Center" Visibility="{PluginSettings Plugin=Kippix, Path=IsAchDetailShowcase, FallbackValue=Collapsed}">
