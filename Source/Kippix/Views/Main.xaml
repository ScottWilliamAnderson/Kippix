                                                                        </Grid>
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource KX_Text}" FontSize="17" TextTrimming="CharacterEllipsis" Margin="2,8,2,0" />
                                                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource KX_TextDim}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="2,0,2,0" />
