                                                    <Ellipse Width="200" Height="200" Fill="#26FFFFFF" />
                                                    <Path Data="{StaticResource KX_IconLock}" Width="54" Height="54"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=HasAchDetailIcon}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                                                    <Grid Width="200" Height="200"><Grid.Clip><EllipseGeometry Center="100,100" RadiusX="100" RadiusY="100" /></Grid.Clip><Grid.Style><Style TargetType="Grid"><Setter Property="Opacity" Value="1" /><Style.Triggers><DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=AchDetailDimmed}" Value="True"><Setter Property="Opacity" Value="0.4" /></DataTrigger></Style.Triggers></Style></Grid.Style><Image Source="{PluginSettings Plugin=Kippix, Path=AchDetailIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" /></Grid>
