<ButtonEx x:Name="KX_GallerySortOld" Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=GallerySortCommand}" CommandParameter="1"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource LOC_KX_OldestFirst}" VerticalAlignment="Center" /></StackPanel><Border Height="3" CornerRadius="1.5" Background="{DynamicResource KX_AccentBrush}" Margin="0,4,0,-7" Visibility="{PluginSettings Plugin=Kippix, Path=GallerySortOldest, FallbackValue=Collapsed}" /></StackPanel></ButtonEx>
