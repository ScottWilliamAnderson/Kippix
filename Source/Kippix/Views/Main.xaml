                                                                                <Border CornerRadius="14" Visibility="{Binding HasThumb, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <Border.Background><ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" /></Border.Background>
                                                                                </Border>
                                                                                <Border x:Name="Gold" CornerRadius="14" BorderThickness="2" BorderBrush="#FFE8B931" Visibility="Collapsed" />
                                                                            </Grid>
                                                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Text}" Style="{StaticResource KX_Text}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{Binding Sub}" Style="{StaticResource KX_TextDim}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                                                <Border x:Name="BadgeBox" CornerRadius="9" Background="#16FFFFFF" Padding="9,1" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                                                        Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <TextBlock x:Name="BadgeText" Text="{Binding Badge}" Style="{StaticResource KX_TextSub}" FontSize="12" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding BadgeHot}" Value="True">
                                                                            <Setter TargetName="Gold" Property="Visibility" Value="Visible" />
                                                                            <Setter TargetName="BadgeBox" Property="Background" Value="#33E8B931" />
                                                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#FFF5D06A" />
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#16FFFFFF" /></Trigger>
                                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
