                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOC_KX_StorePrices}" Style="{StaticResource KX_SectionHeader}" Margin="2,12,0,8" />
                                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOC_KX_StoreChecking}" Style="{StaticResource KX_TextSub}" Margin="2,0,0,8"
                                                           Visibility="{PluginSettings Plugin=Kippix, Path=StorePricesLoading, FallbackValue=Collapsed}" />
                                                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Hidden" Focusable="False" MaxHeight="204">
                                                    <ItemsControl x:Name="KX_StorePriceList" ItemsSource="{PluginSettings Plugin=Kippix, Path=StorePrices}" Focusable="False">
