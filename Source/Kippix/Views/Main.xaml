                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchDetailRarityPct}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="40" HorizontalAlignment="Center" Margin="0,14,0,0" />
