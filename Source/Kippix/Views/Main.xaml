                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ButtonEx Command="{Binding Command}" FocusVisualStyle="{x:Null}" Margin="0,-6,24,22" Width="384">
                                                            <ButtonEx.Template>
                                                                <ControlTemplate TargetType="ButtonEx">
                                                                    <Border Padding="0,6,0,0" Background="Transparent">
