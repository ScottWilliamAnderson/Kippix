                                                            <Grid Width="242" Height="242"><Grid.Clip><RectangleGeometry Rect="0,0,242,242" RadiusX="30" RadiusY="30" /></Grid.Clip><Grid.Style><Style TargetType="Grid"><Setter Property="Opacity" Value="1" /><Style.Triggers><DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=AchDetailDimmed}" Value="True"><Setter Property="Opacity" Value="0.4" /></DataTrigger></Style.Triggers></Style></Grid.Style><Image Source="{PluginSettings Plugin=Kippix, Path=AchDetailIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" /></Grid>
                                                        </Grid>
