<ButtonEx x:Name="KX_GallerySettingsChip" Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=GallerySettingsCommand}"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="{StaticResource KX_IconGear}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" Margin="0,0,10,0" /><TextBlock Text="{DynamicResource LOC_KX_GalleryFolderSettings}" VerticalAlignment="Center" /></StackPanel></StackPanel></ButtonEx>
