                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Width="24" Height="24" Focusable="False" /><TextBlock Text="{DynamicResource LOC_KX_Close}" Style="{StaticResource KX_TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
