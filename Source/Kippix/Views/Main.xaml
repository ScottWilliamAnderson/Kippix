                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                                            <TextBlock Text="{Binding StoreName}" Style="{StaticResource KX_Text}" FontSize="19" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{DynamicResource LOC_KX_StoreBest}" Style="{StaticResource KX_Text}" FontSize="13" Foreground="#FFFDE68A"
                                                                                       Visibility="{Binding IsBest, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                            <TextBlock Text="{Binding Note}" Style="{StaticResource KX_TextDim}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                                                       Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Border Background="#FF2E7D32" CornerRadius="8" Padding="7,0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                    Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <TextBlock Text="{Binding DiscountText}" Style="{StaticResource KX_Text}" FontSize="14" />
                                                                            </Border>
                                                                            <TextBlock Text="{Binding OldPriceText}" Style="{StaticResource KX_TextDim}" FontSize="14" TextDecorations="Strikethrough" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                       Visibility="{Binding HasOldPrice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                            <TextBlock Text="{Binding PriceText}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="20" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </ButtonEx>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=StoreLowestText}" Style="{StaticResource KX_TextDim}" FontSize="16" Margin="2,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreLowest, FallbackValue=Collapsed}" />
                                                <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=StoreHighestText}" Style="{StaticResource KX_TextDim}" FontSize="16" Margin="2,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreHighest, FallbackValue=Collapsed}" />
                                                <!-- buttons in a 4-wide grid (hidden ones take no space) -->
                                                <UniformGrid x:Name="KX_StoreActions" DockPanel.Dock="Top" Columns="4" Margin="0,14,0,0">
                                                    <ButtonEx Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=StoreOpenPageCommand}" Margin="0,0,10,10">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource KX_IconGlobe}" Style="{StaticResource KX_IconPath}" Width="18" Height="18" Margin="0,0,10,0" />
                                                            <TextBlock Text="{DynamicResource LOC_KX_ActStorePage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                        </StackPanel>
                                                    </ButtonEx>
                                                    <ButtonEx Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=StoreWishCommand}" Margin="0,0,10,10" Visibility="{PluginSettings Plugin=Kippix, Path=StoreCanWish, FallbackValue=Collapsed}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource KX_IconHeart}" Width="18" Height="18" Margin="0,0,10,0">
                                                                <Path.Style>
                                                                    <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=StoreGameWished}" Value="True">
                                                                                <Setter Property="Fill" Value="#FFF43F5E" />
                                                                                <Setter Property="Stroke" Value="#FFF43F5E" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreWishShort}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                        </StackPanel>
                                                    </ButtonEx>
                                                    <ButtonEx Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=StoreRequirementsCommand}" Margin="0,0,10,10" Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreRequirements, FallbackValue=Collapsed}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource KX_IconDesktop}" Style="{StaticResource KX_IconPath}" Width="18" Height="18" Margin="0,0,10,0" />
                                                            <TextBlock Text="{DynamicResource LOC_KX_ActReqs}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                        </StackPanel>
                                                    </ButtonEx>
                                                    <ButtonEx x:Name="KX_StoreDlcButton" Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=StoreDlcCommand}" Margin="0,0,10,10" Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreDlc, FallbackValue=Collapsed}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource KX_IconStore}" Style="{StaticResource KX_IconPath}" Width="18" Height="18" Margin="0,0,10,0" />
                                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreDlcText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                        </StackPanel>
                                                    </ButtonEx>
                                                    <ButtonEx Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=StoreEditionsCommand}" Margin="0,0,10,10" Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreEditions, FallbackValue=Collapsed}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource KX_IconTag}" Style="{StaticResource KX_IconPath}" Width="18" Height="18" Margin="0,0,10,0" />
                                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreEditionsText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                        </StackPanel>
                                                    </ButtonEx>
                                                                                                    <ButtonEx x:Name="KX_StoreSimilarButton" Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=StoreSimilarCommand}" Margin="0,0,10,10" Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreSimilar, FallbackValue=Collapsed}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource KX_IconSearch}" Style="{StaticResource KX_IconPath}" Width="18" Height="18" Margin="0,0,10,0" />
                                                            <TextBlock Text="{DynamicResource LOC_KX_MoreLikeThis}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                        </StackPanel>
                                                    </ButtonEx>
                                                    <ButtonEx Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=StoreAlertCommand}" Margin="0,0,10,10" Visibility="{PluginSettings Plugin=Kippix, Path=StoreGameWished, FallbackValue=Collapsed}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource KX_IconBell}" Style="{StaticResource KX_IconPath}" Width="18" Height="18" Margin="0,0,10,0" />
                                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreAlertText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                        </StackPanel>
                                                    </ButtonEx>
                                                </UniformGrid>
                                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOC_KX_AboutGame}" Style="{StaticResource KX_SectionHeader}" Margin="2,8,0,6"
                                                           Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreDescription, FallbackValue=Collapsed}" />
                                                <!-- the start of the description; A opens all of it full screen -->
                                                <ButtonEx x:Name="KX_StoreDescButton" Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=StoreDescriptionCommand}" Padding="16,12" VerticalAlignment="Top"
                                                          Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreDescription, FallbackValue=Collapsed}">
                                                    <StackPanel>
                                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreGameDescription}" Style="{StaticResource KX_TextSub}" TextWrapping="Wrap" FontSize="18" MaxHeight="110" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Opacity="0.75">
                                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptA}" Width="20" Height="20" Focusable="False" />
                                                            <TextBlock Text="{DynamicResource LOC_KX_ReadMore}" Style="{StaticResource KX_TextDim}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ButtonEx>
                                            </DockPanel>
                                        </Grid>
                                    </Grid>
                                </DockPanel>

                                <!-- filter picker (sort, genre & tags, price, features) -->
                                <Border Background="#E60A0B0E" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle"
                                        Visibility="{PluginSettings Plugin=Kippix, Path=IsStorePickerOpen, FallbackValue=Collapsed}">
                                    <Border Style="{StaticResource KX_Panel}" Width="1360" MaxHeight="860" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=StorePickerTitle}" Style="{StaticResource KX_TextTitle}" FontSize="34" Margin="12,0,0,16" />
                                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,14,0,0" Opacity="0.75">
                                                <ContentControl ContentTemplate="{DynamicResource ButtonPromptA}" Width="24" Height="24" Focusable="False" />
                                                <TextBlock Text="{DynamicResource LOC_KX_Select}" Style="{StaticResource KX_TextDim}" Margin="8,0,24,0" VerticalAlignment="Center" />
                                                <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Width="24" Height="24" Focusable="False" />
                                                <TextBlock Text="{DynamicResource LOC_KX_Back}" Style="{StaticResource KX_TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- price: slide to any amount (Left / Right), A to use it -->
                                            <ButtonEx x:Name="KX_StorePriceSlider" DockPanel.Dock="Bottom" Style="{StaticResource KX_MenuButton}" Padding="20,14" Margin="0,12,8,0"
                                                      Command="{PluginSettings Plugin=Kippix, Path=ApplyPriceSliderCommand}"
                                                      Visibility="{PluginSettings Plugin=Kippix, Path=StorePickerSlider, FallbackValue=Collapsed}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{DynamicResource LOC_KX_PriceSlider}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{PluginSettings Plugin=Kippix, Path=PriceSliderText}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Grid Width="560" Height="24" HorizontalAlignment="Left" Margin="0,14,0,2">
                                                        <Border Height="6" CornerRadius="3" Background="#33FFFFFF" VerticalAlignment="Center" />
                                                        <Border Height="6" CornerRadius="3" Background="{DynamicResource KX_AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                Width="{PluginSettings Plugin=Kippix, Path=PriceSliderFill, FallbackValue=560}" />
                                                        <Border Width="24" Height="24" CornerRadius="12" Background="White" HorizontalAlignment="Left"
                                                                Margin="{PluginSettings Plugin=Kippix, Path=PriceSliderKnob, FallbackValue='548,0,0,0'}" />
                                                    </Grid>
                                                    <TextBlock Text="{DynamicResource LOC_KX_PriceSliderHelp}" Style="{StaticResource KX_TextDim}" FontSize="15" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </ButtonEx>
                                            <CheckBoxEx DockPanel.Dock="Bottom" Style="{StaticResource KX_SwitchRow}" IsChecked="{PluginSettings Plugin=Kippix, Path=StoreHideFree, Mode=TwoWay}" Margin="0,12,8,0"
                                                        Visibility="{PluginSettings Plugin=Kippix, Path=StorePickerSlider, FallbackValue=Collapsed}">
                                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource KX_IconTag}" Style="{StaticResource KX_IconPath}" Margin="0,0,16,0" /><TextBlock Text="{DynamicResource LOC_KX_HideFree}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" /></StackPanel>
                                            </CheckBoxEx>
                                            <ButtonEx DockPanel.Dock="Top" Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=StorePickerSearchCommand}"
                                                      Margin="0,0,8,14" MinHeight="62" Visibility="{PluginSettings Plugin=Kippix, Path=StorePickerSearchable, FallbackValue=Collapsed}">
                                                <Grid>
                                                    <Border CornerRadius="12" Background="#1FFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="-12,-6" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource KX_IconSearch}" Style="{StaticResource KX_IconPath}" Width="22" Height="22" Margin="0,0,14,0" />
                                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StorePickerSearchText}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </ButtonEx>
                                            <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                                                <ItemsControl x:Name="KX_StorePickerList" ItemsSource="{PluginSettings Plugin=Kippix, Path=StorePickerItems}" Focusable="False">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{Binding Command}" Width="428" MinHeight="56" Margin="0,0,8,6">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Path Data="{StaticResource KX_IconSearch}" Style="{StaticResource KX_IconPath}" Width="18" Height="18" Margin="0,0,12,0"
                                                                          Visibility="{Binding IsSearch, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <Path Data="{StaticResource KX_IconCheck}" Width="18" Height="18" Margin="0,0,12,0">
                                                                        <Path.Style>
                                                                            <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                                            <Condition Binding="{Binding IsSearch}" Value="False" />
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Path.Style>
                                                                    </Path>
                                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                                                </StackPanel>
                                                            </ButtonEx>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Border>

                                <!-- full screen pictures and trailers: Left / Right or LB / RB step through, A plays, Down to the trailer controls, B closes -->
                                <Grid Background="Black" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle"
                                      Visibility="{PluginSettings Plugin=Kippix, Path=IsStoreViewerOpen, FallbackValue=Collapsed}">
                                    <Image Source="{PluginSettings Plugin=Kippix, Path=StoreViewerImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"
                                           Visibility="{PluginSettings Plugin=Kippix, Path=StoreViewerShowImage, FallbackValue=Visible}" />
                                    <MediaElement x:Name="KX_StoreViewerVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" IsHitTestVisible="False"
                                                  Source="{PluginSettings Plugin=Kippix, Path=StoreViewerVideo}" IsMuted="{PluginSettings Plugin=Kippix, Path=StoreVideoMuted, FallbackValue=False}" Volume="0.8"
                                                  Visibility="{PluginSettings Plugin=Kippix, Path=StoreViewerShowVideo, FallbackValue=Collapsed}" />
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#CC111317" CornerRadius="20" Padding="26,12"
                                            Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreViewerStatus, FallbackValue=Collapsed}">
                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreViewerStatus}" Style="{StaticResource KX_Text}" />
                                    </Border>
                                    <ButtonEx x:Name="KX_StoreViewerButton" Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=StoreViewerActionCommand}"
                                              Width="2" Height="2" MinHeight="0" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <!-- trailer controls: Down from the picture, Up back; Left / Right between them -->
                                    <StackPanel x:Name="KX_StoreViewerControls" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,118"
                                                Visibility="{PluginSettings Plugin=Kippix, Path=StoreViewerIsTrailer, FallbackValue=Collapsed}">
                                        <StackPanel.Resources>
                                            <Style x:Key="KX_ViewerRoundButton" TargetType="ButtonEx" BasedOn="{StaticResource KX_PillButton}">
                                                <Setter Property="Width" Value="64" />
                                                <Setter Property="MinWidth" Value="64" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="8,0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            </Style>
                                        </StackPanel.Resources>
                                        <Grid Width="900" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid Height="6" VerticalAlignment="Center">
                                                <Border CornerRadius="3" Background="#40FFFFFF" />
                                                <Border CornerRadius="3" Background="{DynamicResource KX_AccentBrush}" HorizontalAlignment="Left" Width="{PluginSettings Plugin=Kippix, Path=StoreViewerProgress, FallbackValue=0}" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreViewerTime}" Style="{StaticResource KX_TextSub}" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Contained">
                                        <ButtonEx Style="{StaticResource KX_ViewerRoundButton}" ToolTip="{DynamicResource LOC_KX_Back10}" Command="{PluginSettings Plugin=Kippix, Path=StoreViewerBackCommand}">
                                            <Path Data="{StaticResource KX_IconRewind}" Style="{StaticResource KX_IconPath}" Width="22" Height="22" />
                                        </ButtonEx>
                                        <ButtonEx x:Name="KX_StoreViewerPlay" Style="{StaticResource KX_ViewerRoundButton}" ToolTip="{DynamicResource LOC_KX_PlayPause}" Command="{PluginSettings Plugin=Kippix, Path=StoreViewerActionCommand}">
                                            <Path Width="22" Height="22">
                                                <Path.Style>
                                                    <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                        <Setter Property="Data" Value="{StaticResource KX_IconPlay}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=StoreViewerPlaying}" Value="True"><Setter Property="Data" Value="{StaticResource KX_IconPause}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </ButtonEx>
                                        <ButtonEx Style="{StaticResource KX_ViewerRoundButton}" ToolTip="{DynamicResource LOC_KX_Forward10}" Command="{PluginSettings Plugin=Kippix, Path=StoreViewerForwardCommand}">
                                            <Path Data="{StaticResource KX_IconForward}" Style="{StaticResource KX_IconPath}" Width="22" Height="22" />
                                        </ButtonEx>
                                        <ButtonEx Style="{StaticResource KX_ViewerRoundButton}" ToolTip="{DynamicResource LOC_KX_SoundOnOff}" Command="{PluginSettings Plugin=Kippix, Path=StoreViewerSoundCommand}">
                                            <Path Width="22" Height="22">
                                                <Path.Style>
                                                    <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                        <Setter Property="Data" Value="{StaticResource KX_IconSpeaker}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=StoreVideoMuted}" Value="True"><Setter Property="Data" Value="{StaticResource KX_IconMute}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </ButtonEx>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border VerticalAlignment="Bottom" Padding="60,70,60,34">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#CC000000" Offset="0.7" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{PluginSettings Plugin=Kippix, Path=StoreViewerCounter}" Style="{StaticResource KX_TextSub}" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" Opacity="0.8">
                                                <ContentControl ContentTemplate="{DynamicResource ButtonPromptLB}" Width="24" Height="24" Focusable="False" />
                                                <ContentControl ContentTemplate="{DynamicResource ButtonPromptRB}" Width="24" Height="24" Focusable="False" Margin="6,0,0,0" />
                                                <TextBlock Text="{DynamicResource LOC_KX_PrevNext}" Style="{StaticResource KX_TextDim}" Margin="8,0,24,0" VerticalAlignment="Center" />
                                                <ContentControl ContentTemplate="{DynamicResource ButtonPromptA}" Width="24" Height="24" Focusable="False" />
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreViewerActionText}" Style="{StaticResource KX_TextDim}" Margin="8,0,24,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource LOC_KX_ViewerControlsHint}" Style="{StaticResource KX_TextDim}" Margin="0,0,24,0" VerticalAlignment="Center"
                                                           Visibility="{PluginSettings Plugin=Kippix, Path=StoreViewerIsTrailer, FallbackValue=Collapsed}" />
                                                <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Width="24" Height="24" Focusable="False" />
                                                <TextBlock Text="{DynamicResource LOC_KX_Close}" Style="{StaticResource KX_TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                                <!-- reader: one review at a time (LB / RB, Left / Right), filters on top; also system requirements -->
                                <Grid Background="#F20A0B0E" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle"
                                      Visibility="{PluginSettings Plugin=Kippix, Path=IsStoreReaderOpen, FallbackValue=Collapsed}">
                                    <DockPanel Margin="200,70,200,40">
                                        <ItemsControl x:Name="KX_StoreReaderChips" DockPanel.Dock="Top" ItemsSource="{PluginSettings Plugin=Kippix, Path=ReaderChips}" Focusable="False" Margin="0,0,0,24"
                                                      Visibility="{PluginSettings Plugin=Kippix, Path=ReaderIsReview, FallbackValue=Collapsed}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ButtonEx Style="{StaticResource KX_ChipButton}" Command="{Binding Command}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource KX_IconCheck}" Style="{StaticResource KX_IconPath}" Width="16" Height="16" Margin="0,0,8,0"
                                                                  Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ButtonEx>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,16,0" VerticalAlignment="Center"
                                                        Visibility="{PluginSettings Plugin=Kippix, Path=ReaderIsReview, FallbackValue=Collapsed}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#CCB83A3A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=ReaderPositive}" Value="True"><Setter Property="Background" Value="#CC2E7D32" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Path Stroke="White" Width="20" Height="20">
                                                        <Path.Style>
                                                            <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                                <Setter Property="Data" Value="{StaticResource KX_IconClose}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=ReaderPositive}" Value="True"><Setter Property="Data" Value="{StaticResource KX_IconCheck}" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ReaderTitle}" Style="{StaticResource KX_TextTitle}" FontSize="36" />
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ReaderSub}" Style="{StaticResource KX_TextSub}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ReaderCounter}" Style="{StaticResource KX_TextSub}" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,18,0,0" Opacity="0.8">
                                            <StackPanel Orientation="Horizontal" Visibility="{PluginSettings Plugin=Kippix, Path=ReaderIsReview, FallbackValue=Collapsed}">
                                                <ContentControl ContentTemplate="{DynamicResource ButtonPromptLB}" Width="24" Height="24" Focusable="False" />
                                                <ContentControl ContentTemplate="{DynamicResource ButtonPromptRB}" Width="24" Height="24" Focusable="False" Margin="6,0,0,0" />
                                                <TextBlock Text="{DynamicResource LOC_KX_PrevNextReview}" Style="{StaticResource KX_TextDim}" Margin="8,0,24,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- Up / Down scroll (the same hint as the game page's description reader) -->
                                            <Path Data="{StaticResource KX_IconSort}" Style="{StaticResource KX_InfoIcon}" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource LOC_KX_ReaderScroll}" Style="{StaticResource KX_TextDim}" Margin="0,0,24,0" VerticalAlignment="Center" />
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Width="24" Height="24" Focusable="False" />
                                            <TextBlock Text="{DynamicResource LOC_KX_Close}" Style="{StaticResource KX_TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=ReaderStatus}" Style="{StaticResource KX_TextSub}" Margin="0,0,0,12"
                                                   Visibility="{PluginSettings Plugin=Kippix, Path=HasReaderStatus, FallbackValue=Collapsed}" />
                                        <Border CornerRadius="16" BorderThickness="1.5" Padding="28,20" Background="#14FFFFFF">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#26FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=KX_StoreReaderScroll}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#99FFFFFF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ScrollViewer x:Name="KX_StoreReaderScroll" VerticalScrollBarVisibility="Hidden" Focusable="True" FocusVisualStyle="{x:Null}">
                                                <StackPanel>
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ReaderText}" Style="{StaticResource KX_Text}" FontSize="22" TextWrapping="Wrap" LineHeight="34"
                                                               Visibility="{PluginSettings Plugin=Kippix, Path=ReaderShowText, FallbackValue=Visible}" />
                                                    <!-- system requirements: bold headings, the specs close together -->
                                                    <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=ReaderSections}" Focusable="False" Visibility="{PluginSettings Plugin=Kippix, Path=HasReaderSections, FallbackValue=Collapsed}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,30">
                                                                    <TextBlock Text="{Binding Heading}" Style="{StaticResource KX_TextTitle}" FontSize="32" Margin="0,0,0,8" />
                                                                    <TextBlock Text="{Binding Body}" Style="{StaticResource KX_Text}" FontSize="20" TextWrapping="Wrap" LineHeight="29"
                                                                               Visibility="{Binding HasBody, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <!-- Your PC: memory, processor, graphics against the game's minimum / recommended -->
                                                                    <ItemsControl ItemsSource="{Binding Checks}" Focusable="False" Margin="0,16,0,0"
                                                                                  Visibility="{Binding HasChecks, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Margin="0,0,0,20" Width="640" HorizontalAlignment="Left">
                                                                                    <Grid Margin="0,0,0,6">
                                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="20" Margin="0,0,14,0" />
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Mine}" Style="{StaticResource KX_TextDim}" FontSize="17" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="{Binding SummaryBrush}" FontSize="17" FontFamily="{DynamicResource FontTitilliumWebBold}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                                                    </Grid>
                                                                                    <!-- yours as a bar; the thin marks are the minimum (dim) and recommended (bright) -->
                                                                                    <Grid Height="18" Visibility="{Binding HasBar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                        <Border CornerRadius="6" Background="#2EFFFFFF" Height="12" />
                                                                                        <Border CornerRadius="6" Background="{Binding Fill}" Width="{Binding FillWidth}" Height="12" HorizontalAlignment="Left" />
                                                                                        <Border Width="3" Background="#8CFFFFFF" HorizontalAlignment="Left" Margin="{Binding MinMark}" CornerRadius="1.5"
                                                                                                Visibility="{Binding HasMinMark, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                                        <Border Width="3" Background="#FFFFFFFF" HorizontalAlignment="Left" Margin="{Binding RecMark}" CornerRadius="1.5"
                                                                                                Visibility="{Binding HasRecMark, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                                    </Grid>
                                                                                    <TextBlock Text="{Binding MinLine}" Style="{StaticResource KX_TextDim}" FontSize="16" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                                                                               Visibility="{Binding HasMinLine, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                                    <TextBlock Text="{Binding RecLine}" Style="{StaticResource KX_TextDim}" FontSize="16" TextTrimming="CharacterEllipsis"
                                                                                               Visibility="{Binding HasRecLine, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <!-- Your PC: each drive, used / free, and whether the game fits -->
                                                                    <ItemsControl ItemsSource="{Binding Drives}" Focusable="False" Margin="0,16,0,0"
                                                                                  Visibility="{Binding HasDrives, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Margin="0,0,0,16" Width="640" HorizontalAlignment="Left">
                                                                                    <Grid Margin="0,0,0,6">
                                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="20" Margin="0,0,14,0" />
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource KX_TextDim}" FontSize="17" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Grid.Column="2" Text="{Binding FitsText}" FontSize="17" FontFamily="{DynamicResource FontTitilliumWebBold}" VerticalAlignment="Center"
                                                                                                   Visibility="{Binding HasFits, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Foreground" Value="#FFF43F5E" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding FitsGood}" Value="True"><Setter Property="Foreground" Value="#FF4ADE80" /></DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </Grid>
                                                                                    <Grid Height="12">
                                                                                        <Border CornerRadius="6" Background="#2EFFFFFF" />
                                                                                        <Border CornerRadius="6" Background="{Binding Fill}" Width="{Binding UsedWidth}" HorizontalAlignment="Left" />
                                                                                    </Grid>
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </DockPanel>
                                </Grid>
                                </Grid>
                            </Border>

                            <!-- ===================== BROWSER (store pages, buying) ===================== -->
                            <!-- The page itself is Playnite's Chromium, put into KX_BrowserHost by the helper; it only exists while this is open. -->
                            <Grid x:Name="KX_BrowserView" Background="#FF0A0B0E"
                                  Visibility="{PluginSettings Plugin=Kippix, Path=IsBrowserOpen, FallbackValue=Collapsed}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Height="70" Background="#FF101216" BorderBrush="{DynamicResource KX_HairlineBrush}" BorderThickness="0,0,0,1">
                                        <DockPanel Margin="20,0">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ButtonEx Style="{StaticResource KX_MenuButton}" Focusable="False" Command="{PluginSettings Plugin=Kippix, Path=BrowserBackCommand}" Width="54" MinHeight="50" Padding="0" Margin="0,0,4,0">
                                                    <Path Data="{StaticResource KX_IconChevron}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
                                                    </Path>
                                                </ButtonEx>
                                                <ButtonEx Style="{StaticResource KX_MenuButton}" Focusable="False" Command="{PluginSettings Plugin=Kippix, Path=BrowserForwardCommand}" Width="54" MinHeight="50" Padding="0" Margin="0,0,4,0">
                                                    <Path Data="{StaticResource KX_IconChevron}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" />
                                                </ButtonEx>
                                                <ButtonEx Style="{StaticResource KX_MenuButton}" Focusable="False" Command="{PluginSettings Plugin=Kippix, Path=BrowserReloadCommand}" Width="54" MinHeight="50" Padding="0" Margin="0,0,16,0">
                                                    <Path Data="{StaticResource KX_IconRefresh}" Style="{StaticResource KX_IconPath}" Width="22" Height="22" />
                                                </ButtonEx>
                                            </StackPanel>
                                            <ButtonEx DockPanel.Dock="Right" Style="{StaticResource KX_MenuButton}" Focusable="False" Command="{PluginSettings Plugin=Kippix, Path=BrowserCloseCommand}" Width="54" MinHeight="50" Padding="0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource KX_IconClose}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" />
                                            </ButtonEx>
                                            <TextBlock DockPanel.Dock="Right" Text="{PluginSettings Plugin=Kippix, Path=BrowserZoomText}" Style="{StaticResource KX_TextDim}" VerticalAlignment="Center" Margin="16,0,16,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{DynamicResource LOC_KX_Loading}" Style="{StaticResource KX_TextDim}" VerticalAlignment="Center" Margin="16,0,0,0"
                                                       Visibility="{PluginSettings Plugin=Kippix, Path=BrowserLoading, FallbackValue=Collapsed}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=BrowserTitle}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=BrowserAddress}" Style="{StaticResource KX_TextDim}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border DockPanel.Dock="Bottom" Height="54" Background="#FF101216" BorderBrush="{DynamicResource KX_HairlineBrush}" BorderThickness="0,1,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="26,0" VerticalAlignment="Center" Opacity="0.8">
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptLS}" Width="24" Height="24" Focusable="False" />
                                            <TextBlock Text="{DynamicResource LOC_KX_BrowserMove}" Style="{StaticResource KX_TextDim}" Margin="8,0,22,0" VerticalAlignment="Center" />
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptA}" Width="24" Height="24" Focusable="False" />
                                            <TextBlock Text="{DynamicResource LOC_KX_BrowserClick}" Style="{StaticResource KX_TextDim}" Margin="8,0,22,0" VerticalAlignment="Center" />
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptRS}" Width="24" Height="24" Focusable="False" />
                                            <TextBlock Text="{DynamicResource LOC_KX_BrowserScroll}" Style="{StaticResource KX_TextDim}" Margin="8,0,22,0" VerticalAlignment="Center" />
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptY}" Width="24" Height="24" Focusable="False" />
                                            <TextBlock Text="{DynamicResource LOC_KX_BrowserTypeHint}" Style="{StaticResource KX_TextDim}" Margin="8,0,22,0" VerticalAlignment="Center" />
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptLB}" Width="24" Height="24" Focusable="False" />
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptRB}" Width="24" Height="24" Focusable="False" Margin="6,0,0,0" />
                                            <TextBlock Text="{DynamicResource LOC_KX_BrowserZoom}" Style="{StaticResource KX_TextDim}" Margin="8,0,22,0" VerticalAlignment="Center" />
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptX}" Width="24" Height="24" Focusable="False" />
                                            <TextBlock Text="{DynamicResource LOC_KX_BrowserReload}" Style="{StaticResource KX_TextDim}" Margin="8,0,22,0" VerticalAlignment="Center" />
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Width="24" Height="24" Focusable="False" />
                                            <TextBlock Text="{DynamicResource LOC_KX_Back}" Style="{StaticResource KX_TextDim}" Margin="8,0,22,0" VerticalAlignment="Center" />
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptBack}" Width="24" Height="24" Focusable="False" />
                                            <TextBlock Text="{DynamicResource LOC_KX_Close}" Style="{StaticResource KX_TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Grid>
                                        <Border x:Name="KX_BrowserHost" Background="White" />
                                        <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                            <Path x:Name="KX_BrowserCursor" Data="{StaticResource KX_IconCursor}" Fill="White" Stroke="#FF111111" StrokeThickness="1.2" StrokeLineJoin="Round"
                                                  IsHitTestVisible="False" Canvas.Left="960" Canvas.Top="500">
                                                <Path.RenderTransform><ScaleTransform ScaleX="1.9" ScaleY="1.9" /></Path.RenderTransform>
                                            </Path>
                                        </Canvas>
                                    </Grid>
                                </DockPanel>
                            </Grid>

                            <!-- ========== TRAILER, FULL SCREEN (A on the trailer of a game page) ========== -->
                            <Grid x:Name="KX_TrailerView" Background="Black"
                                  KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle"
                                  Visibility="{PluginSettings Plugin=Kippix, Path=IsTrailerFullOpen, FallbackValue=Collapsed}">
                                <MediaElement x:Name="KX_TrailerFull" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" IsHitTestVisible="False"
                                              Source="{PluginSettings Plugin=Kippix, Path=DetTrailerSource}" IsMuted="{PluginSettings Plugin=Kippix, Path=DetTrailerMuted, FallbackValue=False}" Volume="0.8" />
                                <!-- controls (fade away while it plays; any button brings them back) -->
                                <Grid x:Name="KX_TrailerControls" VerticalAlignment="Bottom">
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#CC000000" Offset="0.6" />
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                    <StackPanel Margin="160,90,160,44">
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SelectedGame.DisplayName}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="30" />
                                            <TextBlock Grid.Column="1" Text="{PluginSettings Plugin=Kippix, Path=TrailerTimeText}" Style="{StaticResource KX_TextSub}" FontSize="20" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Width="1600" Height="6" HorizontalAlignment="Left">
                                            <Border CornerRadius="3" Background="#40FFFFFF" />
                                            <Border CornerRadius="3" HorizontalAlignment="Left" Background="White"
                                                    Width="{PluginSettings Plugin=Kippix, Path=TrailerProgressWidth, FallbackValue=0}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                                        <ButtonEx Style="{StaticResource KX_TopBarButton}" Margin="10,0" Width="72" Height="72"
                                                  Command="{PluginSettings Plugin=Kippix, Path=TrailerBackCommand}" ToolTip="{DynamicResource LOC_KX_Back10}">
                                            <Path Data="{StaticResource KX_IconRewind}" Style="{StaticResource KX_IconPath}" Width="30" Height="30" />
                                        </ButtonEx>
                                        <ButtonEx x:Name="KX_TrailerPlayPause" Style="{StaticResource KX_TopBarButton}" Margin="10,0" Width="72" Height="72"
                                                  Command="{PluginSettings Plugin=Kippix, Path=DetToggleTrailerCommand}" ToolTip="{DynamicResource LOC_KX_PlayPause}">
                                            <Path Width="30" Height="30">
                                                <Path.Style>
                                                    <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                        <Setter Property="Data" Value="{StaticResource KX_IconPlay}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=DetTrailerPlaying}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource KX_IconPause}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </ButtonEx>
                                        <ButtonEx Style="{StaticResource KX_TopBarButton}" Margin="10,0" Width="72" Height="72"
                                                  Command="{PluginSettings Plugin=Kippix, Path=TrailerForwardCommand}" ToolTip="{DynamicResource LOC_KX_Forward10}">
                                            <Path Data="{StaticResource KX_IconForward}" Style="{StaticResource KX_IconPath}" Width="30" Height="30" />
                                        </ButtonEx>
                                        <ButtonEx Style="{StaticResource KX_TopBarButton}" Margin="10,0" Width="72" Height="72"
                                                  Command="{PluginSettings Plugin=Kippix, Path=TrailerSoundCommand}" ToolTip="{DynamicResource LOC_KX_TrailerSound}">
                                            <Path Width="30" Height="30">
                                                <Path.Style>
                                                    <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                        <Setter Property="Data" Value="{StaticResource KX_IconSpeaker}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=DetTrailerSound}" Value="False">
                                                                <Setter Property="Data" Value="{StaticResource KX_IconMute}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </ButtonEx>
                                        <ButtonEx Style="{StaticResource KX_TopBarButton}" Margin="10,0" Width="72" Height="72"
                                                  Command="{PluginSettings Plugin=Kippix, Path=TrailerCloseCommand}" ToolTip="{DynamicResource LOC_KX_Close}">
                                            <Path Data="{StaticResource KX_IconClose}" Style="{StaticResource KX_IconPath}" Width="30" Height="30" />
                                        </ButtonEx>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0" Opacity="0.7">
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptLB}" Width="24" Height="24" Focusable="False" />
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptRB}" Width="24" Height="24" Focusable="False" Margin="6,0,0,0" />
                                            <TextBlock Text="{DynamicResource LOC_KX_Skip10}" Style="{StaticResource KX_TextDim}" Margin="8,0,24,0" VerticalAlignment="Center" />
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Width="24" Height="24" Focusable="False" />
                                            <TextBlock Text="{DynamicResource LOC_KX_Back}" Style="{StaticResource KX_TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- ===================== MASTER EDIT: moving one element by hand ===================== -->
                            <!-- (0.99.3) the edit grid while a board tile picked up in precise edit moves (precise edit's own grid is in the layer below) -->
                            <Rectangle IsHitTestVisible="False" Fill="{PluginSettings Plugin=Kippix, Path=EditGridBrush}"
                                       Visibility="{PluginSettings Plugin=Kippix, Path=BoardGridShown, FallbackValue=Collapsed}" />
                            <Grid x:Name="KX_MasterLayer" Visibility="{PluginSettings Plugin=Kippix, Path=IsMasterMoving, FallbackValue=Collapsed}">
                                <!-- (0.99.1) normal editing: the grid behind (its squares are the grid size, Layout › Grid; tiny ones are drawn every few) -->
                                <Rectangle IsHitTestVisible="False" Fill="{PluginSettings Plugin=Kippix, Path=EditGridBrush}"
                                           Visibility="{PluginSettings Plugin=Kippix, Path=FreeGridShown, FallbackValue=Collapsed}" />
                                <!-- takes the mouse while editing: drag what's being moved, point with Free move -->
                                <Canvas x:Name="KX_MasterCanvas" Background="Transparent" Cursor="SizeAll">
                                    <!-- (0.90) the screen's centre lines: only while what's moving is near one (the helper places them) -->
                                    <Rectangle x:Name="KX_GuideV" Fill="#FF5CE1E6" Width="2" Height="10" IsHitTestVisible="False" Visibility="Collapsed" />
                                    <Rectangle x:Name="KX_GuideH" Fill="#FF5CE1E6" Width="10" Height="2" IsHitTestVisible="False" Visibility="Collapsed" />
                                    <Border x:Name="KX_MasterOutline" Focusable="True" FocusVisualStyle="{x:Null}" CornerRadius="10" IsHitTestVisible="False"
                                            BorderThickness="3" BorderBrush="#FFFFD54F" Background="#1AFFD54F" Width="100" Height="100" />
                                    <Path x:Name="KX_FreeCursor" Data="{StaticResource KX_IconCursor}" Fill="#FFFFD54F" Stroke="#FF111111" StrokeThickness="1.4" StrokeLineJoin="Round"
                                          IsHitTestVisible="False" RenderTransformOrigin="0,0"
                                          Visibility="{PluginSettings Plugin=Kippix, Path=FreeCursorShown, FallbackValue=Collapsed}">
                                        <Path.RenderTransform><ScaleTransform ScaleX="2" ScaleY="2" /></Path.RenderTransform>
                                        <Path.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.6" /></Path.Effect>
                                    </Path>
                                </Canvas>
                                <!-- (0.99.1) the same bar as editing the board: at the bottom, what's going on, then what the buttons do -->
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8" Padding="26,8,26,6" CornerRadius="14" MaxWidth="1720"
                                        Background="#F00D0F12" BorderBrush="{DynamicResource KX_AccentBrush}" BorderThickness="1.5" IsHitTestVisible="False">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=MasterMoveName}" Style="{StaticResource KX_Text}" FontSize="16" Opacity="0.9" FontFamily="{DynamicResource FontTitilliumWebBold}" VerticalAlignment="Center" />
                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=MasterMoveText}" Style="{StaticResource KX_Text}" FontSize="16" Opacity="0.75" Margin="14,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <!-- what the buttons do now (pointing, moving, sizing, a widget, Layer / Opacity): ThemeApi.EditHints.cs, the theme's
                                             button icons (or the keyboard's keys) and a label each, in groups; a group wraps onto a second line as a whole -->
                                        <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=FreeHints}" ItemTemplate="{StaticResource KX_EditHintGroupTemplate}" Focusable="False" IsTabStop="False"
                                                      HorizontalAlignment="Center" Margin="0,2,0,0" MaxWidth="1640">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ========== "You just played" (back from a game: what, this session, altogether); never takes the highlight ========== -->
                        <Border x:Name="KX_SessionToast" Panel.ZIndex="87" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,112,56,0" IsHitTestVisible="False" Focusable="False"
                                CornerRadius="18" Background="#F2121418" BorderBrush="#40FFFFFF" BorderThickness="1.5" Padding="16" MaxWidth="560"
                                Visibility="{PluginSettings Plugin=Kippix, Path=SessionToastShown, FallbackValue=Collapsed}">
                            <!-- (shown / hidden by a plain binding: a PluginSettings binding inside a Style trigger here crashed fullscreen on load; the helper fades it in) -->
                            <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.55" /></Border.Effect>
                            <DockPanel>
                                <!-- (an Image, not an ImageBrush: a PluginSettings binding on a brush crashed fullscreen on load) -->
                                <Image DockPanel.Dock="Left" Width="72" Height="96" Margin="0,0,16,0" VerticalAlignment="Center" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant"
                                       Source="{PluginSettings Plugin=Kippix, Path=SessionToastCover}"
                                       Visibility="{PluginSettings Plugin=Kippix, Path=HasSessionToastCover, FallbackValue=Collapsed}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=SessionToastHeader}" Style="{StaticResource KX_SectionHeader}" Margin="0,0,0,4" />
                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=SessionToastGame}" Style="{StaticResource KX_Text}" FontSize="26" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=SessionToastSession}" Visibility="{PluginSettings Plugin=Kippix, Path=HasSessionToastLine1, FallbackValue=Collapsed}" Style="{StaticResource KX_TextSub}" Margin="0,4,0,0" />
                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=SessionToastTotal}" Visibility="{PluginSettings Plugin=Kippix, Path=HasSessionToastLine2, FallbackValue=Collapsed}" Style="{StaticResource KX_TextDim}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- ========== THE THEME'S KEYBOARD (names, notes, Store / achievement searches…): up over the bottom of the screen, so what's being searched stays in view ========== -->
                        <Grid x:Name="KX_KbLayer" Panel.ZIndex="88" Visibility="{PluginSettings Plugin=Kippix, Path=IsKeyboardOpen, FallbackValue=Collapsed}">
                            <Border x:Name="KX_KbOverlay" VerticalAlignment="Bottom" Background="#F70E1014" BorderBrush="#33FFFFFF" BorderThickness="0,1.5,0,0" Padding="0,22,0,22"
                                    KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle">
                                <Border.Resources>
                                    <Style x:Key="KX_KbKeyButton" TargetType="ButtonEx">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Height" Value="74" />
                                        <Setter Property="Width" Value="104" />
                                        <Setter Property="Margin" Value="5" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ButtonEx">
                                                    <Border x:Name="Card" CornerRadius="14" Background="#17FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1.5">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="Background" Value="#38FFFFFF" /><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource KX_AccentBrush}" /></Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#26FFFFFF" /></Trigger>
                                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Background" Value="#55FFFFFF" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Border.Resources>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=KeyboardTitle}" Style="{StaticResource KX_TextSub}" TextWrapping="Wrap" MaxWidth="1200" Margin="6,0,0,10" />
                                    <Border CornerRadius="18" Background="#F0121418" BorderBrush="#55FFFFFF" BorderThickness="1.5" Padding="24,10" Margin="5,0,5,12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=KeyboardText}" Style="{StaticResource KX_Text}" FontSize="34" VerticalAlignment="Center" MaxWidth="1200" TextTrimming="CharacterEllipsis" />
                                            <Border Width="3" Height="38" Background="{DynamicResource KX_AccentBrush}" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.55" AutoReverse="True" /></Storyboard></BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl x:Name="KX_KbKeys" ItemsSource="{PluginSettings Plugin=Kippix, Path=KbKeyRows}" Focusable="False" HorizontalAlignment="Center">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ItemsControl ItemsSource="{Binding Keys}" Focusable="False" HorizontalAlignment="Center">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ButtonEx Command="{Binding Command}">
                                                                <ButtonEx.Style>
                                                                    <Style TargetType="ButtonEx" BasedOn="{StaticResource KX_KbKeyButton}">
                                                                        <Style.Triggers><DataTrigger Binding="{Binding IsWide}" Value="True"><Setter Property="Width" Value="262" /></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </ButtonEx.Style>
                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource KX_Text}" FontSize="28" />
                                                            </ButtonEx>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.8">
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptX}" Width="24" Height="24" Focusable="False" /><TextBlock Text="{DynamicResource LOC_KX_KeyBack}" Style="{StaticResource KX_TextDim}" Margin="8,0,24,0" VerticalAlignment="Center" />
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptY}" Width="24" Height="24" Focusable="False" /><TextBlock Text="{DynamicResource LOC_KX_KeySpace}" Style="{StaticResource KX_TextDim}" Margin="8,0,24,0" VerticalAlignment="Center" />
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptStart}" Width="24" Height="24" Focusable="False" /><TextBlock Text="{DynamicResource LOC_KX_KeyFinish}" Style="{StaticResource KX_TextDim}" Margin="8,0,24,0" VerticalAlignment="Center" />
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Width="24" Height="24" Focusable="False" /><TextBlock Text="{DynamicResource LOC_KX_Cancel}" Style="{StaticResource KX_TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ===== Who's playing? (Profiles: at start-up, or Profile menu › Switch profile) ===== -->
                        <Grid x:Name="KX_WhoView" Panel.ZIndex="85" Background="#F20B0C0F" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle"
                              Visibility="{PluginSettings Plugin=Kippix, Path=IsWhoOpen, FallbackValue=Collapsed}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource LOC_KX_WhosPlaying}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,48" />
                                <ItemsControl x:Name="KX_WhoList" ItemsSource="{PluginSettings Plugin=Kippix, Path=WhoTiles}" Focusable="False" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" MaxWidth="1600" HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ButtonEx Command="{Binding Command}" FocusVisualStyle="{x:Null}" Margin="22,0,22,30">
                                                <ButtonEx.Template>
                                                    <ControlTemplate TargetType="ButtonEx">
                                                        <StackPanel Width="210">
                                                            <Grid Width="180" Height="180" HorizontalAlignment="Center">
                                                                <Ellipse x:Name="Ring" Margin="-8" Stroke="{DynamicResource KX_AccentBrush}" StrokeThickness="4" Opacity="0" />
                                                                <Ellipse Fill="#FF262A33" />
                                                                <TextBlock Text="{Binding Initial}" Style="{StaticResource KX_Text}" FontSize="72" FontFamily="{DynamicResource FontTitilliumWebBold}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Ellipse Visibility="{Binding HasPicture, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Ellipse.Fill><ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" /></Ellipse.Fill>
                                                                </Ellipse>
                                                                <Border Width="40" Height="40" CornerRadius="20" Background="#E6111317" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Path Data="{StaticResource KX_IconLock}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource KX_Text}" FontSize="28" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,18,0,0" />
                                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource KX_TextDim}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.5" /></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ButtonEx.Template>
                                            </ButtonEx>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=WhoHint}" Style="{StaticResource KX_TextDim}" HorizontalAlignment="Center" Margin="0,24,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- ===== Getting started (0.86 redesign; first start, Settings › Help › Take the tour again; every start for testing) =====
                             Kippix's own colours whatever the look: the logo's dark (#0B0D14), purple (#9300C5) and cyan (#5CE1E6).
                             (0.99.10) The step on top (Pick a look as picture tiles, the others as lists), the Good to know strip, then
                             Back, every step and Skip / Next along the bottom. -->
                        <Grid x:Name="KX_WelcomeView" Panel.ZIndex="86" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle"
                              Visibility="{PluginSettings Plugin=Kippix, Path=IsWelcomeOpen, FallbackValue=Collapsed}">
                            <Grid.Resources>
                                <!-- the highlight in here is Kippix purple, whatever accent the look has -->
                                <SolidColorBrush x:Key="KX_AccentBrush" Color="#FF9300C5" />
                                <Style x:Key="KX_WelcomeHeroButton" TargetType="ButtonEx">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="MinWidth" Value="320" />
                                    <Setter Property="Height" Value="72" />
                                    <Setter Property="Padding" Value="44,0" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontSize" Value="{DynamicResource KX_FontPill}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ButtonEx">
                                                <Grid>
                                                    <Border x:Name="Glow" CornerRadius="36" Background="#FF9300C5" Opacity="0">
                                                        <Border.Effect><BlurEffect Radius="30" /></Border.Effect>
                                                    </Border>
                                                    <Border x:Name="Fill" CornerRadius="36" Background="#FF7A00A6" BorderThickness="2" BorderBrush="#33FFFFFF" />
                                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      TextElement.FontFamily="{DynamicResource FontTitilliumWebBold}" TextElement.FontSize="{TemplateBinding FontSize}"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="Fill" Property="Background" Value="#FF9300C5" />
                                                        <Setter TargetName="Fill" Property="BorderBrush" Value="#FF5CE1E6" />
                                                        <Setter TargetName="Glow" Property="Opacity" Value="0.75" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <!-- (0.99.8) the purple-to-cyan stripe (the picture box's top edge) -->
                                <LinearGradientBrush x:Key="KX_TourStripe" StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF9300C5" Offset="0" />
                                    <GradientStop Color="#FF5CE1E6" Offset="1" />
                                </LinearGradientBrush>
                                <!-- (0.99.9) Welcome: one card about Kippix -->
                                <DataTemplate x:Key="KX_TourFeatureTemplate">
                                    <Border Width="396" Margin="0,0,22,0" Padding="28,26" CornerRadius="22" Background="#FF161A26" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                        <StackPanel>
                                            <Border Width="54" Height="54" CornerRadius="16" HorizontalAlignment="Left" Background="#269300C5" BorderBrush="#449300C5" BorderThickness="1">
                                                <Path Data="{Binding Icon}" Style="{StaticResource KX_IconPath}" Stroke="#FF5CE1E6" Width="26" Height="26" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="23" Margin="0,18,0,6" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource KX_TextDim}" FontSize="17" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                                <!-- (0.99.9) the Good to know strip: each tip a few words in white, then its line -->
                                <DataTemplate x:Key="KX_TourNoteTemplate">
                                    <TextBlock Width="380" Margin="0,0,28,12" TextWrapping="Wrap" FontSize="17" Style="{StaticResource KX_TextDim}">
                                        <Run Text="{Binding Title, Mode=OneWay}" Foreground="White" FontFamily="{DynamicResource FontTitilliumWebBold}" /><Run Text="  " /><Run Text="{Binding Text, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                                <!-- (0.99.13) Pick a look: one box (its photo, its name); the picked one edged in white with a tick, the others in its
                                     column dimmed, the highlighted one in cyan with a glow. TargetName only on FrameworkElements. -->
                                <DataTemplate x:Key="KX_TourPickTileTemplate">
                                    <ButtonEx Command="{Binding Command}" CommandParameter="{Binding Key}" Width="480" Height="96" Margin="0,0,0,12" FocusVisualStyle="{x:Null}">
                                        <ButtonEx.Template>
                                            <ControlTemplate TargetType="ButtonEx">
                                                <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                                                    <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                                                    <Border x:Name="Glow" CornerRadius="16" Background="#FF9300C5" Opacity="0" Margin="4" Visibility="Collapsed">
                                                        <Border.Effect><BlurEffect Radius="24" /></Border.Effect>
                                                    </Border>
                                                    <Border x:Name="Card" CornerRadius="16" Background="#FF161A26" BorderBrush="#26FFFFFF" BorderThickness="2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <Border CornerRadius="14,0,0,14">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#339300C5" Offset="0" />
                                                                        <GradientStop Color="#1A5CE1E6" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <Path Data="{Binding Glyph}" Style="{StaticResource KX_IconPath}" Stroke="#FF5CE1E6" Width="36" Height="36" />
                                                            </Border>
                                                            <Border CornerRadius="14,0,0,14" Visibility="{Binding HasPicture, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Border.Background><ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" /></Border.Background>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="22"
                                                                       Margin="22,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <Grid Grid.Column="2" Width="30" Height="30" Margin="0,0,18,0" Visibility="{Binding IsPickedTick, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Ellipse Fill="#FF5CE1E6" />
                                                                <Path Data="{StaticResource KX_IconCheck}" Style="{StaticResource KX_IconPath}" Stroke="#FF0B0D14" StrokeThickness="2.6" Width="14" Height="14" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDimmed}" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.35" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#FFFFFFFF" />
                                                        <Setter TargetName="Card" Property="BorderThickness" Value="3" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#995CE1E6" /></Trigger>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#FF5CE1E6" />
                                                        <Setter TargetName="Card" Property="BorderThickness" Value="3" />
                                                        <Setter TargetName="Glow" Property="Opacity" Value="0.55" />
                                                        <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="Root" Property="Opacity" Value="1" />
                                                        <Setter TargetName="Root" Property="RenderTransform">
                                                            <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03" /></Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ButtonEx.Template>
                                    </ButtonEx>
                                </DataTemplate>
                                <!-- (0.99.9) one choice as a big tile: its picture (or its icon, big), its name; a tick in the corner when it's picked
                                     (a ring when it's a switch that's off); a heading spans the whole width. TargetName only on FrameworkElements. -->
                                <DataTemplate x:Key="KX_TourTileTemplate">
                                    <Grid>
                                        <TextBlock Text="{Binding Text}" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Foreground="#FF5CE1E6" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="18" Margin="2,6,0,14"
                                                   Visibility="{Binding IsHeaderShown, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ButtonEx Command="{Binding Command}" CommandParameter="{Binding Key}" Width="300" Height="236" Margin="0,0,22,22" FocusVisualStyle="{x:Null}"
                                                  Visibility="{Binding IsRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ButtonEx.Template>
                                                <ControlTemplate TargetType="ButtonEx">
                                                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                                                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                                                        <Border x:Name="Glow" CornerRadius="20" Background="#FF9300C5" Opacity="0" Margin="6">
                                                            <Border.Effect><BlurEffect Radius="26" /></Border.Effect>
                                                        </Border>
                                                        <Border x:Name="Card" CornerRadius="20" Background="#FF161A26" BorderBrush="#14FFFFFF" BorderThickness="2">
                                                            <Grid>
                                                                <Grid.RowDefinitions><RowDefinition Height="164" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                                <Border CornerRadius="18,18,0,0">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                            <GradientStop Color="#339300C5" Offset="0" />
                                                                            <GradientStop Color="#1A5CE1E6" Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                    <Path Data="{Binding Glyph}" Style="{StaticResource KX_IconPath}" Stroke="#FF5CE1E6" StrokeThickness="1.6" Width="58" Height="58" />
                                                                </Border>
                                                                <Border CornerRadius="18,18,0,0" Visibility="{Binding HasPicture, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Border.Background><ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" /></Border.Background>
                                                                </Border>
                                                                <StackPanel Grid.Row="1" Margin="18,0,18,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="21" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource KX_TextDim}" FontSize="15" TextTrimming="CharacterEllipsis"
                                                                               Visibility="{Binding HasSub, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                </StackPanel>
                                                                <Grid Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                                                                      Visibility="{Binding IsPickedTick, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Ellipse Fill="#FF5CE1E6"><Ellipse.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.6" /></Ellipse.Effect></Ellipse>
                                                                    <Path Data="{StaticResource KX_IconCheck}" Style="{StaticResource KX_IconPath}" Stroke="#FF0B0D14" StrokeThickness="2.6" Width="17" Height="17" />
                                                                </Grid>
                                                                <Ellipse Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Stroke="#B3FFFFFF" StrokeThickness="2.5" Fill="#66000000"
                                                                         Visibility="{Binding IsSwitchOff, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="#665CE1E6" />
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="#FF5CE1E6" />
                                                            <Setter TargetName="Card" Property="BorderThickness" Value="3" />
                                                            <Setter TargetName="Glow" Property="Opacity" Value="0.6" />
                                                            <Setter TargetName="Root" Property="RenderTransform">
                                                                <Setter.Value><ScaleTransform ScaleX="1.04" ScaleY="1.04" /></Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ButtonEx.Template>
                                        </ButtonEx>
                                    </Grid>
                                </DataTemplate>
                                <!-- (0.99.10) one step along the bottom: its number in a circle (a tick once done) and its name; this one lit up -->
                                <DataTemplate x:Key="KX_TourRailItem">
                                    <StackPanel Orientation="Horizontal" Margin="14,0">
                                        <Grid Width="30" Height="30">
                                            <Ellipse x:Name="Dot" Stroke="#33FFFFFF" StrokeThickness="2" Fill="Transparent" />
                                            <TextBlock x:Name="Num" Text="{Binding Number}" Foreground="#80FFFFFF" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="15"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Path x:Name="Tick" Data="{StaticResource KX_IconCheck}" Style="{StaticResource KX_IconPath}" Stroke="#FF5CE1E6" Width="14" Height="14" Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock x:Name="StepName" Text="{Binding Name}" Foreground="#66FFFFFF" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter TargetName="Dot" Property="Stroke" Value="#995CE1E6" />
                                            <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="StepName" Property="Foreground" Value="#B3FFFFFF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="#FF9300C5" />
                                            <Setter TargetName="Dot" Property="Stroke" Value="#FF9300C5" />
                                            <Setter TargetName="Num" Property="Foreground" Value="White" />
                                            <Setter TargetName="StepName" Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                                <!-- (0.99.7) Back / Skip: quiet text buttons that light up when highlighted -->
                                <Style x:Key="KX_WelcomeQuietButton" TargetType="ButtonEx">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="MinWidth" Value="150" />
                                    <Setter Property="Height" Value="62" />
                                    <Setter Property="Padding" Value="32,0" />
                                    <Setter Property="Foreground" Value="#B3FFFFFF" />
                                    <Setter Property="FontSize" Value="{DynamicResource KX_FontPill}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ButtonEx">
                                                <Border x:Name="Fill" CornerRadius="31" Background="Transparent" BorderThickness="2" BorderBrush="#22FFFFFF">
                                                    <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      TextElement.FontFamily="{DynamicResource FontTitilliumWebBold}" TextElement.FontSize="{TemplateBinding FontSize}"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="Fill" Property="Background" Value="#1FFFFFFF" />
                                                        <Setter TargetName="Fill" Property="BorderBrush" Value="#FF5CE1E6" />
                                                        <Setter TargetName="Content" Property="TextElement.Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>
                            <!-- the background: the logo's dark, with a soft purple and cyan light (see-through on the look step) -->
                            <Grid Visibility="{PluginSettings Plugin=Kippix, Path=IsTourSolid, FallbackValue=Visible}">
                                <Border Background="#FF0B0D14" />
                                <Border>
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.12,0.1" GradientOrigin="0.12,0.1" RadiusX="0.6" RadiusY="0.8">
                                            <GradientStop Color="#409300C5" Offset="0" />
                                            <GradientStop Color="#009300C5" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border>
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.92,0.95" GradientOrigin="0.92,0.95" RadiusX="0.5" RadiusY="0.7">
                                            <GradientStop Color="#265CE1E6" Offset="0" />
                                            <GradientStop Color="#005CE1E6" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <Border Visibility="{PluginSettings Plugin=Kippix, Path=IsTourSeeThrough, FallbackValue=Collapsed}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FA0B0D14" Offset="0" />
                                        <GradientStop Color="#F00B0D14" Offset="0.42" />
                                        <GradientStop Color="#550B0D14" Offset="0.62" />
                                        <GradientStop Color="#000B0D14" Offset="0.8" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- ===== (0.99.10 layout) one column: the step on top (Welcome's logo, cards and Start; Pick a look's picture tiles;
                                 every other step a list, with your own game's card for Card glow or a picture beside it), then the Good to
                                 know strip, then along the bottom Back, every step's number and name, Skip / Next. ===== -->
                            <Grid Margin="110,62,110,40">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                <!-- Welcome -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{PluginSettings Plugin=Kippix, Path=IsTourHello, FallbackValue=Collapsed}">
                                    <TextBlock Text="{DynamicResource LOC_KX_TourWelcomeTo}" Foreground="#FF5CE1E6" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="22" Margin="4,0,0,12" />
                                    <Image Source="{PluginSettings Plugin=Kippix, Path=WelcomeLogo}" Width="600" Stretch="Uniform" HorizontalAlignment="Left"
                                           Visibility="{PluginSettings Plugin=Kippix, Path=HasWelcomeLogo, FallbackValue=Collapsed}">
                                        <Image.Effect><DropShadowEffect Color="#FF9300C5" ShadowDepth="0" BlurRadius="60" Opacity="0.4" /></Image.Effect>
                                    </Image>
                                    <TextBlock Text="Kippix" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="110"
                                               Visibility="{PluginSettings Plugin=Kippix, Path=NoWelcomeLogo, FallbackValue=Collapsed}" />
                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=WelcomeText}" Style="{StaticResource KX_TextSub}" FontSize="28" TextWrapping="Wrap" Margin="4,26,0,0" Opacity="0.85" />
                                    <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=TourTips}" ItemTemplate="{StaticResource KX_TourFeatureTemplate}" Focusable="False" Margin="0,52,0,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,52,0,0">
                                        <ButtonEx x:Name="KX_TourStart" Style="{StaticResource KX_WelcomeHeroButton}" Command="{PluginSettings Plugin=Kippix, Path=TourNextCommand}">
                                            <TextBlock Text="{DynamicResource LOC_KX_WelcomeStart}" VerticalAlignment="Center" />
                                        </ButtonEx>
                                        <ButtonEx x:Name="KX_TourSkipHello" Style="{StaticResource KX_WelcomeQuietButton}" Command="{PluginSettings Plugin=Kippix, Path=TourSkipCommand}" Margin="20,0,0,0" Height="72"
                                                  Visibility="{PluginSettings Plugin=Kippix, Path=HasTourSkip, FallbackValue=Collapsed}">
                                            <TextBlock Text="{DynamicResource LOC_KX_TourSkipShort}" VerticalAlignment="Center" />
                                        </ButtonEx>
                                    </StackPanel>
                                </StackPanel>

                                <!-- the other steps -->
                                <Grid Visibility="{PluginSettings Plugin=Kippix, Path=IsTourStep, FallbackValue=Visible}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=WelcomeTitle}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="56" TextWrapping="Wrap" />
                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=WelcomeText}" Style="{StaticResource KX_TextSub}" FontSize="22" TextWrapping="Wrap" Margin="2,2,0,0" Opacity="0.8" />
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <!-- the choices: a list, or (Pick a look) picture tiles. The scroller reaches 40 px past the edges so a
                                             highlighted tile's glow isn't cut off; the highlighted one is drawn above its neighbours. -->
                                        <ScrollViewer Margin="-40,0,-40,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False" VerticalAlignment="Top">
                                            <StackPanel Margin="40,24,40,40">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="MaxWidth" Value="900" />
                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=IsTourTiles}" Value="True"><Setter Property="MaxWidth" Value="Infinity" /><Setter Property="HorizontalAlignment" Value="Stretch" /></DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=IsTourSplit}" Value="True"><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <!-- the controller check: the pad that was found, its buttons lighting up -->
                                                <StackPanel Visibility="{PluginSettings Plugin=Kippix, Path=IsTourController, FallbackValue=Collapsed}" Margin="0,0,0,24">
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TourPadText}" Style="{StaticResource KX_Text}" FontSize="22" TextWrapping="Wrap" Margin="0,0,0,16" />
                                                    <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=CtrlButtons}" Focusable="False">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border MinWidth="72" Height="52" CornerRadius="14" Margin="0,0,10,10" Padding="12,0" BorderThickness="2">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#14FFFFFF" />
                                                                            <Setter Property="BorderBrush" Value="#22FFFFFF" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding WasOn}" Value="True"><Setter Property="BorderBrush" Value="#FF5CE1E6" /></DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Background" Value="#FF9300C5" /><Setter Property="BorderBrush" Value="#FFFFFFFF" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource KX_Text}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <!-- (0.99.13) Pick a look: LAYOUT, then its DESIGN (Row), then its PRESET, side by side -->
                                                <StackPanel Orientation="Horizontal" Visibility="{PluginSettings Plugin=Kippix, Path=IsTourTiles, FallbackValue=Collapsed}">
                                                    <StackPanel>
                                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TourCol1Head}" Foreground="#FF5CE1E6" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="17" Margin="4,0,0,12" />
                                                        <ItemsControl x:Name="KX_TourCol1" Focusable="False" ItemsSource="{PluginSettings Plugin=Kippix, Path=TourCol1}" ItemTemplate="{StaticResource KX_TourPickTileTemplate}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="44,0,0,0" Visibility="{PluginSettings Plugin=Kippix, Path=HasTourCol2, FallbackValue=Collapsed}">
                                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TourCol2Head}" Foreground="#FF5CE1E6" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="17" Margin="4,0,0,12" />
                                                        <ItemsControl x:Name="KX_TourCol2" Focusable="False" ItemsSource="{PluginSettings Plugin=Kippix, Path=TourCol2}" ItemTemplate="{StaticResource KX_TourPickTileTemplate}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="44,0,0,0" Visibility="{PluginSettings Plugin=Kippix, Path=HasTourCol3, FallbackValue=Collapsed}">
                                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TourCol3Head}" Foreground="#FF5CE1E6" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="17" Margin="4,0,0,12" />
                                                        <ItemsControl x:Name="KX_TourCol3" Focusable="False" ItemsSource="{PluginSettings Plugin=Kippix, Path=TourCol3}" ItemTemplate="{StaticResource KX_TourPickTileTemplate}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- (0.99.15) Glow and background: CARD GLOW and BACKGROUND side by side, so nothing has to scroll -->
                                                <StackPanel Orientation="Horizontal" Visibility="{PluginSettings Plugin=Kippix, Path=IsTourSplit, FallbackValue=Collapsed}">
                                                    <ItemsControl x:Name="KX_WelcomeListA" Width="500" Focusable="False" ItemsSource="{PluginSettings Plugin=Kippix, Path=WelcomeRowsA}" ItemTemplate="{StaticResource KX_PickRowTemplate}" />
                                                    <ItemsControl x:Name="KX_WelcomeListB" Width="500" Margin="40,0,0,0" Focusable="False" ItemsSource="{PluginSettings Plugin=Kippix, Path=WelcomeRowsB}" ItemTemplate="{StaticResource KX_PickRowTemplate}" />
                                                </StackPanel>
                                                <ItemsControl x:Name="KX_WelcomeList" Focusable="False" ItemsSource="{PluginSettings Plugin=Kippix, Path=WelcomeRows}" Visibility="{PluginSettings Plugin=Kippix, Path=IsNotTourSplit, FallbackValue=Visible}">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="ItemTemplate" Value="{StaticResource KX_PickRowTemplate}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=IsTourTiles}" Value="True">
                                                                    <Setter Property="ItemTemplate" Value="{StaticResource KX_TourTileTemplate}" />
                                                                    <Setter Property="ItemsPanel">
                                                                        <Setter.Value><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Panel.ZIndex" Value="10" /></Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                        <!-- beside the list: your own game's card (Card glow), or the picture of the highlighted choice -->
                                        <StackPanel Grid.Column="1" Margin="60,24,0,0" VerticalAlignment="Top">
                                            <Border Width="560" Height="440" CornerRadius="26" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                                    Visibility="{PluginSettings Plugin=Kippix, Path=IsTourCardShown, FallbackValue=Collapsed}">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Grid Width="240" Height="320">
                                                        <Border x:Name="KX_TourCardArt" CornerRadius="{DynamicResource KX_CardCorner}">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#FF3A4152" Offset="0" />
                                                                    <GradientStop Color="#FF161920" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <Border x:Name="KX_TourCardRing" Margin="-3" IsHitTestVisible="False" CornerRadius="{DynamicResource KX_CardRingCorner}"
                                                                BorderThickness="{DynamicResource KX_CardRingThickness}" BorderBrush="{DynamicResource KX_CardRingBrush}" />
                                                    </Grid>
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TourCardName}" Style="{StaticResource KX_TextDim}" FontSize="17" HorizontalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="520" Margin="0,26,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <!-- (0.99.11) Background: the same game, behind a little home screen, the way the highlighted background shows it -->
                                            <StackPanel Visibility="{PluginSettings Plugin=Kippix, Path=IsTourBgShown, FallbackValue=Collapsed}">
                                                <Border Width="560" Height="315" CornerRadius="24" BorderBrush="#26FFFFFF" BorderThickness="1">
                                                    <Border.Effect><DropShadowEffect Color="Black" ShadowDepth="8" BlurRadius="40" Opacity="0.5" /></Border.Effect>
                                                    <Grid>
                                                        <Border x:Name="KX_TourBgArt" CornerRadius="23" Background="#FF0E1014" />
                                                        <!-- (0.99.17) the trailer / slideshow, playing over the art (ThemeApi.TourBgMedia.cs) -->
                                                        <Grid x:Name="KX_TourBgMedia" IsHitTestVisible="False">
                                                            <Grid.Clip><RectangleGeometry Rect="0,0,558,313" RadiusX="23" RadiusY="23" /></Grid.Clip>
                                                        </Grid>
                                                        <Border x:Name="KX_TourBgTile" Width="150" Height="200" CornerRadius="{DynamicResource KX_CardCorner}" Visibility="Collapsed"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FF1E2229">
                                                            <Border.Effect><DropShadowEffect Color="Black" ShadowDepth="6" BlurRadius="30" Opacity="0.6" /></Border.Effect>
                                                        </Border>
                                                        <Border CornerRadius="23" IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#000B0D14" Offset="0.45" />
                                                                    <GradientStop Color="#B30B0D14" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <Grid x:Name="KX_TourBgMini" Width="84" Height="112" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="26,0,0,24">
                                                            <Border x:Name="KX_TourBgMiniArt" CornerRadius="{DynamicResource KX_CardCorner}" Background="#FF1E2229" />
                                                            <Border Margin="-2" CornerRadius="{DynamicResource KX_CardRingCorner}" BorderThickness="{DynamicResource KX_CardRingThickness}" BorderBrush="{DynamicResource KX_CardRingBrush}" />
                                                        </Grid>
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,24" Padding="16,7" CornerRadius="16" Background="#B30B0D14"
                                                                Visibility="{PluginSettings Plugin=Kippix, Path=HasTourBgBadge, FallbackValue=Collapsed}">
                                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TourBgBadge}" Style="{StaticResource KX_Text}" FontSize="16" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TourCardName}" Style="{StaticResource KX_TextDim}" FontSize="17" HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="600" Margin="0,22,0,0" />
                                            </StackPanel>
                                            <Border CornerRadius="24" Background="#FF161A26" BorderBrush="#26FFFFFF" BorderThickness="1"
                                                    Visibility="{PluginSettings Plugin=Kippix, Path=HasTourLookImage, FallbackValue=Collapsed}">
                                                <Border.Effect><DropShadowEffect Color="Black" ShadowDepth="8" BlurRadius="40" Opacity="0.5" /></Border.Effect>
                                                <Image Source="{PluginSettings Plugin=Kippix, Path=TourLookImage}" Width="638" Height="359" Stretch="UniformToFill">
                                                    <Image.Clip><RectangleGeometry Rect="0,0,638,359" RadiusX="23" RadiusY="23" /></Image.Clip>
                                                </Image>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Good to know, along the bottom -->
                                <Border Grid.Row="1" Margin="0,14,0,18" Padding="22,16,22,4" CornerRadius="18" Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                        Visibility="{PluginSettings Plugin=Kippix, Path=HasTourTips, FallbackValue=Collapsed}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid Width="34" Height="34" VerticalAlignment="Top" Margin="0,0,20,12">
                                            <Ellipse Fill="#265CE1E6" />
                                            <Path Data="{StaticResource KX_IconInfo}" Style="{StaticResource KX_IconPath}" Stroke="#FF5CE1E6" Width="18" Height="18" />
                                        </Grid>
                                        <ItemsControl Grid.Column="1" ItemsSource="{PluginSettings Plugin=Kippix, Path=TourTips}" ItemTemplate="{StaticResource KX_TourNoteTemplate}" Focusable="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <!-- (0.99.14) Pick a look: Next before it's all picked says what's still to pick -->
                                <Border Grid.Row="1" Margin="0,14,0,18" Padding="24,16" CornerRadius="18" Background="#F2241A0C" BorderBrush="#FFFFB547" BorderThickness="2"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="{PluginSettings Plugin=Kippix, Path=HasTourWarn, FallbackValue=Collapsed}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource KX_IconInfo}" Style="{StaticResource KX_IconPath}" Stroke="#FFFFB547" Width="24" Height="24" Margin="0,0,14,0" />
                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TourWarn}" Style="{StaticResource KX_Text}" FontSize="20" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- along the bottom: Back, every step (done ones ticked, this one lit), Skip / Next -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ButtonEx x:Name="KX_TourBack" Style="{StaticResource KX_WelcomeQuietButton}" Command="{PluginSettings Plugin=Kippix, Path=TourBackCommand}"
                                              Visibility="{PluginSettings Plugin=Kippix, Path=HasTourBack, FallbackValue=Collapsed}">
                                        <TextBlock Text="{DynamicResource LOC_KX_Back}" VerticalAlignment="Center" />
                                    </ButtonEx>
                                    <ItemsControl Grid.Column="1" ItemsSource="{PluginSettings Plugin=Kippix, Path=TourDots}" ItemTemplate="{StaticResource KX_TourRailItem}" Focusable="False"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{PluginSettings Plugin=Kippix, Path=IsTourStep, FallbackValue=Visible}">
                                        <ButtonEx x:Name="KX_TourSkip" Style="{StaticResource KX_WelcomeQuietButton}" Command="{PluginSettings Plugin=Kippix, Path=TourSkipCommand}" Margin="0,0,16,0"
                                                  Visibility="{PluginSettings Plugin=Kippix, Path=HasTourSkip, FallbackValue=Collapsed}">
                                            <TextBlock Text="{DynamicResource LOC_KX_TourSkipShort}" VerticalAlignment="Center" />
                                        </ButtonEx>
                                        <ButtonEx x:Name="KX_TourNext" Style="{StaticResource KX_WelcomeHeroButton}" Command="{PluginSettings Plugin=Kippix, Path=TourNextCommand}" Height="62" MinWidth="220">
                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TourNextText}" VerticalAlignment="Center" />
                                        </ButtonEx>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <!-- (0.99.14) Pick a look: X shows the highlighted box's photo big, stretching in from small (not the whole screen) -->
                            <Grid IsHitTestVisible="False" Visibility="{PluginSettings Plugin=Kippix, Path=IsTourZoom, FallbackValue=Collapsed}">
                                <Border Background="#B3050609" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></StackPanel.RenderTransform>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=IsTourZoom}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.35" To="1" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.35" To="1" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="1360" Height="765" CornerRadius="24" Background="#FF161A26" BorderBrush="#40FFFFFF" BorderThickness="2">
                                        <Border.Effect><DropShadowEffect Color="Black" ShadowDepth="10" BlurRadius="60" Opacity="0.7" /></Border.Effect>
                                        <Image Source="{PluginSettings Plugin=Kippix, Path=TourZoomImage}" Width="1356" Height="761" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Clip><RectangleGeometry Rect="0,0,1356,761" RadiusX="22" RadiusY="22" /></Image.Clip>
                                        </Image>
                                    </Border>
                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TourZoomName}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="28"
                                               HorizontalAlignment="Center" Margin="0,22,0,0" />
                                </StackPanel>
                            </Grid>
                            <!-- a profile's settings, and the picture picker: the pictures as big round tiles, then where else to look -->
                            <Grid Visibility="{PluginSettings Plugin=Kippix, Path=IsTourProfileOpen, FallbackValue=Collapsed}">
                                <Border Background="#E6050609" />
                                <Border Width="1040" MaxHeight="920" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="30" Background="#FF141824" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                    <Border.Effect><DropShadowEffect Color="Black" ShadowDepth="10" BlurRadius="60" Opacity="0.6" /></Border.Effect>
                                    <Grid>
                                        <Border Height="5" VerticalAlignment="Top" CornerRadius="30,30,0,0" Background="{StaticResource KX_TourStripe}" />
                                        <DockPanel Margin="48,42,48,34">
                                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TourBoxKicker}" Foreground="#FF5CE1E6" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="18" />
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TourProfileTitle}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="44" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False" KeyboardNavigation.DirectionalNavigation="Contained">
                                                <StackPanel>
                                                    <ItemsControl x:Name="KX_TourPicGrid" Focusable="False" ItemsSource="{PluginSettings Plugin=Kippix, Path=TourPicTiles}" Margin="-14,0,-14,10"
                                                                  Visibility="{PluginSettings Plugin=Kippix, Path=HasTourPicTiles, FallbackValue=Collapsed}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ButtonEx Command="{Binding Command}" CommandParameter="{Binding Key}" Width="210" Height="210" Margin="14" FocusVisualStyle="{x:Null}" ToolTip="{Binding Text}">
                                                                    <ButtonEx.Template>
                                                                        <ControlTemplate TargetType="ButtonEx">
                                                                            <!-- (0.99.8) the highlight grows the tile by swapping the whole transform (a named transform can't be a
                                                                                 trigger's target in a template: that crashed 0.99.7) -->
                                                                            <Grid x:Name="Tile" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                                                                                <Grid.RenderTransform><ScaleTransform ScaleX="0.94" ScaleY="0.94" /></Grid.RenderTransform>
                                                                                <Ellipse x:Name="Glow" Fill="#FF9300C5" Opacity="0" Margin="6"><Ellipse.Effect><BlurEffect Radius="28" /></Ellipse.Effect></Ellipse>
                                                                                <Ellipse Fill="#FF0B0D14" Margin="8" />
                                                                                <Ellipse Margin="8">
                                                                                    <Ellipse.Fill><ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" /></Ellipse.Fill>
                                                                                </Ellipse>
                                                                                <Ellipse x:Name="Ring" Stroke="#33FFFFFF" StrokeThickness="2" Margin="8" />
                                                                            </Grid>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Ring" Property="Stroke" Value="#995CE1E6" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsFocused" Value="True">
                                                                                    <Setter TargetName="Ring" Property="Stroke" Value="#FF5CE1E6" />
                                                                                    <Setter TargetName="Ring" Property="StrokeThickness" Value="6" />
                                                                                    <Setter TargetName="Ring" Property="Margin" Value="2" />
                                                                                    <Setter TargetName="Glow" Property="Opacity" Value="0.7" />
                                                                                    <Setter TargetName="Tile" Property="RenderTransform">
                                                                                        <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value>
                                                                                    </Setter>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ButtonEx.Template>
                                                                </ButtonEx>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl x:Name="KX_TourProfileList" Focusable="False" ItemsSource="{PluginSettings Plugin=Kippix, Path=TourProfileRows}" ItemTemplate="{StaticResource KX_PickRowTemplate}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ===== First-time tip: a small card the first time a screen opens (never takes the highlight; any button hides it) ===== -->
                        <Border x:Name="KX_TipCard" Panel.ZIndex="89" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,70" MaxWidth="940"
                                Padding="26,18,32,18" CornerRadius="18" Background="#F21B1E24" BorderBrush="{DynamicResource KX_AccentBrush}" BorderThickness="2"
                                Visibility="{PluginSettings Plugin=Kippix, Path=IsTipShown, FallbackValue=Collapsed}">
                            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6" /></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Path Data="{StaticResource KX_IconInfo}" Style="{StaticResource KX_IconPath}" Width="30" Height="30" Margin="0,3,18,0" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TipTitle}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="24" />
                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TipText}" Style="{StaticResource KX_TextSub}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=TipHint}" Style="{StaticResource KX_TextDim}" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ===== Switching Steam to a profile's account (before a Steam game starts) ===== -->
                        <Grid Panel.ZIndex="95" Background="#F2000000" Visibility="{PluginSettings Plugin=Kippix, Path=IsSwitchingSteam, FallbackValue=Collapsed}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{StaticResource KX_IconController}" Style="{StaticResource KX_IconPath}" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,24" />
                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=SwitchingText}" Style="{StaticResource KX_Text}" FontSize="40" FontFamily="{DynamicResource FontTitilliumWebBold}" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource LOC_KX_SwitchingSub}" Style="{StaticResource KX_TextDim}" FontSize="20" HorizontalAlignment="Center" Margin="0,12,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- ===== "Are you sure?" (Reset everything, reset a section, Power): Cancel has the highlight, B cancels ===== -->
                        <Grid x:Name="KX_ConfirmLayer" Panel.ZIndex="90" Background="#B3000000" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle"
                              Visibility="{PluginSettings Plugin=Kippix, Path=IsConfirmOpen, FallbackValue=Collapsed}">
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="720" CornerRadius="22" Background="#F21B1E24" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="44,38,44,34">
                                <StackPanel>
                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ConfirmTitle}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="34" TextWrapping="Wrap" />
                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ConfirmText}" Style="{StaticResource KX_TextSub}" TextWrapping="Wrap" Margin="0,12,0,30" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ButtonEx x:Name="KX_ConfirmNo" Style="{StaticResource KX_PillButton}" Command="{PluginSettings Plugin=Kippix, Path=ConfirmNoCommand}" Margin="0,0,14,0">
                                            <TextBlock Text="{DynamicResource LOC_KX_Cancel}" VerticalAlignment="Center" />
                                        </ButtonEx>
                                        <ButtonEx x:Name="KX_ConfirmYes" Style="{StaticResource KX_PillButton}" Command="{PluginSettings Plugin=Kippix, Path=ConfirmYesCommand}">
                                            <!-- pink on the dark pill, dark red once it has the highlight (the pill turns white) -->
                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ConfirmYesText}" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFFCA5A5" /><Style.Triggers><DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=ButtonEx}}" Value="True"><Setter Property="Foreground" Value="#FFB42318" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </ButtonEx>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ===== Ambient mode (Settings & Customisation › Home settings › Look and feel): any button brings you back ===== -->
                        <Grid Background="Black" Panel.ZIndex="100" IsHitTestVisible="False" Visibility="{PluginSettings Plugin=Kippix, Path=IsAmbientOn, FallbackValue=Collapsed}">
                            <Grid x:Name="KX_AmbientArt" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="IsVisible" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard x:Name="KX_AmbientDrift">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="1.1" Duration="0:0:40" />
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="1.1" Duration="0:0:40" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions><StopStoryboard BeginStoryboardName="KX_AmbientDrift" /></Trigger.ExitActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage Source="{PluginSettings Plugin=Kippix, Path=AmbientImage}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <!-- (0.99.51) Screensaver › Background: a plain colour instead of the games' pictures -->
                            <Border Background="{PluginSettings Plugin=Kippix, Path=AmbientBgBrush}" Visibility="{PluginSettings Plugin=Kippix, Path=AmbientSolidBg, FallbackValue=Collapsed}" />
                            <!-- (0.86) a shade on the side the time and logo are on (top, middle or bottom), so they read on any picture -->
                            <Border Visibility="{PluginSettings Plugin=Kippix, Path=AmbientShadeBottom, FallbackValue=Visible}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0.45" />
                                        <GradientStop Color="#CC000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Visibility="{PluginSettings Plugin=Kippix, Path=AmbientShadeTop, FallbackValue=Collapsed}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#CC000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="0.55" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Background="#66000000" Visibility="{PluginSettings Plugin=Kippix, Path=AmbientShadeMiddle, FallbackValue=Collapsed}" />
                            <!-- the time, with the game's logo under it (its name when it has none), in the place picked in Settings -->
                            <StackPanel Margin="90,80,90,80" MaxWidth="760"
                                        HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=AmbientHAlign, FallbackValue=Right}"
                                        VerticalAlignment="{PluginSettings Plugin=Kippix, Path=AmbientVAlign, FallbackValue=Bottom}">
                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ClockText}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="120"
                                           TextAlignment="{PluginSettings Plugin=Kippix, Path=AmbientTextAlign, FallbackValue=Right}" HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=AmbientHAlign, FallbackValue=Right}">
                                    <TextBlock.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="24" Opacity="0.6" /></TextBlock.Effect>
                                </TextBlock>
                                <Image Source="{PluginSettings Plugin=Kippix, Path=AmbientLogo}" MaxWidth="520" MaxHeight="200" Stretch="Uniform" Margin="0,4,0,0"
                                       HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=AmbientHAlign, FallbackValue=Right}"
                                       Visibility="{PluginSettings Plugin=Kippix, Path=HasAmbientLogo, FallbackValue=Collapsed}">
                                    <Image.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.55" /></Image.Effect>
                                </Image>
                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AmbientCaption}" Style="{StaticResource KX_TextSub}" FontSize="28" Margin="6,-6,6,0" TextWrapping="Wrap"
                                           TextAlignment="{PluginSettings Plugin=Kippix, Path=AmbientTextAlign, FallbackValue=Right}"
                                           Visibility="{PluginSettings Plugin=Kippix, Path=HasAmbientCaption, FallbackValue=Collapsed}" />
                                <TextBlock Text="{DynamicResource LOC_KX_AmbientWake}" Style="{StaticResource KX_TextDim}" FontSize="18" Margin="6,18,6,0"
                                           TextAlignment="{PluginSettings Plugin=Kippix, Path=AmbientTextAlign, FallbackValue=Right}"
                                           Visibility="{PluginSettings Plugin=Kippix, Path=AmbientWakeText, FallbackValue=Visible}" />
                            </StackPanel>
                        </Grid>
                        <!-- "game is starting" screen (ZIndex 0: the toast, keyboard, confirm, Steam switch and ambient overlays above draw over it) -->
                        <GameStatus x:Name="PART_ElemGameStatus" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                        <!-- helper add-on not installed: small notice at the bottom -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Padding="18,10" CornerRadius="12" Background="#E61B1E24">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginStatus Plugin=KippixHelper_3f6c2d1e-8a47-4b9e-b1d5-7e2a9c4f0b18, Status=Installed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{PluginStatus Plugin=KippixHelper_3f6c2d1e-8a47-4b9e-b1d5-7e2a9c4f0b18, Status=Installed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{DynamicResource LOC_KX_HelperMissing}" Style="{StaticResource KX_TextSub}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
