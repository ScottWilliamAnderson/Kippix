                                                    <Grid Width="150" Height="150" HorizontalAlignment="Center">
                                                        <Border CornerRadius="20" Background="#FF161A22" BorderBrush="{PluginSettings Plugin=Kippix, Path=AchDetailTierBrush}" BorderThickness="3" />
