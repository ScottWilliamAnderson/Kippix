                                                                    <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=AchDetailDimmed}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.4" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Image Source="{PluginSettings Plugin=Kippix, Path=AchDetailIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" />
                                                    </Grid>
