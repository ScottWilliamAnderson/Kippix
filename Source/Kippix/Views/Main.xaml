                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ButtonEx.Template>
                                                        </ButtonEx>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- WISHLIST (on sale first) -->
                                            <StackPanel Orientation="Horizontal" Margin="2,10,0,14" Visibility="{PluginSettings Plugin=Kippix, Path=HasHubWish, FallbackValue=Collapsed}">
                                                <Border Width="4" Height="20" CornerRadius="2" Background="{DynamicResource KX_AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=HubWishTitle}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="17" Opacity="0.85" VerticalAlignment="Center" />
