                                                        <Path Data="{StaticResource KX_IconChevron}" Style="{StaticResource KX_IconPath}" />
                                                    </ButtonEx>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- (0.90) Trophy rings: the icon in a ring as full as the share of players who have it, in the rarity colour -->
