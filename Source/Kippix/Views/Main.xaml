<ButtonEx x:Name="KX_GalleryTabAll" Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=GalleryViewCommand}" CommandParameter="all"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource LOC_KX_GalleryAll}" VerticalAlignment="Center" /></StackPanel><Border Height="3" CornerRadius="1.5" Background="{DynamicResource KX_AccentBrush}" Margin="0,4,0,-7" Visibility="{PluginSettings Plugin=Kippix, Path=GalleryViewAll, FallbackValue=Collapsed}" /></StackPanel></ButtonEx>
<ButtonEx x:Name="KX_GalleryTabGames" Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=GalleryViewCommand}" CommandParameter="games"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource LOC_KX_GalleryByGame}" VerticalAlignment="Center" /></StackPanel><Border Height="3" CornerRadius="1.5" Background="{DynamicResource KX_AccentBrush}" Margin="0,4,0,-7" Visibility="{PluginSettings Plugin=Kippix, Path=GalleryViewGames, FallbackValue=Collapsed}" /></StackPanel></ButtonEx>
