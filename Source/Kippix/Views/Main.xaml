                                                                            <Border CornerRadius="9" Background="#E6000000" Padding="10,3" Margin="0,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                                    Visibility="{Binding HasRight, Converter={StaticResource BooleanToVisibilityConverter}}">
