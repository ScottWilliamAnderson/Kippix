                                                            <Grid Width="112" Height="112"><Grid.Clip><RectangleGeometry Rect="0,0,112,112" RadiusX="16" RadiusY="16" /></Grid.Clip><Grid.Style><Style TargetType="Grid"><Setter Property="Opacity" Value="1" /><Style.Triggers><DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=AchDetailDimmed}" Value="True"><Setter Property="Opacity" Value="0.4" /></DataTrigger></Style.Triggers></Style></Grid.Style><Image Source="{PluginSettings Plugin=Kippix, Path=AchDetailIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" /></Grid>
                                                            <Border Width="5" CornerRadius="2.5" HorizontalAlignment="Left" Margin="-12,10,0,10" Background="{PluginSettings Plugin=Kippix, Path=AchDetailTierBrush}" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Margin="24,0,20,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchDetailName}" Style="{StaticResource KX_TextTitle}" FontSize="36" TextWrapping="Wrap" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <Path Data="{StaticResource KX_IconCheck}" Style="{StaticResource KX_IconPath}" Stroke="#FF4ADE80" Width="18" Height="18" Margin="0,0,8,0"
