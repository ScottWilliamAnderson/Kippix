<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================
         Kippix - Library (main screen)

         Playnite lays the fullscreen UI out at 1080 pixels tall and scales it to
         your screen, so every size here is in 1080p pixels.

         Live parts (shortcuts, panels, downloads, Discord, battery, clock) come from
         the Kippix Helper add-on: {PluginSettings Plugin=Kippix, Path=...}.
         Note: anything bound to Visibility from a plugin must be a true/false value.
         =================================================================== -->

    <Style TargetType="{x:Type Main}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Main}">
                    <Grid x:Name="PART_MainHost" Background="Black" ClipToBounds="True">

                        <Grid.Resources>
                            <!-- one row on a list page (file picker, layouts, gallery folders, the game's More menu, the profile menu) -->
                            <DataTemplate x:Key="KX_PickRowTemplate">
                                <Grid>
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource KX_SectionHeader}" Visibility="{Binding IsHeaderShown, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ButtonEx Style="{StaticResource KX_MenuButton}" Margin="{Binding IndentMargin}" Command="{Binding Command}" CommandParameter="{Binding Key}" Visibility="{Binding IsRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <!-- the row's icon; a row with no Icon has none (its text lines up with the headers) -->
                                            <Grid Visibility="{Binding HasNoPicture, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Path Margin="0,0,16,0"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}"><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="access"><Setter Property="Data" Value="{StaticResource KX_IconAccess}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="achievements"><Setter Property="Data" Value="{StaticResource KX_IconTrophy}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="add"><Setter Property="Data" Value="{StaticResource KX_IconAdd}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="battery"><Setter Property="Data" Value="{StaticResource KX_IconBattery}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="bell"><Setter Property="Data" Value="{StaticResource KX_IconBell}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="bluetooth"><Setter Property="Data" Value="{StaticResource KX_IconBluetooth}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="calendar"><Setter Property="Data" Value="{StaticResource KX_IconCalendar}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="chart"><Setter Property="Data" Value="{StaticResource KX_IconChart}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="chat"><Setter Property="Data" Value="{StaticResource KX_IconChat}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="check"><Setter Property="Data" Value="{StaticResource KX_IconCheck}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="chevron"><Setter Property="Data" Value="{StaticResource KX_IconChevron}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="clapper"><Setter Property="Data" Value="{StaticResource KX_IconClapper}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="clock"><Setter Property="Data" Value="{StaticResource KX_IconClock}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="close"><Setter Property="Data" Value="{StaticResource KX_IconClose}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="cloud"><Setter Property="Data" Value="{StaticResource KX_IconCloud}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="colour"><Setter Property="Data" Value="{StaticResource KX_IconPalette}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="controller"><Setter Property="Data" Value="{StaticResource KX_IconController}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="copy"><Setter Property="Data" Value="{StaticResource KX_IconFile}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="crunchyroll"><Setter Property="Data" Value="{StaticResource KX_IconClapper}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="cursor"><Setter Property="Data" Value="{StaticResource KX_IconCursor}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="delete"><Setter Property="Data" Value="{StaticResource KX_IconTrash}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="desktop"><Setter Property="Data" Value="{StaticResource KX_IconDesktop}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="dice"><Setter Property="Data" Value="{StaticResource KX_IconDice}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="discord"><Setter Property="Data" Value="{StaticResource KX_IconDiscord}" /><Setter Property="Fill" Value="{Binding Stroke, RelativeSource={RelativeSource Self}}" /><Setter Property="StrokeThickness" Value="0.6" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="dots"><Setter Property="Data" Value="{StaticResource KX_IconDots}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="download"><Setter Property="Data" Value="{StaticResource KX_IconDownload}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="drive"><Setter Property="Data" Value="{StaticResource KX_IconDrive}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="expand"><Setter Property="Data" Value="{StaticResource KX_IconExpand}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="eyeoff"><Setter Property="Data" Value="{StaticResource KX_IconEyeOff}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="file"><Setter Property="Data" Value="{StaticResource KX_IconFile}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="filmstrip"><Setter Property="Data" Value="{StaticResource KX_IconFilmStrip}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="filter"><Setter Property="Data" Value="{StaticResource KX_IconFilter}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="flag"><Setter Property="Data" Value="{StaticResource KX_IconFlag}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="folder"><Setter Property="Data" Value="{StaticResource KX_IconFolder}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="forward"><Setter Property="Data" Value="{StaticResource KX_IconForward}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="friends"><Setter Property="Data" Value="{StaticResource KX_IconFriends}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="gallery"><Setter Property="Data" Value="{StaticResource KX_IconGallery}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="gear"><Setter Property="Data" Value="{StaticResource KX_IconGear}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="globe"><Setter Property="Data" Value="{StaticResource KX_IconGlobe}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="grid"><Setter Property="Data" Value="{StaticResource KX_IconGrid}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="hash"><Setter Property="Data" Value="{StaticResource KX_IconHash}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="headphones"><Setter Property="Data" Value="{StaticResource KX_IconHeadphones}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="heart"><Setter Property="Data" Value="{StaticResource KX_IconHeart}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="hibernate"><Setter Property="Data" Value="{StaticResource KX_IconHibernate}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="hide"><Setter Property="Data" Value="{StaticResource KX_IconEyeOff}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="home"><Setter Property="Data" Value="{StaticResource KX_IconHome}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="hourglass"><Setter Property="Data" Value="{StaticResource KX_IconHourglass}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="info"><Setter Property="Data" Value="{StaticResource KX_IconInfo}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="keyboard"><Setter Property="Data" Value="{StaticResource KX_IconHash}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="layout"><Setter Property="Data" Value="{StaticResource KX_IconLayout}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="leave"><Setter Property="Data" Value="{StaticResource KX_IconLeave}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="link"><Setter Property="Data" Value="{StaticResource KX_IconLink}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="lock"><Setter Property="Data" Value="{StaticResource KX_IconLock}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="media"><Setter Property="Data" Value="{StaticResource KX_IconMedia}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="localmedia"><Setter Property="Data" Value="{StaticResource KX_IconLocalMedia}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="menu"><Setter Property="Data" Value="{StaticResource KX_IconMenu}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="mic"><Setter Property="Data" Value="{StaticResource KX_IconMic}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="moon"><Setter Property="Data" Value="{StaticResource KX_IconMoon}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="more"><Setter Property="Data" Value="{StaticResource KX_IconDots}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="move"><Setter Property="Data" Value="{StaticResource KX_IconMove}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="mute"><Setter Property="Data" Value="{StaticResource KX_IconMute}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="netflix"><Setter Property="Data" Value="{StaticResource KX_IconTv}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="news"><Setter Property="Data" Value="{StaticResource KX_IconNews}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="note"><Setter Property="Data" Value="{StaticResource KX_IconNote}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="options"><Setter Property="Data" Value="{StaticResource KX_IconDots}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="palette"><Setter Property="Data" Value="{StaticResource KX_IconPalette}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="paste"><Setter Property="Data" Value="{StaticResource KX_IconNote}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="pause"><Setter Property="Data" Value="{StaticResource KX_IconPause}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="phone"><Setter Property="Data" Value="{StaticResource KX_IconPhone}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="picture"><Setter Property="Data" Value="{StaticResource KX_IconGallery}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="pin"><Setter Property="Data" Value="{StaticResource KX_IconPin}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="place"><Setter Property="Data" Value="{StaticResource KX_IconFolder}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="play"><Setter Property="Data" Value="{StaticResource KX_IconPlay}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="power"><Setter Property="Data" Value="{StaticResource KX_IconPower}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="preset"><Setter Property="Data" Value="{StaticResource KX_IconStar}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="prime"><Setter Property="Data" Value="{StaticResource KX_IconFilmStrip}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="profile"><Setter Property="Data" Value="{StaticResource KX_IconProfile}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="refresh"><Setter Property="Data" Value="{StaticResource KX_IconRefresh}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="remove"><Setter Property="Data" Value="{StaticResource KX_IconClose}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="reply"><Setter Property="Data" Value="{StaticResource KX_IconReply}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="rewind"><Setter Property="Data" Value="{StaticResource KX_IconRewind}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="search"><Setter Property="Data" Value="{StaticResource KX_IconSearch}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="select"><Setter Property="Data" Value="{StaticResource KX_IconSelect}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="servers"><Setter Property="Data" Value="{StaticResource KX_IconServers}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="settings"><Setter Property="Data" Value="{StaticResource KX_IconGear}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="shape"><Setter Property="Data" Value="{StaticResource KX_IconSelect}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="shelf"><Setter Property="Data" Value="{StaticResource KX_IconShelf}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="sliders"><Setter Property="Data" Value="{StaticResource KX_IconSliders}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="sort"><Setter Property="Data" Value="{StaticResource KX_IconSort}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="speaker"><Setter Property="Data" Value="{StaticResource KX_IconSpeaker}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="star"><Setter Property="Data" Value="{StaticResource KX_IconStar}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="store"><Setter Property="Data" Value="{StaticResource KX_IconStore}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="sun"><Setter Property="Data" Value="{StaticResource KX_IconSun}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="tag"><Setter Property="Data" Value="{StaticResource KX_IconTag}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="trash"><Setter Property="Data" Value="{StaticResource KX_IconTrash}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="trophy"><Setter Property="Data" Value="{StaticResource KX_IconTrophy}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="tune"><Setter Property="Data" Value="{StaticResource KX_IconTune}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="tv"><Setter Property="Data" Value="{StaticResource KX_IconTv}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="up"><Setter Property="Data" Value="{StaticResource KX_IconUp}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="upload"><Setter Property="Data" Value="{StaticResource KX_IconUpload}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="use"><Setter Property="Data" Value="{StaticResource KX_IconCheck}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="video"><Setter Property="Data" Value="{StaticResource KX_IconVideo}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="weather"><Setter Property="Data" Value="{StaticResource KX_IconCloud}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="wifi"><Setter Property="Data" Value="{StaticResource KX_IconWifi}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="youtube"><Setter Property="Data" Value="{StaticResource KX_IconVideo}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="zoomin"><Setter Property="Data" Value="{StaticResource KX_IconZoomIn}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="zoomout"><Setter Property="Data" Value="{StaticResource KX_IconZoomOut}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                                            </Grid>
                                            <!-- the service's own icon (media), when there is one -->
                                            <Border Width="30" Height="30" CornerRadius="7" Margin="0,0,14,0" VerticalAlignment="Center" Visibility="{Binding HasPicture, Converter={StaticResource BooleanToVisibilityConverter}}"><Border.Background><ImageBrush ImageSource="{Binding Picture}" Stretch="Uniform" /></Border.Background></Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource KX_Text}"><Style.Triggers><DataTrigger Binding="{Binding IsInfo}" Value="True"><Setter Property="Foreground" Value="{DynamicResource KX_TextSubBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Sub}" Style="{StaticResource KX_TextDim}" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasSub, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                            <!-- a chosen row: a tick -->
                                            <Grid Grid.Column="2" Visibility="{Binding IsNotSwitch, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}">
                                                <Path Data="{StaticResource KX_IconCheck}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" Margin="12,0,0,0"
                                                      Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                            <!-- an on / off row: the same switch as the switches on the other pages (IsSelected is on) -->
                                            <Grid Grid.Column="2" Width="58" Height="32" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSwitch, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                                <Border CornerRadius="16"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#33FFFFFF" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource KX_AccentBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                                                <Ellipse Width="24" Height="24" Margin="4,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#FFB8C0CC" /><Setter Property="HorizontalAlignment" Value="Left" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Fill" Value="#FF101216" /><Setter Property="HorizontalAlignment" Value="Right" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                                            </Grid>
                                        </Grid>
                                    </ButtonEx>
                                </Grid>
                            </DataTemplate>
                            <!-- Row's carousel (Tall, Full Screen, Folder's tiles; the tiles before the games in Lower with Loop): one card. A game's cover,
                                 a folder's photo or a tile's icon and name. The helper sets each card's Width / Height and Canvas.Left / Top from
                                 CarouselGeometry (nothing here scales it), its corners (Corner) and fades its highlight edge in (KX_CarRing).
                                 Plain {Binding}s only. -->
                            <DataTemplate x:Key="KX_CarouselItemTemplate">
                                <Grid x:Name="KX_CarTile">
                                    <!-- the plain card under the picture (and with no picture: the icon and name show on it) -->
                                    <Border CornerRadius="{Binding Corner}" Background="#FF1E2229">
                                        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.55" /></Border.Effect>
                                    </Border>
                                    <!-- the picture, filling the card (cropped, centred), inside the rounded corners -->
                                    <Border CornerRadius="{Binding Corner}" Visibility="{Binding HasPicture, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.Background><ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" /></Border.Background>
                                    </Border>
                                    <!-- no picture: the icon (tiles, folders) and the name -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" Visibility="{Binding HasNoPicture, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                                            <Path Width="56" Height="56" Stroke="White" StrokeThickness="2">
                                                <Path.Style>
                                                    <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                        <Setter Property="Data" Value="{StaticResource KX_IconFolder}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Icon}" Value="store"><Setter Property="Data" Value="{StaticResource KX_IconStore}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Icon}" Value="trophy"><Setter Property="Data" Value="{StaticResource KX_IconTrophy}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Icon}" Value="pin"><Setter Property="Data" Value="{StaticResource KX_IconPin}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Icon}" Value="forward"><Setter Property="Data" Value="{StaticResource KX_IconForward}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Icon}" Value="grid"><Setter Property="Data" Value="{StaticResource KX_IconGrid}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Icon}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <Ellipse Width="16" Height="16" Fill="#FF4ADE80" Stroke="Black" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0"
                                                     Visibility="{Binding ShowDot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource KX_TextTitle}" FontSize="28" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource KX_TextSub}" FontSize="17" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding HasSub, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <!-- a folder with its photo: its name along the bottom -->
                                    <Border CornerRadius="{Binding Corner}" VerticalAlignment="Bottom" Padding="18,48,18,16" Visibility="{Binding NameOnPicture, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#D9000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource KX_TextTitle}" FontSize="28" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource KX_TextSub}" FontSize="17" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasSub, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- badges: a pinned game's pin, an installed game's tick -->
                                    <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                                        <Border CornerRadius="8" Background="#CC0D0F12" Padding="7,4" Margin="0,0,6,0" Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Path Data="{StaticResource KX_IconPin}" Style="{StaticResource KX_IconPath}" Width="14" Height="14" />
                                        </Border>
                                        <Border CornerRadius="8" Background="#CC0D0F12" Padding="6,3" Visibility="{Binding ShowInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Path Data="M5,12.5 L10,17.5 L19,7" Stroke="#FF4ADE80" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="14" Height="14" Stretch="Uniform" />
                                        </Border>
                                    </StackPanel>
                                    <!-- the highlight: the accent edge and a soft glow, just outside the card (the helper fades it in) -->
                                    <Border x:Name="KX_CarRing" CornerRadius="{Binding RingCorner}" Margin="{Binding RingMargin}" BorderThickness="3" BorderBrush="{DynamicResource KX_CardRingBrush}" Opacity="0" IsHitTestVisible="False">
                                        <Border.Effect><DropShadowEffect Color="{Binding Color, Source={StaticResource KX_CardGlowBrush}, FallbackValue=White}" BlurRadius="{DynamicResource KX_CardGlowSize}" ShadowDepth="0" Opacity="{DynamicResource KX_CardGlowOpacity}" /></Border.Effect>
                                    </Border>
                                </Grid>
                            </DataTemplate>

                            <!-- the hint bars of Free move / Free edit and of editing the board (ThemeApi.EditHints.cs): groups of hints, each the
                                 button's icon (the theme's ButtonPrompt set, following the last device used; a key cap on a keyboard; the D-pad
                                 drawn here) and what it does. A group wraps onto the next line as a whole; a thin line between groups. -->
                            <DataTemplate x:Key="KX_EditHintGroupTemplate">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="1.5" Height="24" Background="#4DFFFFFF" Margin="28,0" VerticalAlignment="Center"
                                            Visibility="{Binding ShowDivider, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False" IsTabStop="False" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="{Binding ItemMargin}">
                                                    <ItemsControl ItemsSource="{Binding Glyphs}" Focusable="False" IsTabStop="False" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,4,0" VerticalAlignment="Center">
                                                                    <!-- a controller button: the theme's own icon -->
                                                                    <ContentControl Height="26" MinWidth="20" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                                                                    Visibility="{Binding IsPrompt, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <ContentControl.Style>
                                                                            <Style TargetType="ContentControl">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Prompt}" Value="A"><Setter Property="ContentTemplate" Value="{DynamicResource ButtonPromptA}" /></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Prompt}" Value="B"><Setter Property="ContentTemplate" Value="{DynamicResource ButtonPromptB}" /></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Prompt}" Value="X"><Setter Property="ContentTemplate" Value="{DynamicResource ButtonPromptX}" /></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Prompt}" Value="Y"><Setter Property="ContentTemplate" Value="{DynamicResource ButtonPromptY}" /></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Prompt}" Value="LB"><Setter Property="ContentTemplate" Value="{DynamicResource ButtonPromptLB}" /></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Prompt}" Value="RB"><Setter Property="ContentTemplate" Value="{DynamicResource ButtonPromptRB}" /></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Prompt}" Value="LT"><Setter Property="ContentTemplate" Value="{DynamicResource ButtonPromptLT}" /></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Prompt}" Value="RT"><Setter Property="ContentTemplate" Value="{DynamicResource ButtonPromptRT}" /></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Prompt}" Value="Back"><Setter Property="ContentTemplate" Value="{DynamicResource ButtonPromptBack}" /></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Prompt}" Value="Start"><Setter Property="ContentTemplate" Value="{DynamicResource ButtonPromptStart}" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ContentControl.Style>
                                                                    </ContentControl>
                                                                    <!-- a keyboard key -->
                                                                    <Border Height="24" MinWidth="24" Padding="6,0" CornerRadius="5" BorderThickness="1.6" BorderBrush="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                                                            Visibility="{Binding IsCap, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="{Binding Cap}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="13"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                                    </Border>
                                                                    <!-- the D-pad, the arms it means lit -->
                                                                    <Viewbox Width="26" Height="26" VerticalAlignment="Center" Visibility="{Binding IsDpad, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <Canvas Width="24" Height="24">
                                                                            <Path Data="M8.5,1.5 H15.5 V8.5 H22.5 V15.5 H15.5 V22.5 H8.5 V15.5 H1.5 V8.5 H8.5 Z" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="#22FFFFFF" />
                                                                            <Path Data="M9.6,2.6 H14.4 V9 L12,11.4 L9.6,9 Z" Fill="{DynamicResource TextBrush}" Visibility="{Binding ArmUp, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                            <Path Data="M9.6,21.4 H14.4 V15 L12,12.6 L9.6,15 Z" Fill="{DynamicResource TextBrush}" Visibility="{Binding ArmDown, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                            <Path Data="M2.6,9.6 V14.4 H9 L11.4,12 L9,9.6 Z" Fill="{DynamicResource TextBrush}" Visibility="{Binding ArmLeft, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                            <Path Data="M21.4,9.6 V14.4 H15 L12.6,12 L15,9.6 Z" Fill="{DynamicResource TextBrush}" Visibility="{Binding ArmRight, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <!-- hold one, press the other -->
                                                                    <TextBlock Text="+" Style="{StaticResource KX_Text}" FontSize="18" Margin="2,0" VerticalAlignment="Center" Opacity="0.8"
                                                                               Visibility="{Binding IsPlus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource KX_Text}" FontSize="16" Opacity="0.92" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </Grid.Resources>

                        <!-- ============ Full-screen artwork of the selected game ============ -->
                        <!-- KX_BgLayers: every background picture in one layer, so Look and feel › Depth can shift them together
                             (the helper sets its transform in code: a 1.04 zoom so the edges never show, and a few pixels' shift) -->
                        <!-- KX_BgShift (r15): Home settings › Background › Move the picture moves all of it together (the helper sets a
                             TranslateTransform here, a share of the screen; what it no longer covers shows PART_MainHost's black) -->
                        <!-- (0.88) The game's tile moved with Move the picture: the plain colour stays put behind it, so no black shows at the edges -->
                        <Border IsHitTestVisible="False" Background="{PluginSettings Plugin=Kippix, Path=HomeSolidBrush}"
                                Visibility="{PluginSettings Plugin=Kippix, Path=HomeTileShown, FallbackValue=Collapsed}" />
                        <!-- (0.98) UniPlaySong's own element (its theme guide): Tag True quietens its music while Kippix plays sound of its own
                             (a trailer with sound, the store's videos, the gallery, the intro). Empty when it isn't installed. -->
                        <ContentControl x:Name="UPS_MusicControl" Focusable="False" IsHitTestVisible="False" Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Tag="{PluginSettings Plugin=Kippix, Path=UpsQuiet, FallbackValue=False}" />
                        <Grid x:Name="KX_BgShift">
                        <Grid x:Name="KX_BgLayers">
                        <!-- last session's background, shown instantly while Playnite loads the library (0.99.22: the helper hides it for good
                             once its own background picture has the selected game's, so it can't show through between two games) -->
                        <Image x:Name="KX_StartupBg" Source="{PluginSettings Plugin=Kippix, Path=StartupBackground}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{PluginSettings Plugin=Kippix, Path=HomeArtShown, FallbackValue=Visible}" />
                        <!-- (0.99.21) the home background people see: the helper keeps Playnite's picture above going but out of sight, and
                             puts what it shows on this one the chosen time later (Home settings › Background › Background transition speed;
                             ThemeApi.BgChangeDelay.cs). Playnite's blur and darkening are copied onto it. -->
                        <Grid x:Name="KX_BgDelayedHost" IsHitTestVisible="False" Visibility="{PluginSettings Plugin=Kippix, Path=HomeArtShown, FallbackValue=Visible}">
                            <FadeImage Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <!-- (0.98) BackgroundChanger's background (its pictures and videos for the game, changing as it's set to), over the game's own;
                             Settings › Home settings › Background › BackgroundChanger. Empty when it isn't installed. -->
                        <ContentControl x:Name="BackgroundChanger_PluginBackgroundImage" Focusable="False" IsHitTestVisible="False" ClipToBounds="True"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Width="{Binding ActualWidth, ElementName=KX_BgLayers}" Height="{Binding ActualHeight, ElementName=KX_BgLayers}"
                                        Visibility="{PluginSettings Plugin=Kippix, Path=BcBgOnHome, FallbackValue=Collapsed}" />
                        <!-- Home settings › Background: a plain colour instead of the game's art -->
                        <Border IsHitTestVisible="False" Background="{PluginSettings Plugin=Kippix, Path=HomeSolidBrush}"
                                Visibility="{PluginSettings Plugin=Kippix, Path=HomeSolidShown, FallbackValue=Collapsed}" />
                        <!-- (0.86/0.87) Home settings › Background › The game's tile: its cover as it is, sized (Size) and placed (Move the picture) on the plain colour (so after it) -->
                        <Image IsHitTestVisible="False" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Height="{PluginSettings Plugin=Kippix, Path=HomeTileBgHeight, FallbackValue=864}"
                               Source="{PluginSettings Plugin=Kippix, Path=HomeTileBgImage}"
                               Visibility="{PluginSettings Plugin=Kippix, Path=HomeTileShown, FallbackValue=Collapsed}">
                            <Image.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.6" /></Image.Effect>
                        </Image>
                        <!-- Home settings › Background: your own picture -->
                        <Image IsHitTestVisible="False" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="{PluginSettings Plugin=Kippix, Path=HomeCustomBg}"
                               Visibility="{PluginSettings Plugin=Kippix, Path=HomeCustomShown, FallbackValue=Collapsed}" />
                        <!-- Background › Trailer (muted) / Slideshow, and Background › Animated art (the hero, the living picture's motes): the helper puts its video / pictures in here -->
                        <Grid x:Name="KX_LiveBgHost" IsHitTestVisible="False" />
                        <!-- trailer preview behind everything (Settings › Home settings › Trailer preview); the helper starts / stops it -->
                        <MediaElement x:Name="KX_PreviewBg" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                      Visibility="Collapsed" Opacity="0" />
                        </Grid>
                        </Grid>
                        <!-- Look and feel › Theme Studio: the look's tint over the background (see-through unless the look has one) -->
                        <Border x:Name="KX_BgTint" IsHitTestVisible="False" Background="{DynamicResource KX_BgTintBrush}" />

                        <!-- readability shade on the side(s) where the logo / info / hints sit -->
                        <Border IsHitTestVisible="False"
                                Visibility="{PluginSettings Plugin=Kippix, Path=ShadeLeft, FallbackValue=Visible}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#C8000000" Offset="0" />
                                    <GradientStop Color="#66000000" Offset="0.45" />
                                    <GradientStop Color="#00000000" Offset="0.8" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border IsHitTestVisible="False"
                                Visibility="{PluginSettings Plugin=Kippix, Path=ShadeRight, FallbackValue=Collapsed}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                    <GradientStop Color="#C8000000" Offset="0" />
                                    <GradientStop Color="#66000000" Offset="0.45" />
                                    <GradientStop Color="#00000000" Offset="0.8" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border IsHitTestVisible="False"
                                Visibility="{PluginSettings Plugin=Kippix, Path=ShadeCenter, FallbackValue=Collapsed}">
                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0.62" GradientOrigin="0.5,0.62" RadiusX="0.45" RadiusY="0.35">
                                    <GradientStop Color="#99000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- top fade behind the top bar -->
                        <Border x:Name="KX_TopShade" IsHitTestVisible="False" Height="220" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#99000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- the fade to black: the art shows through the top of the cover row, then fades to black
                             (Home settings › Background: from which edge, how far, or none) -->
                        <Border IsHitTestVisible="False" Background="{PluginSettings Plugin=Kippix, Path=HomeFadeBrush}" />

                        <!-- Seasonal touches (Settings › Home settings): snow, leaves, lights... drawn by the helper, behind the games -->
                        <Canvas x:Name="KX_Seasonal" IsHitTestVisible="False" ClipToBounds="True" Visibility="{PluginSettings Plugin=Kippix, Path=SeasonalShown, FallbackValue=Collapsed}" />
                        <!-- start-up: plain black over every background layer (desktop mode's selected game, last session's art) from
                             the first frame until the home screen is ready; the helper fades it away (ShowStage / LiftStartBlack).
                             If the helper never gets that far it fades by itself after 6 s; without the helper it isn't shown -->
                        <Border x:Name="KX_StartBlack" Background="Black" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <!-- the helper's add-on id was KippixHelper_… before the Kippix rename: either one counts -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{PluginStatus Plugin=KippixHelper_3f6c2d1e-8a47-4b9e-b1d5-7e2a9c4f0b18, Status=Installed}" Value="False" />
                                                <Condition Binding="{PluginStatus Plugin=KippixHelper_3f6c2d1e-8a47-4b9e-b1d5-7e2a9c4f0b18, Status=Installed}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:6" Duration="0:0:0.4" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <!-- hidden for the moment Playnite takes to start, until your own layout is in place (no flash of the default one) -->
                        <Grid x:Name="KX_Stage" Opacity="{PluginSettings Plugin=Kippix, Path=StageOpacity, FallbackValue=1}">
                            <Grid x:Name="PART_ViewHost">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="104" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="430" />
                                </Grid.RowDefinitions>

                                <!-- ===================== TOP BAR ===================== -->
                                <Grid x:Name="KX_TopBar" Grid.Row="0" Grid.RowSpan="{PluginSettings Plugin=Kippix, Path=TopBarRowSpan, FallbackValue=1}" Margin="64,22,52,0" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- left: library name, count, search / filter state, progress -->
                                    <StackPanel x:Name="KX_TopLeft" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="{PluginSettings Plugin=Kippix, Path=TopLeftAlignment, FallbackValue=Center}">
                                        <!-- you: Windows' name and picture; opens the profile menu (Achievements, Store, Gallery, Media) -->
                                        <ButtonEx x:Name="KX_ProfileButton" Command="{PluginSettings Plugin=Kippix, Path=ToggleProfileCommand}" FocusVisualStyle="{x:Null}" Margin="-8,0,0,0" ToolTip="{DynamicResource LOC_KX_ProfileMenu}">
                                            <ButtonEx.Template>
                                                <ControlTemplate TargetType="ButtonEx">
                                                    <Border x:Name="Fill" CornerRadius="28" Padding="6,5,20,5" Background="Transparent" BorderThickness="1.5" BorderBrush="Transparent">
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource KX_FocusFillBrush}" />
                                                            <Setter TargetName="Fill" Property="BorderBrush" Value="#E9FFFFFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Background" Value="{DynamicResource KX_FocusFillBrush}" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ButtonEx.Template>
                                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                <Grid Width="44" Height="44" Visibility="{PluginSettings Plugin=Kippix, Path=ProfileShowPicture, FallbackValue=Visible}">
                                                    <Ellipse Fill="#33FFFFFF" />
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ProfileInitial}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="22"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{PluginSettings Plugin=Kippix, Path=ProfilePicture}" Stretch="UniformToFill" Width="44" Height="44" Visibility="{PluginSettings Plugin=Kippix, Path=HasProfilePicture, FallbackValue=Collapsed}">
                                                        <Image.Clip><EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22" /></Image.Clip>
                                                    </Image>
                                                </Grid>
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ProfileName}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="28" Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="440" TextTrimming="CharacterEllipsis"
                                                           Visibility="{PluginSettings Plugin=Kippix, Path=ProfileShowName, FallbackValue=Visible}" />
                                            </StackPanel>
                                        </ButtonEx>
                                        <!-- Playnite's search / filter marks: hidden while Folder is chosen (a folder shows all its games, Playnite's filter set aside) -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{PluginSettings Plugin=Kippix, Path=PlayniteFilterMarksShown, FallbackValue=Visible}">
                                        <StackPanel x:Name="PART_ElemSearchActive" Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource KX_IconSearch}" Style="{StaticResource KX_InfoIcon}" />
                                            <TextBlock Text="{Binding AppSettings.Fullscreen.FilterSettings.Name}" Style="{StaticResource KX_TextSub}" />
                                        </StackPanel>
                                        <TextBlock x:Name="PART_ElemExtraFilterActive" Text="{DynamicResource LOC_KX_Filtered}"
                                                   Style="{StaticResource KX_TextDim}" Margin="22,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel x:Name="PART_ElemProgressIndicator" Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                                            <ContentControl Style="{DynamicResource ProgressIndicator}" Focusable="False" Width="22" Height="22" />
                                            <TextBlock x:Name="PART_TextProgressTooltip" Style="{StaticResource KX_TextDim}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- right: shortcuts in your saved order, then options, clock, notifications -->
                                    <StackPanel x:Name="KX_TopRight" Grid.Column="2" Orientation="{PluginSettings Plugin=Kippix, Path=ShortcutsOrientation, FallbackValue=Horizontal}"
                                                VerticalAlignment="{PluginSettings Plugin=Kippix, Path=TopRightAlignment, FallbackValue=Center}"
                                                KeyboardNavigation.DirectionalNavigation="Continue">

                                        <ItemsControl x:Name="KX_TopShortcuts" Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      ItemsSource="{PluginSettings Plugin=Kippix, Path=Shortcuts}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="{PluginSettings Plugin=Kippix, Path=ShortcutsOrientation, FallbackValue=Horizontal}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{PluginSettings Plugin=Kippix, Path=TopRightItemMargin, FallbackValue=0}"
                                                          Visibility="{Binding IsShown, Converter={StaticResource BooleanToVisibilityConverter}}">

                                                        <ButtonEx Style="{StaticResource KX_TopBarButton}" Command="{Binding Command}" ToolTip="{Binding Name}"
                                                                  Visibility="{Binding IsButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Grid>
                                                                <Path>
                                                                    <Path.Style>
                                                                        <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Key}" Value="search"><Setter Property="Data" Value="{StaticResource KX_IconSearch}" /></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Key}" Value="achievements"><Setter Property="Data" Value="{StaticResource KX_IconTrophy}" /></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Key}" Value="discord">
                                                                                    <Setter Property="Data" Value="{StaticResource KX_IconDiscord}" /><Setter Property="Fill" Value="{Binding Stroke, RelativeSource={RelativeSource Self}}" /><Setter Property="StrokeThickness" Value="0.6" />
                                                                                    <Setter Property="Width" Value="28" />
                                                                                    <Setter Property="Height" Value="28" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Key}" Value="audio"><Setter Property="Data" Value="{StaticResource KX_IconSpeaker}" /></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Key}" Value="hibernate"><Setter Property="Data" Value="{StaticResource KX_IconHibernate}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="sleep"><Setter Property="Data" Value="{StaticResource KX_IconMoon}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="restart"><Setter Property="Data" Value="{StaticResource KX_IconRefresh}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="shutdown"><Setter Property="Data" Value="{StaticResource KX_IconPower}" /></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Key}" Value="downloads"><Setter Property="Data" Value="{StaticResource KX_IconDownload}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="store"><Setter Property="Data" Value="{StaticResource KX_IconStore}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="gallery"><Setter Property="Data" Value="{StaticResource KX_IconGallery}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="clock"><Setter Property="Data" Value="{StaticResource KX_IconClock}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="options"><Setter Property="Data" Value="{StaticResource KX_IconDots}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="quick"><Setter Property="Data" Value="{StaticResource KX_IconSliders}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="releases"><Setter Property="Data" Value="{StaticResource KX_IconCalendar}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="wishlist"><Setter Property="Data" Value="{StaticResource KX_IconHeart}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="news"><Setter Property="Data" Value="{StaticResource KX_IconNews}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="friends"><Setter Property="Data" Value="{StaticResource KX_IconFriends}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="collections"><Setter Property="Data" Value="{StaticResource KX_IconShelf}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="pick"><Setter Property="Data" Value="{StaticResource KX_IconDice}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="storage"><Setter Property="Data" Value="{StaticResource KX_IconDrive}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="bluetooth"><Setter Property="Data" Value="{StaticResource KX_IconBluetooth}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="controller"><Setter Property="Data" Value="{StaticResource KX_IconController}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="year"><Setter Property="Data" Value="{StaticResource KX_IconChart}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="splitscreen"><Setter Property="Data" Value="{StaticResource KX_IconController}" /></DataTrigger>
                                                                                <!-- (1.0.1) Media, Shows & movies and the streaming services -->
                                                                                <DataTrigger Binding="{Binding Key}" Value="media"><Setter Property="Data" Value="{StaticResource KX_IconMedia}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="localmedia"><Setter Property="Data" Value="{StaticResource KX_IconLocalMedia}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="netflix"><Setter Property="Data" Value="{StaticResource KX_IconTv}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="youtube"><Setter Property="Data" Value="{StaticResource KX_IconVideo}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="prime"><Setter Property="Data" Value="{StaticResource KX_IconFilmStrip}" /></DataTrigger><DataTrigger Binding="{Binding Key}" Value="crunchyroll"><Setter Property="Data" Value="{StaticResource KX_IconClapper}" /></DataTrigger><DataTrigger Binding="{Binding HasPicture}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                                <Image Source="{Binding Picture}" Width="26" Height="26" RenderOptions.BitmapScalingMode="Fant" Visibility="{Binding HasPicture, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <!-- status dot (Discord: green in a call, white when running) -->
                                                                <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-4"
                                                                         Stroke="Black" StrokeThickness="1.5" Fill="{Binding DotBrush}"
                                                                         Visibility="{Binding ShowDot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <!-- count badge (Discord unread, downloads) -->
                                                                <Border CornerRadius="9" MinWidth="18" Height="18" Padding="4,0" Background="{Binding BadgeBrush}"
                                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-10,0"
                                                                        Visibility="{Binding ShowBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding BadgeText}" Style="{StaticResource KX_Text}" Foreground="{Binding BadgeTextBrush}"
                                                                               FontSize="12" FontFamily="{DynamicResource FontTitilliumWebBold}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </ButtonEx>

                                                        <!-- the ⋯ (Settings & Customisation): a top bar item too, so it can be moved -->
                                                        <ButtonEx x:Name="KX_TopOptions" Style="{StaticResource KX_TopBarButton}" HorizontalAlignment="Center" Command="{Binding Command}" ToolTip="{Binding Name}"
                                                                  Visibility="{Binding IsOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                                <Ellipse Width="5" Height="5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonEx}}" Margin="2.5,0" />
                                                                <Ellipse Width="5" Height="5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonEx}}" Margin="2.5,0" />
                                                                <Ellipse Width="5" Height="5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonEx}}" Margin="2.5,0" />
                                                            </StackPanel>
                                                        </ButtonEx>
                                                        <!-- the clock (12 / 24-hour in Top bar settings): moved along the bar like the shortcuts -->
                                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ClockText}" Style="{StaticResource KX_Text}" FontSize="28" VerticalAlignment="Center" Margin="14,0,8,0"
                                                                   Visibility="{Binding IsClock, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <!-- controller battery: outline with a fill bar, plus a percentage when the pad reports one -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0"
                                                                    Visibility="{Binding IsBattery, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Width="30" Height="15" CornerRadius="3.5" BorderThickness="1.6"
                                                                        BorderBrush="{DynamicResource KX_TextBrush}">
                                                                    <Rectangle Margin="1.5" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5"
                                                                               Width="{PluginSettings Plugin=Kippix, Path=BatteryFillWidth, FallbackValue=0}"
                                                                               Fill="{PluginSettings Plugin=Kippix, Path=BatteryBrush}" />
                                                                </Border>
                                                                <Border Width="2.5" Height="6" CornerRadius="0,1.5,1.5,0" Margin="1,0,0,0"
                                                                        Background="{DynamicResource KX_TextBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=BatteryText}" Style="{StaticResource KX_TextSub}"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       Visibility="{PluginSettings Plugin=Kippix, Path=HasBatteryText, FallbackValue=Collapsed}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>


                                        <!-- clock (12 / 24-hour setting in Settings › Home settings) -->

                                        <!-- Playnite notifications: only when there are some, and not turned off in Home settings -->
                                        <ButtonEx x:Name="PART_ButtonNotifications" Margin="14,0,0,0">
                                            <ButtonEx.Style>
                                                <Style TargetType="ButtonEx" BasedOn="{StaticResource KX_TopBarButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=ShowNotificationIcon}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ButtonEx.Style>
                                            <Grid>
                                                <Path Data="{StaticResource KX_IconBell}" Style="{StaticResource KX_IconPath}" />
                                                <Ellipse Width="10" Height="10" Fill="#FFFF4D6A" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" />
                                            </Grid>
                                        </ButtonEx>
                                        <ButtonEx x:Name="PART_ButtonProgramUpdate" Style="{StaticResource KX_TopBarButton}" Margin="6,0,0,0">
                                            <Path Data="{StaticResource KX_IconDownload}" Style="{StaticResource KX_IconPath}" Stroke="#FF4ADE80" />
                                        </ButtonEx>
                                    </StackPanel>
                                </Grid>

                                <!-- ===================== CURRENT FILTER NAME (Settings › Home settings) ===================== -->
                                <ContentControl x:Name="KX_FilterAbove" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom" Focusable="False" IsHitTestVisible="False"
                                                HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=FilterAlignment, FallbackValue=Left}"
                                                Margin="{PluginSettings Plugin=Kippix, Path=FilterAboveMargin, FallbackValue='72,0,72,440'}"
                                                Visibility="{PluginSettings Plugin=Kippix, Path=FilterAbove, FallbackValue=Collapsed}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource KX_IconFilter}" Style="{StaticResource KX_InfoIcon}" />
                                        <!-- the games' filter; in an extra row (or Folder: the open folder) that name takes its place -->
                                        <Grid>
                                            <TextBlock Text="{Binding ActiveFilterPreset.Name}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource KX_TextSub}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=HomeLabelOwn}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=HomeLabelText}" Style="{StaticResource KX_TextSub}"
                                                       Visibility="{PluginSettings Plugin=Kippix, Path=HomeLabelOwn, FallbackValue=Collapsed}" />
                                        </Grid>
                                    </StackPanel>
                                </ContentControl>

                                <!-- ===================== SELECTED GAME: logo, info line, button hints =====================
                                     Each part can be turned off and placed left, centre or right (Options > Home settings). -->
                                <StackPanel x:Name="KX_GameInfo" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom"
                                            Margin="{PluginSettings Plugin=Kippix, Path=GameInfoMargin, FallbackValue='72,0,72,440'}">

                                    <!-- logo from Extra Metadata Loader, or the name when there's no logo -->
                                    <Grid x:Name="KX_LogoArea" MaxHeight="150" MaxWidth="1100" Margin="0,0,0,14"
                                          Width="{PluginSettings Plugin=Kippix, Path=LogoAreaWidth}"
                                          HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=LogoAlignment, FallbackValue=Left}"
                                          Visibility="{PluginSettings Plugin=Kippix, Path=ShowLogo, FallbackValue=Visible}">
                                        <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl" MaxHeight="150" MaxWidth="560" Focusable="False"
                                                        HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=LogoInnerAlignment, FallbackValue=Left}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <!-- (1.0.2) the name stands in for the logo at the logo's size: a long name wraps, then the whole of it
                                             shrinks to fit the logo's box (it no longer grows huge with a big logo setting) -->
                                        <Viewbox MaxHeight="150" MaxWidth="560" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Bottom"
                                                 HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=LogoInnerAlignment, FallbackValue=Left}">
                                            <Viewbox.Style>
                                                <Style TargetType="Viewbox">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Viewbox.Style>
                                            <TextBlock Text="{Binding SelectedGame.DisplayName}" TextWrapping="Wrap" MaxWidth="900" Style="{StaticResource KX_TextTitle}"
                                                       TextAlignment="{PluginSettings Plugin=Kippix, Path=LogoInnerTextAlignment, FallbackValue=Left}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect ShadowDepth="0" BlurRadius="16" Opacity="0.6" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </Viewbox>
                                    </Grid>

                                    <!-- info line: plain icons + text, each item can be switched off in Settings › Home settings › Game info details -->
                                    <Grid x:Name="KX_InfoLine" MaxWidth="1700"
                                          HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=InfoAlignment, FallbackValue=Left}"
                                          Visibility="{PluginSettings Plugin=Kippix, Path=ShowGameInfo, FallbackValue=Visible}">
                                        <!-- the order comes from Settings › Home settings › Game info details -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="{PluginSettings Plugin=Kippix, Path=InfoColPlaytime, FallbackValue=0}" Visibility="{PluginSettings Plugin=Kippix, Path=InfoPlaytime, FallbackValue=Visible}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                                                <Path Data="{StaticResource KX_IconClock}" Style="{StaticResource KX_InfoIcon}" />
                                                <TextBlock Text="{Binding SelectedGame.Playtime, Converter={StaticResource PlayTimeToStringConverter}}" Style="{StaticResource KX_TextSub}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="{PluginSettings Plugin=Kippix, Path=InfoColLastPlayed, FallbackValue=0}" Visibility="{PluginSettings Plugin=Kippix, Path=InfoLastPlayed, FallbackValue=Visible}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,30,0"
                                                        Visibility="{Binding SelectedGame.LastActivity, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Path Data="{StaticResource KX_IconCalendar}" Style="{StaticResource KX_InfoIcon}" />
                                                <TextBlock Text="{Binding SelectedGame.LastActivity, Converter={StaticResource DateTimeToLastPlayedConverter}}" Style="{StaticResource KX_TextSub}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="{PluginSettings Plugin=Kippix, Path=InfoColAchievements, FallbackValue=0}" Visibility="{PluginSettings Plugin=Kippix, Path=InfoAchievements, FallbackValue=Visible}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Path Data="{StaticResource KX_IconTrophy}" Style="{StaticResource KX_InfoIcon}" />
                                                <TextBlock Style="{StaticResource KX_TextSub}">
                                                    <Run Text="{PluginSettings Plugin=PlayniteAchievements, Path=Unlocked, FallbackValue='-', Mode=OneWay}" />
                                                    <Run Text="/" />
                                                    <Run Text="{PluginSettings Plugin=PlayniteAchievements, Path=Total, FallbackValue='-', Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="{PluginSettings Plugin=Kippix, Path=InfoColPlatform, FallbackValue=0}" Visibility="{PluginSettings Plugin=Kippix, Path=InfoPlatform, FallbackValue=Visible}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                                                <Path Data="{StaticResource KX_IconController}" Style="{StaticResource KX_InfoIcon}" />
                                                <TextBlock Text="{Binding SelectedGame.Platforms, Converter={StaticResource ListToStringConverter}}" Style="{StaticResource KX_TextSub}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="{PluginSettings Plugin=Kippix, Path=InfoColSource, FallbackValue=0}" Visibility="{PluginSettings Plugin=Kippix, Path=InfoSource, FallbackValue=Collapsed}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                                                <Path Data="{StaticResource KX_IconStore}" Style="{StaticResource KX_InfoIcon}" />
                                                <TextBlock Text="{Binding SelectedGame.Library}" Style="{StaticResource KX_TextSub}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="{PluginSettings Plugin=Kippix, Path=InfoColCompletion, FallbackValue=0}" Visibility="{PluginSettings Plugin=Kippix, Path=InfoCompletion, FallbackValue=Collapsed}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,30,0"
                                                        Visibility="{Binding SelectedGame.CompletionStatus, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Path Data="{StaticResource KX_IconFlag}" Style="{StaticResource KX_InfoIcon}" />
                                                <TextBlock Text="{Binding SelectedGame.CompletionStatus.Name}" Style="{StaticResource KX_TextSub}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="{PluginSettings Plugin=Kippix, Path=InfoColReleaseYear, FallbackValue=0}" Visibility="{PluginSettings Plugin=Kippix, Path=InfoReleaseYear, FallbackValue=Collapsed}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,30,0"
                                                        Visibility="{Binding SelectedGame.ReleaseYear, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Path Data="{StaticResource KX_IconTag}" Style="{StaticResource KX_InfoIcon}" />
                                                <TextBlock Text="{Binding SelectedGame.ReleaseYear}" Style="{StaticResource KX_TextSub}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- (0.96) How long to beat, players on Steam right now and friends: each its own part (Free move moves each on its own;
                                         switched in Home settings › Logo, game info and button hints › More about the game) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=InfoAlignment, FallbackValue=Left}">
                                        <StackPanel x:Name="KX_HomeHltb" Orientation="Horizontal" Margin="0,0,30,0" Visibility="{PluginSettings Plugin=Kippix, Path=HomeShowHltb, FallbackValue=Collapsed}">
                                            <Path Data="{StaticResource KX_IconHourglass}" Style="{StaticResource KX_InfoIcon}" />
                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=HomeHltbText}" Style="{StaticResource KX_TextSub}" />
                                        </StackPanel>
                                        <!-- (0.99.48) story progress for the highlighted game (ThemeApi.StoryProgress.cs) -->
                                        <StackPanel x:Name="KX_HomeProgress" Orientation="Horizontal" Margin="0,0,30,0" Visibility="{PluginSettings Plugin=Kippix, Path=HomeShowProgress, FallbackValue=Collapsed}">
                                            <!-- (0.99.51) faded, not taken away, for a game with no figure: the parts beside it stay put -->
                                            <StackPanel Orientation="Horizontal" Opacity="{PluginSettings Plugin=Kippix, Path=HomeProgressOpacity, FallbackValue=1}">
                                                <Path Data="{StaticResource KX_IconFlag}" Style="{StaticResource KX_InfoIcon}" />
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=HomeProgressText}" Style="{StaticResource KX_TextSub}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel x:Name="KX_HomePlayers" Orientation="Horizontal" Margin="0,0,30,0" Visibility="{PluginSettings Plugin=Kippix, Path=HomeShowPlayers, FallbackValue=Collapsed}">
                                            <Ellipse Width="9" Height="9" Fill="#FF5DD879" Margin="4,0,12,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=HomePlayersText}" Style="{StaticResource KX_TextSub}" />
                                        </StackPanel>
                                        <StackPanel x:Name="KX_HomeFriends" Orientation="Horizontal" Margin="0,0,30,0" Visibility="{PluginSettings Plugin=Kippix, Path=HomeShowFriends, FallbackValue=Collapsed}">
                                            <Path Data="{StaticResource KX_IconFriends}" Style="{StaticResource KX_InfoIcon}" />
                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=HomeFriendsText}" Style="{StaticResource KX_TextSub}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- controller hints -->
                                    <StackPanel x:Name="KX_HintsRow" Orientation="Horizontal" Margin="0,18,0,0" Opacity="0.85"
                                                HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=HintsAlignment, FallbackValue=Left}"
                                                Visibility="{PluginSettings Plugin=Kippix, Path=ShowButtonHints, FallbackValue=Visible}">
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptA}" Width="26" Height="26" Focusable="False" />
                                        <!-- "Details", or "Play" when the game page is skipped (then the X hint goes) -->
                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=HintAText, FallbackValue=Details}" Style="{StaticResource KX_TextDim}" Margin="8,0,24,0" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Visibility="{PluginSettings Plugin=Kippix, Path=ShowXPlayHint, FallbackValue=Visible}">
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptX}" Width="26" Height="26" Focusable="False" />
                                            <TextBlock Text="{DynamicResource LOC_KX_Play}" Style="{StaticResource KX_TextDim}" Margin="8,0,24,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptStart}" Width="26" Height="26" Focusable="False" />
                                        <TextBlock Text="{DynamicResource LOC_KX_GameOptions}" Style="{StaticResource KX_TextDim}" Margin="8,0,24,0" VerticalAlignment="Center" />
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptY}" Width="26" Height="26" Focusable="False" />
                                        <TextBlock Text="{DynamicResource LOC_KX_Search}" Style="{StaticResource KX_TextDim}" Margin="8,0,24,0" VerticalAlignment="Center" />
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptBack}" Width="26" Height="26" Focusable="False" />
                                        <TextBlock Text="{DynamicResource LOC_KX_Menu}" Style="{StaticResource KX_TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- ===================== WIDGETS (placed by hand: Settings › Home settings › Widgets) ===================== -->
                                <ItemsControl x:Name="KX_Widgets" Grid.Row="0" Grid.RowSpan="3" ItemsSource="{PluginSettings Plugin=Kippix, Path=Widgets}" Focusable="False"
                                              Visibility="{PluginSettings Plugin=Kippix, Path=ShowWidgets, FallbackValue=Collapsed}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            <Setter Property="Visibility" Value="{Binding ItemVisibility}" />
                                            <!-- Free move › Menu › Layer (a plain binding, not PluginSettings) -->
                                            <Setter Property="Panel.ZIndex" Value="{Binding Layer}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Viewbox Width="{Binding Width}" Height="{Binding Height}" Stretch="Fill" Visibility="{Binding ItemVisibility}" RenderTransformOrigin="0.5,0.5" Opacity="{Binding ItemOpacity}">
                                                <!-- turned with LT / RT while it's picked up (a plain binding in the template, not PluginSettings) -->
                                                <Viewbox.RenderTransform><RotateTransform Angle="{Binding Angle}" /></Viewbox.RenderTransform>
                                                <Border Width="{Binding DesignWidth}" Height="{Binding DesignHeight}" CornerRadius="20" Background="{Binding BackBrush}"
                                                        BorderBrush="{Binding EdgeBrush}" BorderThickness="1" Padding="{Binding BoxPadding}" ClipToBounds="True">
                                                    <DockPanel Effect="{Binding TextShadow}">
                                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"
                                                                    Visibility="{Binding ShowTitle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Path Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Stroke="{Binding DimBrush}">
                                                                <Path.Style>
                                                                    <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                                        <Setter Property="Data" Value="{StaticResource KX_IconLayout}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Type}" Value="weather"><Setter Property="Data" Value="{StaticResource KX_IconGlobe}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="clock"><Setter Property="Data" Value="{StaticResource KX_IconClock}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="suggest"><Setter Property="Data" Value="{StaticResource KX_IconPlay}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="spotlight"><Setter Property="Data" Value="{StaticResource KX_IconFlag}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="free"><Setter Property="Data" Value="{StaticResource KX_IconTag}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="wishlist"><Setter Property="Data" Value="{StaticResource KX_IconHeart}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="release"><Setter Property="Data" Value="{StaticResource KX_IconCalendar}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="downloads"><Setter Property="Data" Value="{StaticResource KX_IconDownload}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="friends"><Setter Property="Data" Value="{StaticResource KX_IconProfile}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="pcstats"><Setter Property="Data" Value="{StaticResource KX_IconChart}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="capture"><Setter Property="Data" Value="{StaticResource KX_IconGallery}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="text"><Setter Property="Data" Value="{StaticResource KX_IconNote}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="image"><Setter Property="Data" Value="{StaticResource KX_IconGallery}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="web"><Setter Property="Data" Value="{StaticResource KX_IconGlobe}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="feed"><Setter Property="Data" Value="{StaticResource KX_IconNews}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="data"><Setter Property="Data" Value="{StaticResource KX_IconChart}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource KX_TextDim}" Foreground="{Binding DimBrush}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="17" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource KX_TextDim}" Foreground="{Binding DimBrush}" FontSize="16" TextWrapping="Wrap"
                                                                   Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <Grid>
                                                            <!-- your own text tile / a data widget: one block of text in its own size, weight and alignment -->
                                                            <TextBlock Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{Binding Big}" Style="{StaticResource KX_Text}"
                                                                       Foreground="{Binding TextBrush}" FontSize="{Binding TextSize}" FontWeight="{Binding TextWeight}" TextAlignment="{Binding TextAlign}"
                                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <!-- a picture tile / a web snippet's picture of its page -->
                                                            <Border Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}" CornerRadius="18" RenderOptions.BitmapScalingMode="Fant">
                                                                <Border.Background><ImageBrush ImageSource="{Binding Photo}" Stretch="{Binding ImageStretch}" AlignmentY="{Binding ImageAlignY}" /></Border.Background>
                                                            </Border>
                                                            <!-- big number / word, a line under it, then small rows -->
                                                            <StackPanel Visibility="{Binding IsBig, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding Big}" Style="{StaticResource KX_TextTitle}" Foreground="{Binding TextBrush}" FontSize="62" Margin="0,-8,0,0"
                                                                           Visibility="{Binding HasBig, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <TextBlock Text="{Binding Sub}" Style="{StaticResource KX_TextSub}" Foreground="{Binding SubBrush}" FontSize="19" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"
                                                                           Visibility="{Binding HasSub, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,1,0,1">
                                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource KX_TextDim}" Foreground="{Binding DataContext.DimBrush, RelativeSource={RelativeSource AncestorType=Viewbox}}" FontSize="16" Margin="0,0,14,0" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource KX_Text}" Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Viewbox}}" FontSize="16" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                            <!-- three pictures with a name and a line -->
                                                            <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" Visibility="{Binding IsCards, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <!-- a game you can open (A, or a click): Up from the games gets here -->
                                                                        <ButtonEx Command="{Binding Command}" Focusable="{Binding IsClickable}" IsHitTestVisible="{Binding IsClickable}"
                                                                                  FocusVisualStyle="{x:Null}" Margin="0,0,10,0">
                                                                            <ButtonEx.Template>
                                                                                <ControlTemplate TargetType="ButtonEx">
                                                                                    <Border x:Name="Ring" CornerRadius="13" BorderThickness="2.5" BorderBrush="Transparent" Padding="3" Background="Transparent">
                                                                                        <ContentPresenter />
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#66FFFFFF" /></Trigger>
                                                                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource KX_AccentBrush}" /></Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </ButtonEx.Template>
                                                                        <StackPanel>
                                                                            <Grid Height="150">
                                                                                <Border CornerRadius="10" Background="#26FFFFFF" />
                                                                                <Border CornerRadius="10" RenderOptions.BitmapScalingMode="Fant">
                                                                                    <Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" /></Border.Background>
                                                                                </Border>
                                                                            </Grid>
                                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource KX_Text}" Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Viewbox}}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="16" TextTrimming="CharacterEllipsis" Margin="2,8,2,0" />
                                                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource KX_TextDim}" Foreground="{Binding DataContext.DimBrush, RelativeSource={RelativeSource AncestorType=Viewbox}}" FontSize="14" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="2,2,2,0" />
                                                                        </StackPanel>
                                                                        </ButtonEx>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- a photo with a caption -->
                                                            <Grid Visibility="{Binding IsPhoto, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Border CornerRadius="12" Background="#26FFFFFF" />
                                                                <Border CornerRadius="12" RenderOptions.BitmapScalingMode="Fant">
                                                                    <Border.Background><ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill" /></Border.Background>
                                                                </Border>
                                                                <Border VerticalAlignment="Bottom" CornerRadius="0,0,12,12" Background="#B3000000" Padding="12,6">
                                                                    <TextBlock Text="{Binding PhotoCaption}" Style="{StaticResource KX_TextSub}" Foreground="{Binding SubBrush}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                                </Border>
                                                            </Grid>
                                                            <!-- rows: a name and what's going on -->
                                                            <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" Visibility="{Binding IsLines, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <ButtonEx Command="{Binding Command}" Focusable="{Binding IsClickable}" IsHitTestVisible="{Binding IsClickable}" FocusVisualStyle="{x:Null}" Margin="-6,0,-6,4">
                                                                            <ButtonEx.Template>
                                                                                <ControlTemplate TargetType="ButtonEx">
                                                                                    <Border x:Name="Ring" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Padding="6,4">
                                                                                        <ContentPresenter />
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#66FFFFFF" /></Trigger>
                                                                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource KX_AccentBrush}" /></Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </ButtonEx.Template>
                                                                        <StackPanel Margin="0,0,0,6">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Ellipse Width="9" Height="9" Fill="#FF4ADE80" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                         Visibility="{Binding IsOnline, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource KX_Text}" Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Viewbox}}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="17" TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding Value}" Style="{StaticResource KX_TextDim}" Foreground="{Binding DataContext.DimBrush, RelativeSource={RelativeSource AncestorType=Viewbox}}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                                            <Grid Height="5" Margin="0,6,0,0" Visibility="{Binding HasBar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding BarDone}" /><ColumnDefinition Width="{Binding BarLeft}" /></Grid.ColumnDefinitions>
                                                                                <Border Grid.ColumnSpan="2" CornerRadius="2.5" Background="#33FFFFFF" />
                                                                                <Border CornerRadius="2.5" Background="{DynamicResource KX_AccentBrush}" />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                        </ButtonEx>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </DockPanel>
                                                </Border>
                                            </Viewbox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- ===================== COVER ROW (edge to edge, sits low) ===================== -->
                                <ListBoxEx x:Name="PART_ListGameItems" Grid.Row="1" Grid.RowSpan="2"
                                           Width="{PluginSettings Plugin=Kippix, Path=CardsWidth, FallbackValue=Auto}" HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=CardsHAlign, FallbackValue=Stretch}"
                                           Height="{PluginSettings Plugin=Kippix, Path=CardsHeight, FallbackValue=550}" VerticalAlignment="Bottom" Margin="{PluginSettings Plugin=Kippix, Path=CardsMargin, FallbackValue='0,0,0,-55'}"
                                           Background="Transparent" BorderThickness="0" Padding="0"
                                           FocusVisualStyle="{x:Null}" ClipToBounds="False"
                                           ScrollViewer.HorizontalScrollBarVisibility="{PluginSettings Plugin=Kippix, Path=CardsHScroll, FallbackValue=Hidden}"
                                           ScrollViewer.VerticalScrollBarVisibility="{PluginSettings Plugin=Kippix, Path=CardsVScroll, FallbackValue=Disabled}"
                                           ScrollViewer.CanContentScroll="True"
                                           KeyboardNavigation.DirectionalNavigation="Once">
                                    <ListBoxEx.Template>
                                        <ControlTemplate TargetType="ListBoxEx">
                                            <!-- one row scrolls sideways; the grid (Settings › Home settings › Game cards and layout) scrolls down -->
                                            <ScrollViewer x:Name="ScrollViewer" Focusable="False" CanContentScroll="True" Padding="0"
                                                          HorizontalScrollBarVisibility="{PluginSettings Plugin=Kippix, Path=CardsHScroll, FallbackValue=Hidden}"
                                                          VerticalScrollBarVisibility="{PluginSettings Plugin=Kippix, Path=CardsVScroll, FallbackValue=Disabled}">
                                                <ScrollViewer.Template>
                                                    <ControlTemplate TargetType="ScrollViewer">
                                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                                                    </ControlTemplate>
                                                </ScrollViewer.Template>
                                                <ItemsPresenter Margin="{PluginSettings Plugin=Kippix, Path=CardsTopRoom, FallbackValue=0}" />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ListBoxEx.Template>
                                </ListBoxEx>

                                <!-- ===================== ROW'S CAROUSEL (Settings › Home settings › Game cards and layout › Row: Lower with Loop, Tall, Full Screen; Folder's tiles) =====================
                                     Fills the whole home screen (all three rows, never sized from its cards) and sits under everything else on it (the top bar,
                                     the filter name, the logo / info / hints and the widgets draw over it). The helper puts the cards on the Canvas at rectangles
                                     from CarouselGeometry and shows / collapses the host itself (CarApplyShown); Playnite's row above stays in place, out of sight,
                                     and keeps the highlight. The unseen button takes the highlight on items that aren't games (A runs them). Moved with the Game
                                     cards in Free move. -->
                                <Grid x:Name="KX_CarouselHost" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="False" Panel.ZIndex="-1"
                                      Visibility="Collapsed">
                                    <Canvas x:Name="KX_Carousel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="False" />
                                    <ButtonEx x:Name="KX_CarouselFocus" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False"
                                              FocusVisualStyle="{x:Null}" Command="{PluginSettings Plugin=Kippix, Path=CarouselActivateCommand}" />
                                </Grid>


                                <!-- ===================== THE BOARD (Home layout: Board): cards placed on a grid, set in code ===================== -->
                                <Grid x:Name="KX_BoardHost" Grid.Row="1" Grid.RowSpan="2" Margin="72,8,72,74"
                                      Visibility="{PluginSettings Plugin=Kippix, Path=IsBoardMode, FallbackValue=Collapsed}">
                                    <ItemsControl x:Name="KX_Board" ItemsSource="{PluginSettings Plugin=Kippix, Path=BoardTiles}" Focusable="False" ClipToBounds="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ButtonEx Command="{Binding Command}" FocusVisualStyle="{x:Null}" Width="{Binding Width}" Height="{Binding Height}" Opacity="{Binding TileOpacity}" RenderTransformOrigin="0.5,0.5"
                                                          Focusable="{Binding CanFocus}" Visibility="{Binding TileVisibility}">
                                                    <ButtonEx.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></ButtonEx.RenderTransform>
                                                    <ButtonEx.Template>
                                                        <ControlTemplate TargetType="ButtonEx">
                                                            <Grid RenderTransformOrigin="0.5,0.5" Opacity="{Binding CardOpacity}">
                                                                <!-- turned with LT / RT while it's picked up (inside the button: its own scale stays as it animates); its own opacity: Menu › Opacity -->
                                                                <Grid.RenderTransform><RotateTransform Angle="{Binding Rotation}" /></Grid.RenderTransform>
                                                                <!-- editing: an empty square (A adds a card) -->
                                                                <Border x:Name="SlotBox" CornerRadius="10" BorderThickness="2" BorderBrush="#40FFFFFF" Background="#12FFFFFF" Visibility="{Binding IsSlot, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="+" FontSize="44" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <!-- cropping (Manual board, ThemeApi.BoardCrop.cs): the whole tile's shape, faint, behind the part that's left, so you see what the crop takes away (the picture fills the part that's left) -->
                                                                <Grid Margin="{Binding FullMargin}" IsHitTestVisible="False" Visibility="{Binding IsCropping, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Grid Clip="{Binding FullClip}">
                                                                        <Border Background="#2EFFFFFF" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Visibility="{Binding IsCard, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <!-- a card (games, Store games, shortcuts): its own background and shadow; pieces (logo, info, widget, empty) have none -->
                                                                    <!-- its background (Tile settings › Look: a card, see-through or none) -->
                                                                    <Grid Visibility="{Binding ShowBack, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <Border CornerRadius="10" Background="{Binding BackBrush}" Visibility="{Binding IsRounded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <Border.Effect><DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.55" /></Border.Effect>
                                                                        </Border>
                                                                        <Path Data="{Binding Outline}" Stretch="Fill" Fill="{Binding BackBrush}" Visibility="{Binding IsCut, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <Path.Effect><DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.55" /></Path.Effect>
                                                                        </Path>
                                                                    </Grid>
                                                                    <!-- its icon and name (shortcuts, libraries; a game's name until its picture loads) -->
                                                                    <Grid Visibility="{Binding ShowLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                                                            <Path Width="44" Height="44" Margin="0,0,0,12" HorizontalAlignment="Center" Stroke="{DynamicResource KX_AccentBrush}"
                                                                                  Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <Path.Style>
                                                                                    <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                                                        <Setter Property="Data" Value="{StaticResource KX_IconShelf}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Icon}" Value="store"><Setter Property="Data" Value="{StaticResource KX_IconStore}" /></DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Icon}" Value="trophy"><Setter Property="Data" Value="{StaticResource KX_IconTrophy}" /></DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Icon}" Value="gallery"><Setter Property="Data" Value="{StaticResource KX_IconGallery}" /></DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Icon}" Value="search"><Setter Property="Data" Value="{StaticResource KX_IconSearch}" /></DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Icon}" Value="dice"><Setter Property="Data" Value="{StaticResource KX_IconDice}" /></DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Path.Style>
                                                                            </Path>
                                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource KX_Text}" FontSize="20" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <!-- game info / How long to beat: the highlighted game's, straight over the background -->
                                                                    <StackPanel Margin="8,6" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                                        <StackPanel.Effect><DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.9" /></StackPanel.Effect>
                                                                        <TextBlock Text="{Binding PieceTitle}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="28" TextWrapping="Wrap"
                                                                                   Visibility="{Binding HasPieceTitle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        <TextBlock Text="{Binding PieceText}" Style="{StaticResource KX_Text}" FontSize="19" Opacity="0.9" LineHeight="28" TextWrapping="Wrap"
                                                                                   Visibility="{Binding HasPieceText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                    <Grid Clip="{Binding Clip}">
                                                                        <!-- (cropped on the Manual board: cut where you trimmed, laid out at the whole tile (ArtMargin), or filling the part that's left, centred on it) -->
                                                                        <Border Margin="{Binding ArtMargin}">
                                                                            <Border.Background><ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" AlignmentX="{Binding AlignX}" AlignmentY="{Binding AlignY}" /></Border.Background>
                                                                        </Border>
                                                                        <Image Source="{Binding Logo}" Stretch="Uniform" MaxWidth="{Binding LogoMaxW}" MaxHeight="{Binding LogoMaxH}" Margin="{Binding LogoMargin}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="{Binding LogoVAlign}" RenderOptions.BitmapScalingMode="Fant"
                                                                               Visibility="{Binding HasLogo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <Image.Effect><DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.8" /></Image.Effect>
                                                                        </Image>
                                                                        <TextBlock Text="{Binding CenterName}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="24" TextWrapping="Wrap" TextAlignment="Center"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="{Binding LogoVAlign}" Margin="{Binding LogoMargin}" MaxWidth="{Binding LogoMaxW}"
                                                                                   Visibility="{Binding HasCenterName, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.9" /></TextBlock.Effect>
                                                                        </TextBlock>
                                                                        <!-- the info the card has room for (Card settings › Info on the card) -->
                                                                        <Border VerticalAlignment="Bottom" Padding="16,34,16,12" Visibility="{Binding HasInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                    <GradientStop Color="#00000000" Offset="0" />
                                                                                    <GradientStop Color="#CC000000" Offset="0.55" />
                                                                                    <GradientStop Color="#E6000000" Offset="1" />
                                                                                </LinearGradientBrush>
                                                                            </Border.Background>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Title}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="22" TextTrimming="CharacterEllipsis"
                                                                                           Visibility="{Binding HasTitle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                                <TextBlock Text="{Binding InfoText}" Style="{StaticResource KX_Text}" FontSize="16" Opacity="0.85" TextTrimming="CharacterEllipsis" LineHeight="22"
                                                                                           Visibility="{Binding HasInfoText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                    <Border x:Name="Ring" CornerRadius="11" Margin="-3" BorderThickness="2.3" BorderBrush="{DynamicResource KX_AccentBrush}" Opacity="0" IsHitTestVisible="False"
                                                                            Visibility="{Binding IsRounded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <Border.Effect><DropShadowEffect Color="White" BlurRadius="14" ShadowDepth="0" Opacity="0.5" /></Border.Effect>
                                                                    </Border>
                                                                    <Path x:Name="RingShape" Data="{Binding Outline}" Stretch="Fill" Margin="-3" StrokeThickness="2.6" Stroke="{DynamicResource KX_AccentBrush}" Opacity="0" IsHitTestVisible="False"
                                                                          Visibility="{Binding IsCut, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <Path.Effect><DropShadowEffect Color="White" BlurRadius="14" ShadowDepth="0" Opacity="0.5" /></Path.Effect>
                                                                    </Path>
                                                                </Grid>
                                                                <!-- editing: a dashed frame round each card; the one picked up in the accent colour, with what it's doing -->
                                                                <Rectangle RadiusX="11" RadiusY="11" Margin="-7" Stroke="#B3FFFFFF" StrokeThickness="1.5" StrokeDashArray="4 3" IsHitTestVisible="False"
                                                                           Visibility="{Binding FrameRect, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Path Data="{Binding Outline}" Stretch="Fill" Margin="-7" Stroke="#B3FFFFFF" StrokeThickness="1.5" StrokeDashArray="4 3" IsHitTestVisible="False"
                                                                      Visibility="{Binding FrameCut, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Rectangle RadiusX="11" RadiusY="11" Margin="-7" Stroke="{DynamicResource KX_AccentBrush}" StrokeThickness="3" StrokeDashArray="3 2" IsHitTestVisible="False"
                                                                           Visibility="{Binding PickRect, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Path Data="{Binding Outline}" Stretch="Fill" Margin="-7" Stroke="{DynamicResource KX_AccentBrush}" StrokeThickness="3" StrokeDashArray="3 2" IsHitTestVisible="False"
                                                                      Visibility="{Binding PickCut, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <!-- (0.91) Manual board groups (editing): a cyan line round each grouped tile and the group's name -->
                                                                <Rectangle RadiusX="12" RadiusY="12" Margin="-4" Stroke="#FF5CE1E6" StrokeThickness="2.5" IsHitTestVisible="False"
                                                                           Visibility="{Binding GroupMark, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Border CornerRadius="8" Background="#FF5CE1E6" Padding="9,2" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                                                        Visibility="{Binding GroupMark, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding GroupText}" FontSize="13" FontFamily="{DynamicResource FontTitilliumWebBold}" Foreground="#FF0B0D14" />
                                                                </Border>
                                                                <!-- (0.93) Placement order: the tile's number -->
                                                                <Border Width="96" Height="96" CornerRadius="48" Background="#E60B0D14" BorderBrush="#FF5CE1E6" BorderThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                                        Visibility="{Binding HasOrderBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding OrderBadge}" FontSize="50" FontFamily="{DynamicResource FontTitilliumWebBold}" Foreground="#FF5CE1E6" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0" />
                                                                </Border>
                                                                <Border CornerRadius="8" Background="{DynamicResource KX_AccentBrush}" Padding="10,3" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                                                                        Visibility="{Binding HasPickText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding PickText}" FontSize="15" FontFamily="{DynamicResource FontTitilliumWebBold}" Foreground="#FF0D0F12" />
                                                                </Border>
                                                                <!-- cropping: a dashed line round the whole tile, and on each edge the D-pad arm that trims it (hold RB: grows it back) -->
                                                                <Path Data="{Binding FullClip}" Margin="{Binding FullMargin}" Stroke="#CCFFFFFF" StrokeThickness="1.5" StrokeDashArray="5 4" IsHitTestVisible="False"
                                                                      Visibility="{Binding IsCropping, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Grid IsHitTestVisible="False" Visibility="{Binding IsCropping, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Grid.Resources>
                                                                        <Style x:Key="KX_CropBadge" TargetType="Border">
                                                                            <Setter Property="Width" Value="30" />
                                                                            <Setter Property="Height" Value="30" />
                                                                            <Setter Property="CornerRadius" Value="15" />
                                                                            <Setter Property="Background" Value="#F20D0F12" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource KX_AccentBrush}" />
                                                                            <Setter Property="BorderThickness" Value="1.5" />
                                                                        </Style>
                                                                    </Grid.Resources>
                                                                    <Border Style="{StaticResource KX_CropBadge}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-15,0,0">
                                                                        <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                                                                            <Path Data="M8.5,1.5 H15.5 V8.5 H22.5 V15.5 H15.5 V22.5 H8.5 V15.5 H1.5 V8.5 H8.5 Z" Stroke="#B3FFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                                                            <Path Data="M9.6,2.6 H14.4 V9 L12,11.4 L9.6,9 Z" Fill="{DynamicResource KX_AccentBrush}" />
                                                                        </Canvas></Viewbox>
                                                                    </Border>
                                                                    <Border Style="{StaticResource KX_CropBadge}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-15">
                                                                        <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                                                                            <Path Data="M8.5,1.5 H15.5 V8.5 H22.5 V15.5 H15.5 V22.5 H8.5 V15.5 H1.5 V8.5 H8.5 Z" Stroke="#B3FFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                                                            <Path Data="M9.6,21.4 H14.4 V15 L12,12.6 L9.6,15 Z" Fill="{DynamicResource KX_AccentBrush}" />
                                                                        </Canvas></Viewbox>
                                                                    </Border>
                                                                    <Border Style="{StaticResource KX_CropBadge}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-15,0,0,0">
                                                                        <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                                                                            <Path Data="M8.5,1.5 H15.5 V8.5 H22.5 V15.5 H15.5 V22.5 H8.5 V15.5 H1.5 V8.5 H8.5 Z" Stroke="#B3FFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                                                            <Path Data="M2.6,9.6 V14.4 H9 L11.4,12 L9,9.6 Z" Fill="{DynamicResource KX_AccentBrush}" />
                                                                        </Canvas></Viewbox>
                                                                    </Border>
                                                                    <Border Style="{StaticResource KX_CropBadge}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-15,0">
                                                                        <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                                                                            <Path Data="M8.5,1.5 H15.5 V8.5 H22.5 V15.5 H15.5 V22.5 H8.5 V15.5 H1.5 V8.5 H8.5 Z" Stroke="#B3FFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                                                            <Path Data="M21.4,9.6 V14.4 H15 L12.6,12 L15,9.6 Z" Fill="{DynamicResource KX_AccentBrush}" />
                                                                        </Canvas></Viewbox>
                                                                    </Border>
                                                                </Grid>
                                                                <!-- editing: what a piece is (logo, game info, a widget, kept clear) -->
                                                                <Border CornerRadius="8" Background="#CC0D0F12" Padding="10,3" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                                                        Visibility="{Binding ShowEditLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding EditLabel}" FontSize="15" Foreground="White" />
                                                                </Border>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                                    <Setter TargetName="RingShape" Property="Opacity" Value="1" />
                                                                    <!-- an empty square has no Ring (it lives in the card part): light its own edge -->
                                                                    <Setter TargetName="SlotBox" Property="BorderBrush" Value="{DynamicResource KX_AccentBrush}" />
                                                                    <Setter TargetName="SlotBox" Property="BorderThickness" Value="3" />
                                                                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.04" Duration="0:0:0.2" />
                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.04" Duration="0:0:0.2" />
                                                                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2" />
                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2" />
                                                                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.5" /><Setter TargetName="RingShape" Property="Opacity" Value="0.5" /></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ButtonEx.Template>
                                                </ButtonEx>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- page indicator: dots or "2 / 5" (Board settings › Pages) -->
                                    <StackPanel IsHitTestVisible="False" HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=BoardIndicatorHAlign, FallbackValue=Center}"
                                                VerticalAlignment="{PluginSettings Plugin=Kippix, Path=BoardIndicatorVAlign, FallbackValue=Bottom}"
                                                Margin="{PluginSettings Plugin=Kippix, Path=BoardIndicatorMargin, FallbackValue='0,0,0,-46'}"
                                                Visibility="{PluginSettings Plugin=Kippix, Path=BoardShowPages, FallbackValue=Collapsed}">
                                        <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=BoardDots}" Focusable="False"
                                                      Visibility="{PluginSettings Plugin=Kippix, Path=BoardDotsAcross, FallbackValue=Collapsed}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding DotWidth}" Height="{Binding DotHeight}" CornerRadius="5" Margin="5" Background="White" Opacity="{Binding DotOpacity}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=BoardDots}" Focusable="False"
                                                      Visibility="{PluginSettings Plugin=Kippix, Path=BoardDotsDown, FallbackValue=Collapsed}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding DotWidth}" Height="{Binding DotHeight}" CornerRadius="5" Margin="5" Background="White" Opacity="{Binding DotOpacity}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border CornerRadius="12" Background="#99000000" Padding="14,3" Visibility="{PluginSettings Plugin=Kippix, Path=BoardPageNumber, FallbackValue=Collapsed}">
                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=BoardPageText}" Style="{StaticResource KX_Text}" FontSize="18" />
                                        </Border>
                                    </StackPanel>
                                    <!-- editing: what's going on, then what the buttons do (ThemeApi.EditHints.cs: the theme's button icons, grouped) -->
                                    <Border CornerRadius="14" Background="#F00D0F12" BorderBrush="{DynamicResource KX_AccentBrush}" BorderThickness="1.5" Padding="26,8,26,6" Margin="0,0,0,-66"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False" MaxWidth="1720"
                                            Visibility="{PluginSettings Plugin=Kippix, Path=BoardEditing, FallbackValue=Collapsed}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=BoardHintText}" Style="{StaticResource KX_Text}" FontSize="16" Opacity="0.75" />
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=BoardHintWarn}" Style="{StaticResource KX_Text}" FontSize="16" FontWeight="Bold" FontFamily="{DynamicResource FontTitilliumWebBold}"
                                                           Foreground="#FFFF4D4D" Margin="10,0,0,0" Visibility="{PluginSettings Plugin=Kippix, Path=HasBoardHintWarn, FallbackValue=Collapsed}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=BoardHints}" ItemTemplate="{StaticResource KX_EditHintGroupTemplate}" Focusable="False" IsTabStop="False"
                                                          HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- ===================== EXTRA ROWS UNDER THE GAMES (Settings › Home settings › Game cards and layout): Down from the games ===================== -->
                                <Canvas x:Name="KX_ExtraRowsCanvas" Grid.Row="0" Grid.RowSpan="3" Visibility="{PluginSettings Plugin=Kippix, Path=ShowExtraRows, FallbackValue=Collapsed}">
                                    <ItemsControl x:Name="KX_ExtraRows" Canvas.Left="72" ItemsSource="{PluginSettings Plugin=Kippix, Path=ExtraRowsList}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Opacity="{Binding RowOpacity}" Margin="0,0,0,26">
                                                    <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="24" Height="46">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource KX_Text}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=ShowFilterLabel}" Value="True"><Setter Property="Opacity" Value="0" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <TextBlock.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.7" /></TextBlock.Effect>
                                                    </TextBlock>
                                                    <ItemsControl x:Name="KX_RowTiles" ItemsSource="{Binding Tiles}" Focusable="False" Height="{Binding TileHeight}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <!-- the highlighted (1.06x) tile draws over its neighbours -->
                                                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Panel.ZIndex" Value="90" /></Trigger></Style.Triggers></Style></ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ButtonEx Command="{Binding Command}" FocusVisualStyle="{x:Null}" Width="{Binding Width}" Height="{Binding Height}" Margin="{Binding TileMargin}" RenderTransformOrigin="0.5,1">
                                                                    <ButtonEx.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></ButtonEx.RenderTransform>
                                                                    <ButtonEx.Template>
                                                                        <ControlTemplate TargetType="ButtonEx">
                                                                            <Grid>
                                                                                <Border CornerRadius="10" Background="#FF1E2229" Visibility="{Binding IsRounded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.55" /></Border.Effect>
                                                                                </Border>
                                                                                <!-- a cut shape (circle, hexagon, triangle): its own shadow; the helper sets the outline and clip -->
                                                                                <Path Data="{Binding Outline}" Stretch="Fill" Fill="#FF1E2229" Visibility="{Binding IsCut, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <Path.Effect><DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.55" /></Path.Effect>
                                                                                </Path>
                                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource KX_Text}" FontSize="20" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" />
                                                                                <Border Clip="{Binding Clip}">
                                                                                    <Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" /></Border.Background>
                                                                                </Border>
                                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding BadgeAlign}" VerticalAlignment="Top" Margin="{Binding BadgeTop}" IsHitTestVisible="False">
                                                                                    <Border CornerRadius="8" Background="#E6FFFFFF" Padding="8,2" Margin="0,0,6,0" Visibility="{Binding ShowNew, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                        <TextBlock Text="{DynamicResource LOC_KX_BadgeNewText}" FontSize="13" FontFamily="{DynamicResource FontTitilliumWebBold}" Foreground="#FF0D0F12" />
                                                                                    </Border>
                                                                                    <Border CornerRadius="8" Background="#CC0D0F12" Padding="6,3" Visibility="{Binding ShowInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                        <Path Data="{StaticResource KX_IconCheck}" Style="{StaticResource KX_IconPath}" Stroke="#FF4ADE80" StrokeThickness="2.4" Width="14" Height="14" />
                                                                                    </Border>
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding BadgeAlign}" VerticalAlignment="Bottom" Margin="{Binding BadgeBottom}" IsHitTestVisible="False">
                                                                                    <Border CornerRadius="8" Background="#CC0D0F12" Padding="8,2" Margin="0,0,6,0" Visibility="{Binding ShowAch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                        <TextBlock Text="{Binding AchText}" FontSize="13" Foreground="White" />
                                                                                    </Border>
                                                                                    <Border CornerRadius="8" Background="#CC0D0F12" Padding="8,2" Visibility="{Binding ShowHltb, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                        <TextBlock Text="{Binding HltbText}" FontSize="13" Foreground="White" />
                                                                                    </Border>
                                                                                </StackPanel>
                                                                                <Border x:Name="Ring" CornerRadius="11" Margin="-3" BorderThickness="2.3" BorderBrush="{DynamicResource KX_AccentBrush}" Opacity="0" IsHitTestVisible="False"
                                                                                        Visibility="{Binding IsRounded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <Border.Effect><DropShadowEffect Color="White" BlurRadius="14" ShadowDepth="0" Opacity="0.5" /></Border.Effect>
                                                                                </Border>
                                                                                <Path x:Name="RingShape" Data="{Binding Outline}" Stretch="Fill" Margin="-3" StrokeThickness="2.6" Stroke="{DynamicResource KX_AccentBrush}" Opacity="0" IsHitTestVisible="False"
                                                                                      Visibility="{Binding IsCut, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <Path.Effect><DropShadowEffect Color="White" BlurRadius="14" ShadowDepth="0" Opacity="0.5" /></Path.Effect>
                                                                                </Path>
                                                                            </Grid>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                                                    <Setter TargetName="RingShape" Property="Opacity" Value="1" />
                                                                                    <Setter Property="Panel.ZIndex" Value="90" />
                                                                                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.06" Duration="0:0:0.2" />
                                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.06" Duration="0:0:0.2" />
                                                                                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                                                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2" />
                                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2" />
                                                                                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                                                </Trigger>
                                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.5" /><Setter TargetName="RingShape" Property="Opacity" Value="0.5" /></Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ButtonEx.Template>
                                                                </ButtonEx>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                                <!-- ===================== TILES BEFORE THE GAMES (Store, Achievements, Random game): Settings › Home settings ===================== -->
                                <Canvas x:Name="KX_HomeTilesCanvas" Grid.Row="0" Grid.RowSpan="3">
                                    <ItemsControl x:Name="KX_HomeTiles" ItemsSource="{PluginSettings Plugin=Kippix, Path=HomeTiles}" Focusable="False"
                                                  Canvas.Left="{PluginSettings Plugin=Kippix, Path=HomeTilesLeft, FallbackValue=0}" Canvas.Top="{PluginSettings Plugin=Kippix, Path=HomeTilesTop, FallbackValue=0}"
                                                  KeyboardNavigation.DirectionalNavigation="Continue"
                                                  Visibility="{PluginSettings Plugin=Kippix, Path=HomeTilesShown, FallbackValue=Collapsed}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="{PluginSettings Plugin=Kippix, Path=HomeTilesVertical, FallbackValue=Horizontal}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <!-- the highlighted tile draws over its neighbours -->
                                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Panel.ZIndex" Value="90" /></Trigger></Style.Triggers></Style></ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ButtonEx Command="{Binding Command}" FocusVisualStyle="{x:Null}" RenderTransformOrigin="0.5,0.5"
                                                          Width="{PluginSettings Plugin=Kippix, Path=HomeTileWidth, FallbackValue=300}" Height="{PluginSettings Plugin=Kippix, Path=HomeTileHeight, FallbackValue=400}"
                                                          Margin="{PluginSettings Plugin=Kippix, Path=HomeTileMargin, FallbackValue='0,0,20,0'}">
                                                    <ButtonEx.Template>
                                                        <ControlTemplate TargetType="ButtonEx">
                                                            <Grid>
                                                                <Border x:Name="Card" CornerRadius="10" BorderThickness="2.3" BorderBrush="#33FFFFFF">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                            <GradientStop Color="#FF24324A" Offset="0" />
                                                                            <GradientStop Color="#FF101216" Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <!-- a pinned game: its cover -->
                                                                <Border CornerRadius="10" Visibility="{Binding HasCover, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" /></Border.Background>
                                                                </Border>
                                                                <Border CornerRadius="8" Background="#CC0D0F12" Padding="7,4" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                        Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Path Data="{StaticResource KX_IconPin}" Style="{StaticResource KX_IconPath}" Width="14" Height="14" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" FontSize="20" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource KX_Text}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions><Condition Binding="{Binding IsPinned}" Value="True" /><Condition Binding="{Binding HasCover}" Value="False" /></MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <!-- (0.96) shrinks to fit a small tile (the Grid's Library wall) instead of being cut off -->
                                                                <Viewbox StretchDirection="DownOnly" Margin="12">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Orientation" Value="Vertical" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=IsListMode}" Value="True"><Setter Property="Orientation" Value="Horizontal" /></DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Grid.Style>
                                                                            <Style TargetType="Grid">
                                                                                <Setter Property="Margin" Value="0,0,0,18" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=IsListMode}" Value="True"><Setter Property="Margin" Value="0,0,22,0" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Grid.Style>
                                                                        <Path Width="64" Height="64" Stroke="White" StrokeThickness="2">
                                                                            <Path.Style>
                                                                                <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                                                    <Setter Property="Data" Value="{StaticResource KX_IconStore}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsAch}" Value="True"><Setter Property="Data" Value="{StaticResource KX_IconTrophy}" /></DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsRandom}" Value="True"><Setter Property="Data" Value="{StaticResource KX_IconRefresh}" /></DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsUpNext}" Value="True"><Setter Property="Data" Value="{StaticResource KX_IconForward}" /></DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsLibrary}" Value="True"><Setter Property="Data" Value="{StaticResource KX_IconGrid}" /></DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Path.Style>
                                                                        </Path>
                                                                        <Ellipse Width="16" Height="16" Fill="#FF4ADE80" Stroke="Black" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0"
                                                                                 Visibility="{Binding ShowDot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    </Grid>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource KX_TextTitle}" FontSize="30" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource KX_TextSub}" FontSize="17" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                </Viewbox>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsFocused" Value="True">
                                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource KX_AccentBrush}" />
                                                                    <Setter TargetName="Card" Property="Effect">
                                                                        <Setter.Value><DropShadowEffect Color="White" BlurRadius="16" ShadowDepth="0" Opacity="0.5" /></Setter.Value>
                                                                    </Setter>
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value><ScaleTransform ScaleX="1.06" ScaleY="1.06" /></Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ButtonEx.Template>
                                                </ButtonEx>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>

                                <!-- trailer preview over the selected card: the helper places it, widens it to 16:9 and plays it -->
                                <Grid x:Name="KX_PreviewCard" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Width="700" Height="394" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                    <Border CornerRadius="10" Background="Black" Margin="2">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="6" Opacity="0.7" />
                                        </Border.Effect>
                                    </Border>
                                    <Grid x:Name="KX_PreviewCardClip">
                                        <Grid.OpacityMask>
                                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                                                <VisualBrush.Visual>
                                                    <Border Background="Black" CornerRadius="10"
                                                            Width="{Binding ActualWidth, ElementName=KX_PreviewCardClip}"
                                                            Height="{Binding ActualHeight, ElementName=KX_PreviewCardClip}" />
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Grid.OpacityMask>
                                        <MediaElement x:Name="KX_PreviewCardVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" IsHitTestVisible="False" />
                                    </Grid>
                                    <Border CornerRadius="11" Margin="-3" BorderThickness="2.3" BorderBrush="#E9FFFFFF">
                                        <Border.Effect>
                                            <DropShadowEffect Color="White" BlurRadius="14" ShadowDepth="0" Opacity="0.5" />
                                        </Border.Effect>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="1" Grid.RowSpan="2" FontSize="36" Text="{DynamicResource LOCNoGamesFound}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource KX_Text}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0" />
                                                        <Condition Binding="{PluginSettings Plugin=Kippix, Path=LibraryLoading}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Playnite needs these; filters open as their own screen -->
                                <StackPanel Grid.Row="1" Visibility="Collapsed">
                                    <ButtonEx x:Name="PART_ButtonMainMenu" />
                                    <ButtonEx x:Name="PART_ButtonFilter" />
                                    <ButtonEx x:Name="PART_ButtonSearch" />
                                </StackPanel>
                                <DockPanel Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Left">
                                    <Filters x:Name="PART_ElemFilters" DockPanel.Dock="Left" Focusable="False" />
                                    <FiltersAdditional x:Name="PART_ElemFiltersAdditional" DockPanel.Dock="Left" Focusable="False" />
                                    <ContentControl x:Name="PART_ContentFilterItems" DockPanel.Dock="Left" Focusable="False" />
                                </DockPanel>
                            </Grid>

                            <!-- Game page: above the library, below our panels (so its settings can open on top of it) -->
                            <GameDetails x:Name="PART_ElemGameDetails" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                            <!-- ===================== SIDE PANELS (helper add-on) ===================== -->
                            <!-- B goes back a page, then closes (handled by the helper). -->
                            <!-- ZIndex: the Store settings can open over the Store (only one panel is ever open, so nothing else is covered) -->
                            <Border Background="#99000000" Panel.ZIndex="1"
                                    Visibility="{PluginSettings Plugin=Kippix, Path=ShowPanelDim, FallbackValue=Collapsed}" />


                            <!-- ========== PROFILE MENU (your name, top left) ========== -->
                            <Border x:Name="KX_ProfilePanel" Style="{StaticResource KX_Panel}" Width="560" Panel.ZIndex="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,96,0,40"
                                    KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle"
                                    Visibility="{PluginSettings Plugin=Kippix, Path=IsProfileOpen, FallbackValue=Collapsed}">
                                <!-- the same slim scroll bar as the options -->
                                <Border.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="Width" Value="6" />
                                        <Setter Property="MinWidth" Value="6" />
                                        <Setter Property="Margin" Value="8,6,0,6" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Grid>
                                                        <Border CornerRadius="3" Background="#14FFFFFF" />
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <Track.Thumb>
                                                                <Thumb Focusable="False">
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border CornerRadius="3" Background="#73FFFFFF" MinHeight="40" />
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Border.Resources>
                                <DockPanel>
                                    <!-- (0.99.11) at the top right: Refresh game library, and the edit button (reorder the menu; Done while reordering) -->
                                    <DockPanel DockPanel.Dock="Top" Margin="12,0,0,14">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{PluginSettings Plugin=Kippix, Path=ProfileHeadButtons, FallbackValue=Collapsed}">
                                        <ButtonEx x:Name="KX_ProfileRefresh" Style="{StaticResource KX_TopBarButton}" Command="{PluginSettings Plugin=Kippix, Path=ProfileRefreshCommand}" ToolTip="{DynamicResource LOC_KX_RefreshLibrary}"
                                                  Visibility="{PluginSettings Plugin=Kippix, Path=ProfileRefreshShown, FallbackValue=Collapsed}">
                                            <!-- (0.99.44) the user's books-with-refresh icon (Images\library-refresh.png) in the look's text colour; the line icon without it -->
                                            <Grid Width="26" Height="26">
                                                <Rectangle Fill="{DynamicResource KX_TextBrush}" Visibility="{PluginSettings Plugin=Kippix, Path=HasLibraryRefreshIcon, FallbackValue=Collapsed}">
                                                    <Rectangle.OpacityMask><ImageBrush ImageSource="{DynamicResource KX_LibraryRefreshImage}" Stretch="Uniform" /></Rectangle.OpacityMask>
                                                </Rectangle>
                                                <Path Data="{StaticResource KX_IconRefresh}" Style="{StaticResource KX_IconPath}" Stroke="{DynamicResource KX_TextBrush}" Width="24" Height="24"
                                                      Visibility="{PluginSettings Plugin=Kippix, Path=NoLibraryRefreshIcon, FallbackValue=Visible}" />
                                            </Grid>
                                        </ButtonEx>
                                        <!-- (0.99.41) every Steam game on High Priority (closes and reopens Steam; its own pop-up) -->
                                        <ButtonEx x:Name="KX_ProfileSteamPriority" Style="{StaticResource KX_TopBarButton}" Command="{PluginSettings Plugin=Kippix, Path=SteamPriorityCommand}" ToolTip="{DynamicResource LOC_KX_SteamPriorityTip}"
                                                  Visibility="{PluginSettings Plugin=Kippix, Path=ProfileRefreshShown, FallbackValue=Collapsed}">
                                            <!-- (0.99.43) the user's Steam-with-refresh icon (Images\steam-refresh.png), in the look's text colour; the line icon without it -->
                                            <Grid Width="26" Height="26">
                                                <Rectangle Fill="{DynamicResource KX_TextBrush}" Visibility="{PluginSettings Plugin=Kippix, Path=HasSteamPriorityIcon, FallbackValue=Collapsed}">
                                                    <Rectangle.OpacityMask><ImageBrush ImageSource="{DynamicResource KX_SteamRefreshImage}" Stretch="Uniform" /></Rectangle.OpacityMask>
                                                </Rectangle>
                                                <Path Data="{StaticResource KX_IconDownload}" Style="{StaticResource KX_IconPath}" Stroke="{DynamicResource KX_TextBrush}" Width="24" Height="24"
                                                      Visibility="{PluginSettings Plugin=Kippix, Path=NoSteamPriorityIcon, FallbackValue=Visible}" />
                                            </Grid>
                                        </ButtonEx>
                                        <ButtonEx x:Name="KX_ProfileEdit" Style="{StaticResource KX_TopBarButton}" Command="{PluginSettings Plugin=Kippix, Path=ProfileEditCommand}" ToolTip="{DynamicResource LOC_KX_ReorderMenu}">
                                            <Grid>
                                                <Path Data="{StaticResource KX_IconEdit}" Style="{StaticResource KX_IconPath}" Stroke="{DynamicResource KX_TextBrush}" Width="22" Height="22"
                                                      Visibility="{PluginSettings Plugin=Kippix, Path=IsNotProfileReorder, FallbackValue=Visible}" />
                                                <Path Data="{StaticResource KX_IconCheck}" Style="{StaticResource KX_IconPath}" Stroke="{DynamicResource KX_AccentBrush}" Width="22" Height="22"
                                                      Visibility="{PluginSettings Plugin=Kippix, Path=IsProfileReorder, FallbackValue=Collapsed}" />
                                            </Grid>
                                        </ButtonEx>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="52" Height="52">
                                            <Ellipse Fill="#33FFFFFF" />
                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ProfileInitial}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{PluginSettings Plugin=Kippix, Path=ProfilePicture}" Stretch="UniformToFill" Width="52" Height="52" Visibility="{PluginSettings Plugin=Kippix, Path=HasProfilePicture, FallbackValue=Collapsed}">
                                                <Image.Clip><EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26" /></Image.Clip>
                                            </Image>
                                        </Grid>
                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ProfileMenuTitle}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="32" Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16,12,0,0" Opacity="0.75">
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Width="24" Height="24" Focusable="False" />
                                        <TextBlock Text="{DynamicResource LOC_KX_Back}" Style="{StaticResource KX_TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource LOC_KX_MediaHelp}" Style="{StaticResource KX_TextDim}" TextWrapping="Wrap" Margin="16,6,16,0" Visibility="{PluginSettings Plugin=Kippix, Path=IsProfileMediaPage, FallbackValue=Collapsed}" />
                                    <!-- scrolls when the list is longer than the screen (More pages) -->
                                    <ScrollViewer x:Name="KX_ProfileScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <ItemsControl x:Name="KX_ProfileList" ItemsSource="{PluginSettings Plugin=Kippix, Path=ProfileRows}" Focusable="False" ItemTemplate="{StaticResource KX_PickRowTemplate}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <!-- ========== OPTIONS ========== -->
                            <Border x:Name="KX_OptionsPanel" Style="{StaticResource KX_Panel}" Width="620" Panel.ZIndex="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,96,40,40"
                                    KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle"
                                    Visibility="{PluginSettings Plugin=Kippix, Path=IsOptionsOpen, FallbackValue=Collapsed}">
                                <!-- a slim bar on pages longer than the panel, so you can see there's more below -->
                                <Border.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="Width" Value="6" />
                                        <Setter Property="MinWidth" Value="6" />
                                        <Setter Property="Margin" Value="8,6,0,6" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Grid>
                                                        <Border CornerRadius="3" Background="#14FFFFFF" />
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <Track.Thumb>
                                                                <Thumb Focusable="False">
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border CornerRadius="3" Background="#73FFFFFF" MinHeight="40" />
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Border.Resources>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=OptionsTitle}" Style="{StaticResource KX_Text}"
                                               FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="34" Margin="16,0,0,12" TextTrimming="CharacterEllipsis" />
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16,12,0,0" Opacity="0.75">
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Width="24" Height="24" Focusable="False" />
                                        <TextBlock Text="{DynamicResource LOC_KX_Back}" Style="{StaticResource KX_TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Grid>
                                        <!-- categories -->
