                                            </Grid>
                                        </ButtonEx>
                                        <TextBlock Text="{DynamicResource LOC_KX_ManageDownloads}" Style="{StaticResource KX_TextDim}" TextWrapping="Wrap" Margin="16,8,16,8" />
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                                        <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=Downloads}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ButtonEx Style="{StaticResource KX_MenuButton}" Focusable="True" Command="{Binding Command}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource KX_Text}" TextTrimming="CharacterEllipsis" />
                                                            <Grid Height="6" Margin="0,8,0,6"
                                                                  Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Border CornerRadius="3" Background="#33FFFFFF" />
                                                                <Border CornerRadius="3" Background="{DynamicResource KX_AccentBrush}" HorizontalAlignment="Left"
                                                                        Width="{Binding BarWidth}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding Status}" Style="{StaticResource KX_TextDim}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </ButtonEx>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- ========== DISCORD ========== -->
                            <Border x:Name="KX_DiscordPanel" Style="{StaticResource KX_Panel}" Panel.ZIndex="1" Width="680"
                                    HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,96,40,40"
                                    KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle"
                                    Visibility="{PluginSettings Plugin=Kippix, Path=IsDiscordOpen, FallbackValue=Collapsed}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,0,0,4">
                                        <Path Data="{StaticResource KX_IconDiscord}" Style="{StaticResource KX_IconPath}" Stroke="{DynamicResource KX_TextBrush}" Width="34" Height="34" Margin="0,0,14,0" Fill="{Binding Stroke, RelativeSource={RelativeSource Self}}" StrokeThickness="0.6" />
                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=DiscordTitle}" Style="{StaticResource KX_Text}"
                                                   FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="34" TextTrimming="CharacterEllipsis" MaxWidth="540" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=DiscordStatusText}" Style="{StaticResource KX_TextDim}"
                                               Margin="16,2,0,10" TextWrapping="Wrap"
                                               Visibility="{PluginSettings Plugin=Kippix, Path=IsDiscordMainPage, FallbackValue=Visible}" />
                                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOC_KX_Loading}" Style="{StaticResource KX_TextDim}" Margin="16,2,0,10"
                                               Visibility="{PluginSettings Plugin=Kippix, Path=DiscordBusy, FallbackValue=Collapsed}" />
                                    <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=DiscordNote}" Style="{StaticResource KX_TextSub}"
                                               Margin="16,2,16,10" TextWrapping="Wrap"
                                               Visibility="{PluginSettings Plugin=Kippix, Path=HasDiscordNote, FallbackValue=Collapsed}" />
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16,12,0,0" Opacity="0.75">
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Width="24" Height="24" Focusable="False" />
                                        <TextBlock Text="{DynamicResource LOC_KX_Back}" Style="{StaticResource KX_TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Grid>
                                        <!-- main page: status, actions, who's in the call -->
                                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False"
                                                      Visibility="{PluginSettings Plugin=Kippix, Path=IsDiscordMainPage, FallbackValue=Visible}">
                                            <StackPanel>
                                                <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=DiscordStartCommand}"
                                                          Visibility="{PluginSettings Plugin=Kippix, Path=ShowDiscordStart, FallbackValue=Collapsed}">
                                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource KX_IconPlay}" Style="{StaticResource KX_IconPath}" Margin="0,0,16,0" /><TextBlock Text="{DynamicResource LOC_KX_StartDiscord}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" /></StackPanel>
                                                </ButtonEx>
                                                <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=DiscordConnectCommand}"
                                                          Visibility="{PluginSettings Plugin=Kippix, Path=ShowDiscordConnect, FallbackValue=Collapsed}">
                                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource KX_IconDiscord}" Style="{StaticResource KX_IconPath}" Margin="0,0,16,0" Fill="{Binding Stroke, RelativeSource={RelativeSource Self}}" StrokeThickness="0.6" /><TextBlock Text="{DynamicResource LOC_KX_ConnectDiscord}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" /></StackPanel>
                                                </ButtonEx>

                                                <StackPanel Visibility="{PluginSettings Plugin=Kippix, Path=ShowDiscordControls, FallbackValue=Collapsed}">
                                                    <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=DiscordChatsCommand}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <Path Data="{StaticResource KX_IconChat}" Style="{StaticResource KX_IconPath}" Margin="0,0,16,0" />
                                                            <TextBlock Grid.Column="1" Text="{PluginSettings Plugin=Kippix, Path=ChatsLabel}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" />
                                                            <Path Grid.Column="2" Data="{StaticResource KX_IconChevron}" Style="{StaticResource KX_IconPath}" Width="18" Height="18" />
                                                        </Grid>
                                                    </ButtonEx>
                                                    <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=DiscordServersCommand}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <Path Data="{StaticResource KX_IconServers}" Style="{StaticResource KX_IconPath}" Margin="0,0,16,0" />
                                                            <TextBlock Grid.Column="1" Text="{DynamicResource LOC_KX_ServersAndCalls}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" />
                                                            <Path Grid.Column="2" Data="{StaticResource KX_IconChevron}" Style="{StaticResource KX_IconPath}" Width="18" Height="18" />
                                                        </Grid>
                                                    </ButtonEx>
                                                    <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=DiscordMuteCommand}">
                                                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource KX_IconMic}" Style="{StaticResource KX_IconPath}" Margin="0,0,16,0" /><TextBlock Text="{PluginSettings Plugin=Kippix, Path=MuteLabel}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" /></StackPanel>
                                                    </ButtonEx>
                                                    <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=DiscordDeafenCommand}">
                                                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource KX_IconHeadphones}" Style="{StaticResource KX_IconPath}" Margin="0,0,16,0" /><TextBlock Text="{PluginSettings Plugin=Kippix, Path=DeafenLabel}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" /></StackPanel>
                                                    </ButtonEx>
                                                </StackPanel>
                                                <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=DiscordLeaveCommand}"
                                                          Visibility="{PluginSettings Plugin=Kippix, Path=IsInCall, FallbackValue=Collapsed}">
                                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource KX_IconLeave}" Style="{StaticResource KX_IconPath}" Stroke="#FFFF6B6B" Margin="0,0,16,0" /><TextBlock Text="{DynamicResource LOC_KX_LeaveCall}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" /></StackPanel>
                                                </ButtonEx>
                                                <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=DiscordOpenCommand}">
                                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource KX_IconDesktop}" Style="{StaticResource KX_IconPath}" Margin="0,0,16,0" /><TextBlock Text="{DynamicResource LOC_KX_ShowDiscordWindow}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" /></StackPanel>
                                                </ButtonEx>

                                                <!-- who's in the call -->
                                                <StackPanel Margin="0,14,0,0" Visibility="{PluginSettings Plugin=Kippix, Path=IsInCall, FallbackValue=Collapsed}">
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=CallName}" Style="{StaticResource KX_TextDim}" Margin="16,0,0,8" />
                                                    <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=VoiceMembers}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="16,5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Width="40" Height="40">
                                                                        <Ellipse Fill="#33FFFFFF" />
                                                                        <Ellipse>
                                                                            <Ellipse.Fill>
                                                                                <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource ImageStringToImageConverterCached}}" Stretch="UniformToFill" />
                                                                            </Ellipse.Fill>
                                                                        </Ellipse>
                                                                        <Ellipse Stroke="#FF4ADE80" StrokeThickness="2.5"
                                                                                 Visibility="{Binding Speaking, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    </Grid>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource KX_Text}" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" Style="{StaticResource KX_TextDim}" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <!-- list page: chats, servers or a server's channels -->
                                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False"
                                                      Visibility="{PluginSettings Plugin=Kippix, Path=IsDiscordListPage, FallbackValue=Collapsed}">
                                            <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=DiscordList}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{Binding Command}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center">
                                                                    <Ellipse Fill="#26FFFFFF" />
                                                                    <Path Data="{StaticResource KX_IconHash}" Style="{StaticResource KX_IconPath}" Width="20" Height="20"
                                                                          Visibility="{Binding HasIcon, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
                                                                    <Ellipse Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <Ellipse.Fill>
                                                                            <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageStringToImageConverterCached}}" Stretch="UniformToFill" />
                                                                        </Ellipse.Fill>
                                                                    </Ellipse>
                                                                </Grid>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource KX_Text}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource KX_TextDim}" TextTrimming="CharacterEllipsis"
                                                                               Visibility="{Binding HasSubtitle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource KX_IconSpeaker}" Style="{StaticResource KX_IconPath}" Width="20" Height="20"
                                                                          Visibility="{Binding IsVoice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <Border CornerRadius="10" MinWidth="22" Height="22" Padding="6,0" Background="#FFFF4D6A" Margin="10,0,0,0"
                                                                            Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="{Binding Badge}" Style="{StaticResource KX_Text}" FontSize="13" FontFamily="{DynamicResource FontTitilliumWebBold}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </ButtonEx>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- chat page: reply, call, quick replies, latest messages -->
                                        <DockPanel Visibility="{PluginSettings Plugin=Kippix, Path=IsDiscordChatPage, FallbackValue=Collapsed}">
                                            <StackPanel DockPanel.Dock="Top">
                                                <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=DiscordReplyCommand}">
                                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource KX_IconReply}" Style="{StaticResource KX_IconPath}" Margin="0,0,16,0" /><TextBlock Text="{DynamicResource LOC_KX_WriteMessage}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" /></StackPanel>
                                                </ButtonEx>
                                                <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=DiscordCallCommand}"
                                                          Visibility="{PluginSettings Plugin=Kippix, Path=ChatCanCall, FallbackValue=Collapsed}">
                                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource KX_IconPhone}" Style="{StaticResource KX_IconPath}" Margin="0,0,16,0" /><TextBlock Text="{DynamicResource LOC_KX_Call}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" /></StackPanel>
                                                </ButtonEx>
                                                <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=QuickReplies}" Focusable="False" Margin="8,6,8,4"
                                                              Visibility="{PluginSettings Plugin=Kippix, Path=HasQuickReplies, FallbackValue=Collapsed}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ButtonEx Style="{StaticResource KX_PillButton}" Command="{Binding Command}" Content="{Binding Title}"
                                                                      MinWidth="0" Height="46" FontSize="18" Padding="18,0" Margin="0,0,8,8" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Height="1" Background="{DynamicResource KX_HairlineBrush}" Margin="16,6,16,8" />
                                            </StackPanel>
                                            <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                                                <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=DiscordMessages}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- focusable so the d-pad can scroll through messages -->
                                                            <ButtonEx Style="{StaticResource KX_MenuButton}" MinHeight="0" Padding="16,8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Width="34" Height="34" Margin="0,2,12,0" VerticalAlignment="Top">
                                                                        <Ellipse Fill="#26FFFFFF" />
                                                                        <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <Ellipse.Fill>
                                                                                <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource ImageStringToImageConverterCached}}" Stretch="UniformToFill" />
                                                                            </Ellipse.Fill>
                                                                        </Ellipse>
                                                                    </Grid>
                                                                    <StackPanel Grid.Column="1">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Author}" Style="{StaticResource KX_Text}" FontSize="19" FontFamily="{DynamicResource FontTitilliumWebBold}" />
                                                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource KX_TextDim}" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Content}" Style="{StaticResource KX_TextSub}" FontSize="19" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </ButtonEx>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <!-- ========== QUICK SETTINGS (top bar): volume, display, Wi-Fi, Bluetooth, controller ========== -->
                            <Border x:Name="KX_QuickPanel" Style="{StaticResource KX_Panel}" Panel.ZIndex="1" Width="640"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,96,40,40"
                                    KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle"
                                    Visibility="{PluginSettings Plugin=Kippix, Path=IsQuickOpen, FallbackValue=Collapsed}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOC_KX_QuickSettings}" Style="{StaticResource KX_Text}"
                                               FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="34" Margin="16,0,0,14" />
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16,12,0,0" Opacity="0.75">
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Width="24" Height="24" Focusable="False" />
                                        <TextBlock Text="{DynamicResource LOC_KX_Back}" Style="{StaticResource KX_TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- scrolls when there are more rows than room -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <StackPanel>
                                            <ButtonEx x:Name="KX_QuickVolume" Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=QuickMuteCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Path Margin="0,0,16,0"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}"><Setter Property="Data" Value="{StaticResource KX_IconSpeaker}" /><Style.Triggers><DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=QuickMuted}" Value="True"><Setter Property="Data" Value="{StaticResource KX_IconMute}" /></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource LOC_KX_Volume}" Style="{StaticResource KX_Text}" />
                                                <Grid Width="400" Height="8" HorizontalAlignment="Left" Margin="0,8,0,2">
                                                    <Border CornerRadius="4" Background="#22FFFFFF" />
                                                    <Border CornerRadius="4" Background="{DynamicResource KX_AccentBrush}" HorizontalAlignment="Left" Width="{PluginSettings Plugin=Kippix, Path=QuickVolumeWidth, FallbackValue=0}" />
                                                </Grid>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{PluginSettings Plugin=Kippix, Path=QuickVolumeText}" Style="{StaticResource KX_TextSub}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                        </Grid>
                                    </ButtonEx>
                                            <ItemsControl x:Name="KX_QuickList" ItemsSource="{PluginSettings Plugin=Kippix, Path=QuickRows}" Focusable="False" ItemTemplate="{StaticResource KX_PickRowTemplate}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- ========== SOUND OUTPUT ========== -->
                            <Border x:Name="KX_AudioPanel" Style="{StaticResource KX_Panel}" Panel.ZIndex="1" Width="640"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,96,40,40"
                                    KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle"
                                    Visibility="{PluginSettings Plugin=Kippix, Path=IsAudioOpen, FallbackValue=Collapsed}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=AudioPanelTitle}" Style="{StaticResource KX_Text}"
                                               FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="34" Margin="16,0,0,14" />
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16,12,0,0" Opacity="0.75">
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Width="24" Height="24" Focusable="False" />
                                        <TextBlock Text="{DynamicResource LOC_KX_Back}" Style="{StaticResource KX_TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{PluginSettings Plugin=Kippix, Path=AudioPanelHint}" Style="{StaticResource KX_TextDim}" Margin="16,12,0,0" TextWrapping="Wrap" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=AudioDevices}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{Binding SelectCommand}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Path Margin="0,0,16,0"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}"><Setter Property="Data" Value="{StaticResource KX_IconSpeaker}" /><Style.Triggers><DataTrigger Binding="{Binding IsInput}" Value="True"><Setter Property="Data" Value="{StaticResource KX_IconMic}" /></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Ellipse Grid.Column="2" Width="12" Height="12" Fill="#FF4ADE80" VerticalAlignment="Center"
                                                                 Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </Grid>
                                                </ButtonEx>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- ========== ACHIEVEMENTS (Kippix's own screen) ========== -->
                            <Border x:Name="KX_AchievementsView" Background="{PluginSettings Plugin=Kippix, Path=AchBackground, FallbackValue=#F00A0B0E}"
                                    KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=IsAchievementsOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Resources>
                                    <!-- one choice in a sort / filter dropdown -->
                                    <DataTemplate x:Key="KX_PickOptionTemplate">
                                        <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{Binding Command}" MinHeight="56" Margin="0,2" Padding="18,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" Margin="0,0,24,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource KX_TextSub}" VerticalAlignment="Center"
                                                           Visibility="{Binding HasValue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Path Grid.Column="1" Data="{StaticResource KX_IconCheck}" Style="{StaticResource KX_IconPath}" Width="20" Height="20"
                                                      Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </ButtonEx>
                                    </DataTemplate>
                                    <!-- the dropdown box under a chip -->
                                    <Style x:Key="KX_Dropdown" TargetType="Border">
                                        <Setter Property="Background" Value="#FA17191E" />
                                        <Setter Property="BorderBrush" Value="#33FFFFFF" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="16" />
                                        <Setter Property="Padding" Value="8" />
                                        <Setter Property="MinWidth" Value="340" />
                                        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
                                        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect ShadowDepth="6" BlurRadius="30" Opacity="0.6" />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <!-- small "v" after a chip's text -->
                                    <Style x:Key="KX_ChipChevron" TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                        <Setter Property="Data" Value="{StaticResource KX_IconChevron}" />
                                        <Setter Property="Width" Value="16" />
                                        <Setter Property="Height" Value="16" />
                                        <Setter Property="Margin" Value="10,0,0,0" />
                                        <Setter Property="Opacity" Value="0.7" />
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="90" />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <!-- small label pill (facts, "Missable") -->
                                    <Style x:Key="KX_FactPill" TargetType="Border">
                                        <Setter Property="Background" Value="#1FFFFFFF" />
                                        <Setter Property="CornerRadius" Value="12" />
                                        <Setter Property="Padding" Value="14,5" />
                                        <Setter Property="Margin" Value="0,0,10,10" />
                                    </Style>
                                                                    <!-- ===== (0.89) Redesign: each look's cards (ThemeApi.AchRedesign.cs puts them on KX_AchGameList / KX_AchItemList) ===== -->
                                    <Style x:Key="KX_AchDimBorder" TargetType="Border">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
