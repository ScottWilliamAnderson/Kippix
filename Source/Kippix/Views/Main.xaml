                                                                                                                    <Setter.Value>
                                                                                                                        <DataTemplate>
                                                                                                                            <MediaElement x:Name="KX_TilePreview" Source="{Binding PreviewVideo}" IsMuted="{Binding PreviewMuted}" Volume="0.8"
                                                                                                                                          LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="UniformToFill">
                                                                                                                                <MediaElement.Clip><RectangleGeometry Rect="0,0,312,146" RadiusX="10" RadiusY="10" /></MediaElement.Clip>
                                                                                                                            </MediaElement>
                                                                                                                        </DataTemplate>
                                                                                                                    </Setter.Value>
                                                                                                                </Setter>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </ContentControl.Style>
                                                                                            </ContentControl>
                                                                                            <Border Background="#E62E7D32" CornerRadius="8" Padding="8,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                                                    Visibility="{Binding IsOwned, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                                <TextBlock Text="{DynamicResource LOC_KX_InLibrary}" Style="{StaticResource KX_Text}" FontSize="13" />
                                                                                            </Border>
                                                                                            <Border Width="34" Height="34" CornerRadius="17" Background="#E6111317" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                                                    Visibility="{Binding IsWished, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                                <Path Data="{StaticResource KX_IconHeart}" Style="{StaticResource KX_IconPath}" Fill="#FFF43F5E" Stroke="#FFF43F5E" Width="16" Height="16" />
                                                                                            </Border>
                                                                                        </Grid>
                                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="18" TextTrimming="CharacterEllipsis" Margin="4,8,4,0" />
                                                                                        <StackPanel Orientation="Horizontal" Margin="4,4,4,0" Height="26">
                                                                                            <Border Background="#FF2E7D32" CornerRadius="8" Padding="7,0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                                    Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                                <TextBlock Text="{Binding DiscountText}" Style="{StaticResource KX_Text}" FontSize="14" />
                                                                                            </Border>
                                                                                            <TextBlock Text="{Binding OldPriceText}" Style="{StaticResource KX_TextDim}" FontSize="14" TextDecorations="Strikethrough" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                                       Visibility="{Binding HasOldPrice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                                            <TextBlock Text="{Binding PriceText}" Style="{StaticResource KX_Text}" FontSize="17" VerticalAlignment="Center" />
                                                                                        </StackPanel>
                                                                                        <TextBlock Text="{Binding Note}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="4,3,4,0">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource KX_TextDim}">
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsDropped}" Value="True"><Setter Property="Foreground" Value="#FF4ADE80" /></DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </ButtonEx>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{DynamicResource LOC_KX_Stores}" Style="{StaticResource KX_SectionHeader}" Margin="8,4,0,10" />
                                            <ItemsControl x:Name="KX_StoreTiles" ItemsSource="{PluginSettings Plugin=Kippix, Path=StoreTiles}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="{PluginSettings Plugin=Kippix, Path=StoreTileColumns, FallbackValue=4}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{Binding Command}" Margin="0,0,16,16" Padding="0" Height="176" VerticalAlignment="Top">
                                                            <Grid Height="176" ClipToBounds="True">
                                                                <Border CornerRadius="16" Margin="6" Background="{Binding Brush}" />
                                                                <StackPanel VerticalAlignment="Top" Margin="28,24,24,0">
                                                                    <!-- the store's icon and name -->
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Image Source="{Binding Logo}" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" Margin="0,0,14,0" VerticalAlignment="Center"
                                                                               Visibility="{Binding HasLogo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource KX_TextTitle}" FontSize="30" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="320" />
                                                                    </StackPanel>
                                                                    <!-- browsed here (bag) or opens its website (globe), then what you'll find -->
                                                                    <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
                                                                        <Path Width="22" Height="22" VerticalAlignment="Top" Margin="0,2,12,0" Opacity="0.85">
                                                                            <Path.Style>
                                                                                <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                                                    <Setter Property="Data" Value="{StaticResource KX_IconStore}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsWeb}" Value="True"><Setter Property="Data" Value="{StaticResource KX_IconGlobe}" /></DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Path.Style>
                                                                        </Path>
                                                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource KX_TextSub}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="56" MaxWidth="320"
                                                                                   Visibility="{Binding HasSub, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </ButtonEx>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal" Margin="6,14,0,0">
                                                <ButtonEx Style="{StaticResource KX_PillButton}" Command="{PluginSettings Plugin=Kippix, Path=StoreSearchCommand}" MinWidth="420">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource KX_IconSearch}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" Margin="0,0,12,0" />
                                                        <TextBlock Text="{DynamicResource LOC_KX_StoreSearchAll}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ButtonEx>
                                                <ButtonEx x:Name="KX_StoreWishButton" Style="{StaticResource KX_PillButton}" Command="{PluginSettings Plugin=Kippix, Path=StoreWishlistCommand}" MinWidth="0"
                                                          Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreWishButton, FallbackValue=Collapsed}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource KX_IconHeart}" Style="{StaticResource KX_IconPath}" Width="22" Height="22" Margin="0,0,12,0" />
                                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreWishButtonText}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ButtonEx>
                                                <ButtonEx x:Name="KX_StoreGear" Style="{StaticResource KX_PillButton}" Command="{PluginSettings Plugin=Kippix, Path=StoreSettingsCommand}" MinWidth="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource KX_IconGear}" Style="{StaticResource KX_IconPath}" Width="22" Height="22" Margin="0,0,12,0" />
                                                        <TextBlock Text="{DynamicResource LOC_KX_StoreSettings}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ButtonEx>
                                            </StackPanel>
                                        </StackPanel>
                                        </ScrollViewer>

                                        <!-- a store's games: search, sort, genre, price, sale, then the tiles (more load as you scroll down) -->
                                        <DockPanel Visibility="{PluginSettings Plugin=Kippix, Path=IsStoreList, FallbackValue=Collapsed}">
                                            <ItemsControl x:Name="KX_StoreChips" DockPanel.Dock="Top" ItemsSource="{PluginSettings Plugin=Kippix, Path=StoreChips}" Focusable="False" Margin="6,0,0,14">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ButtonEx Style="{StaticResource KX_ChipButton}" Command="{Binding Command}" Margin="0,0,12,10">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource KX_IconSearch}" Style="{StaticResource KX_IconPath}" Width="18" Height="18" Margin="0,0,10,0"
                                                                      Visibility="{Binding IsSearch, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Path Data="{StaticResource KX_IconCheck}" Width="16" Height="16" Margin="0,0,8,0">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsToggle}" Value="True" />
                                                                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                                                <TextBlock Text=":  " VerticalAlignment="Center" Visibility="{Binding HasValue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <TextBlock Text="{Binding Value}" VerticalAlignment="Center" FontFamily="{DynamicResource FontTitilliumWeb}" Opacity="0.85"
                                                                           Visibility="{Binding HasValue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource KX_AccentBrush}" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                                        <Condition Binding="{Binding IsToggle}" Value="False" />
                                                                                        <Condition Binding="{Binding IsSearch}" Value="False" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                            </StackPanel>
                                                        </ButtonEx>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=StoreSectionTitle}" Style="{StaticResource KX_SectionHeader}" Margin="8,0,0,12" />
                                            <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=StoreStatus}" Style="{StaticResource KX_TextSub}" Margin="8,0,0,12" TextWrapping="Wrap"
                                                       Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreStatus, FallbackValue=Collapsed}" />
                                            <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource LOC_KX_StoreLoadingMore}" Style="{StaticResource KX_TextDim}" Margin="8,6,0,0"
                                                       Visibility="{PluginSettings Plugin=Kippix, Path=StoreLoadingMore, FallbackValue=Collapsed}" />
                                            <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                                                <ItemsControl x:Name="KX_StoreList" ItemsSource="{PluginSettings Plugin=Kippix, Path=StoreItems}" Focusable="False">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{Binding OpenCommand}" Width="428" Height="318" Margin="0,0,12,12" Padding="10">
                                                                <StackPanel>
                                                                    <Grid Width="406" Height="190">
                                                                        <Border CornerRadius="10" Background="#26FFFFFF" />
                                                                        <Path Data="{StaticResource KX_IconStore}" Style="{StaticResource KX_IconPath}" Width="44" Height="44" Opacity="0.25" />
                                                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant">
                                                                            <Image.Clip><RectangleGeometry Rect="0,0,406,190" RadiusX="10" RadiusY="10" /></Image.Clip>
                                                                        </Image>
                                                                        <!-- trailer preview while the tile stays highlighted (Store settings: how long first, sound) -->
                                                                        <ContentControl Content="{Binding}" Focusable="False" IsHitTestVisible="False">
                                                                            <ContentControl.Style>
                                                                                <Style TargetType="ContentControl">
                                                                                    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate /></Setter.Value></Setter>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                                                                            <Setter Property="ContentTemplate">
                                                                                                <Setter.Value>
                                                                                                    <DataTemplate>
                                                                                                        <MediaElement x:Name="KX_TilePreview" Source="{Binding PreviewVideo}" IsMuted="{Binding PreviewMuted}" Volume="0.8"
                                                                                                                      LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="UniformToFill">
                                                                                                            <MediaElement.Clip><RectangleGeometry Rect="0,0,406,190" RadiusX="10" RadiusY="10" /></MediaElement.Clip>
                                                                                                        </MediaElement>
                                                                                                    </DataTemplate>
                                                                                                </Setter.Value>
                                                                                            </Setter>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ContentControl.Style>
                                                                        </ContentControl>
                                                                        <Border Background="#E62E7D32" CornerRadius="8" Padding="8,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                                Visibility="{Binding IsOwned, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <TextBlock Text="{DynamicResource LOC_KX_InLibrary}" Style="{StaticResource KX_Text}" FontSize="13" />
                                                                        </Border>
                                                                        <Border Width="34" Height="34" CornerRadius="17" Background="#E6111317" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                                Visibility="{Binding IsWished, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <Path Data="{StaticResource KX_IconHeart}" Style="{StaticResource KX_IconPath}" Fill="#FFF43F5E" Stroke="#FFF43F5E" Width="16" Height="16" />
                                                                        </Border>
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" TextTrimming="CharacterEllipsis" Margin="4,10,4,0" />
                                                                    <StackPanel Orientation="Horizontal" Margin="4,6,4,0">
                                                                        <Border Background="#FF2E7D32" CornerRadius="8" Padding="8,1" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                                Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <TextBlock Text="{Binding DiscountText}" Style="{StaticResource KX_Text}" FontSize="15" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding OldPriceText}" Style="{StaticResource KX_TextDim}" FontSize="16" TextDecorations="Strikethrough" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                                   Visibility="{Binding HasOldPrice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        <TextBlock Text="{Binding PriceText}" Style="{StaticResource KX_Text}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Note}" FontSize="15" TextTrimming="CharacterEllipsis" Margin="4,4,4,0"
                                                                               Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource KX_TextDim}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsDropped}" Value="True"><Setter Property="Foreground" Value="#FF4ADE80" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </ButtonEx>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>

                                        <!-- one game: picture (or trailer), pictures and trailers, details, every store's price -->
                                        <Grid Visibility="{PluginSettings Plugin=Kippix, Path=IsStoreGame, FallbackValue=Collapsed}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="900" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Margin="6,0,40,0">
                                                <Grid Width="860" Height="402" HorizontalAlignment="Left">
                                                    <Border CornerRadius="14" Background="#26FFFFFF" />
                                                    <Image Source="{PluginSettings Plugin=Kippix, Path=StoreHeroImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant">
                                                        <Image.Clip><RectangleGeometry Rect="0,0,860,402" RadiusX="14" RadiusY="14" /></Image.Clip>
                                                    </Image>
                                                    <MediaElement x:Name="KX_StoreHeroVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" IsHitTestVisible="False"
                                                                  Source="{PluginSettings Plugin=Kippix, Path=StoreHeroVideo}" IsMuted="{PluginSettings Plugin=Kippix, Path=StoreVideoMuted, FallbackValue=False}" Volume="0.8">
                                                        <MediaElement.Clip><RectangleGeometry Rect="0,0,860,402" RadiusX="14" RadiusY="14" /></MediaElement.Clip>
                                                        <MediaElement.Style>
                                                            <Style TargetType="MediaElement">
                                                                <Setter Property="Opacity" Value="0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=ShowStoreHeroVideo}" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MediaElement.Style>
                                                    </MediaElement>
                                                </Grid>
                                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" Margin="-6,12,0,0" Width="872" HorizontalAlignment="Left"
                                                              Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreMedia, FallbackValue=Collapsed}">
                                                    <ItemsControl x:Name="KX_StoreMediaList" ItemsSource="{PluginSettings Plugin=Kippix, Path=StoreMedia}" Focusable="False">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{Binding OpenCommand}" Width="220" Height="136" Padding="6" Margin="0,0,4,0" MinHeight="0">
                                                                    <Grid Width="208" Height="117">
                                                                        <Border CornerRadius="9" Background="#26FFFFFF" />
                                                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant">
                                                                            <Image.Clip><RectangleGeometry Rect="0,0,208,117" RadiusX="9" RadiusY="9" /></Image.Clip>
                                                                        </Image>
                                                                        <Border Width="46" Height="46" CornerRadius="23" Background="#CC111317" BorderBrush="#E6FFFFFF" BorderThickness="1.5"
                                                                                Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <Path Data="{StaticResource KX_IconPlay}" Style="{StaticResource KX_IconPath}" Stroke="White" Fill="White" Width="16" Height="16" Margin="3,0,0,0" />
                                                                        </Border>
                                                                    </Grid>
                                                                </ButtonEx>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                            <!-- reviews: the score, then one review (the next one every 10 seconds; A reads it in full, with the rest) -->
                                            <StackPanel Grid.Row="1" Margin="6,16,40,0" Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreReviewInfo, FallbackValue=Collapsed}">
                                                <TextBlock Text="{DynamicResource LOC_KX_Reviews}" Style="{StaticResource KX_SectionHeader}" Margin="2,0,0,6" />
                                                <StackPanel Orientation="Horizontal" Margin="2,0,0,2">
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreReviewTitle}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="24" Foreground="#FF66C0F4" Margin="0,0,14,0" />
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreReviewLine}" Style="{StaticResource KX_TextSub}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreScores}" Style="{StaticResource KX_TextDim}" Margin="2,0,0,10"
                                                           Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreScores, FallbackValue=Collapsed}" />
                                                <ButtonEx x:Name="KX_StoreReviewCard" Style="{StaticResource KX_MenuButton}" Command="{PluginSettings Plugin=Kippix, Path=StoreReviewOpenCommand}" Padding="18,12" Margin="0"
                                                          Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreCurrentReview, FallbackValue=Collapsed}">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,10,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#CCB83A3A" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=StoreCurrentReview.Positive}" Value="True"><Setter Property="Background" Value="#CC2E7D32" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Path Stroke="White" Width="14" Height="14">
                                                                        <Path.Style>
                                                                            <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                                                <Setter Property="Data" Value="{StaticResource KX_IconClose}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=StoreCurrentReview.Positive}" Value="True"><Setter Property="Data" Value="{StaticResource KX_IconCheck}" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Path.Style>
                                                                    </Path>
                                                                </Border>
                                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreCurrentReview.Verdict}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreCurrentReview.Meta}" Style="{StaticResource KX_TextDim}" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{PluginSettings Plugin=Kippix, Path=StoreReviewCounter}" Style="{StaticResource KX_TextDim}" FontSize="15" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=StoreCurrentReview.Text}" Style="{StaticResource KX_TextSub}" FontSize="17" TextWrapping="Wrap" MaxHeight="76" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Opacity="0.75">
                                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptA}" Width="20" Height="20" Focusable="False" />
                                                            <TextBlock Text="{DynamicResource LOC_KX_ReviewReadAll}" Style="{StaticResource KX_TextDim}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ButtonEx>
                                            </StackPanel>
                                            <!-- right: name, facts, badges, prices (two columns), lowest / highest, buttons (a grid, so Up / Down / Left / Right go where they look), description -->
                                            <DockPanel Grid.Column="1" Grid.RowSpan="2">
                                                <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=StoreGame.Name}" Style="{StaticResource KX_TextTitle}" FontSize="40" TextWrapping="Wrap" MaxHeight="104" TextTrimming="CharacterEllipsis" />
                                                <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=StoreGameFacts}" Style="{StaticResource KX_TextSub}" TextWrapping="Wrap" MaxHeight="62" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{PluginSettings Plugin=Kippix, Path=StoreBadges}" Focusable="False" Margin="0,10,0,0"
                                                              Visibility="{PluginSettings Plugin=Kippix, Path=HasStoreBadges, FallbackValue=Collapsed}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="12" Padding="11,3" Margin="0,0,8,6" BorderThickness="1">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#22FFFFFF" />
                                                                        <Setter Property="BorderBrush" Value="#44FFFFFF" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                                                <Setter Property="Background" Value="#332E7D32" />
                                                                                <Setter Property="BorderBrush" Value="#664ADE80" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Path Data="{StaticResource KX_IconCheck}" Style="{StaticResource KX_IconPath}" Stroke="#FF4ADE80" Width="14" Height="14" Margin="0,0,7,0"
                                                                          Visibility="{Binding IsOwned, Converter={StaticResource BooleanToVisibilityConverter}}" />
