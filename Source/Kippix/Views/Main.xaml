                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ButtonEx Command="{Binding Command}" FocusVisualStyle="{x:Null}" Margin="0,-6,20,20" Width="180">
                                                            <ButtonEx.Template>
                                                                <ControlTemplate TargetType="ButtonEx">
                                                                    <Border Padding="0,6,0,0">
                                                                    <StackPanel>
                                                                        <Grid Width="180" Height="270">
                                                                            <Border CornerRadius="10" Background="#FF1E2229" />
