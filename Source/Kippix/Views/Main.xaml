                                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchDetailTierName}" Foreground="{PluginSettings Plugin=Kippix, Path=AchDetailTierBrush}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="18" Margin="16,0,0,0" />
                                                            </StackPanel>
