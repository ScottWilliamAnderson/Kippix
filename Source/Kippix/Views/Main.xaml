                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.5" /></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ButtonEx.Template>
                                                        </ButtonEx>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- ========== (0.99.24) the profile's Overview shelves (ThemeApi.ProfileShelves.cs): your newest captures, achievements, the wishlist ========== -->
                                            <!-- RECENT CAPTURES -->
                                            <StackPanel Orientation="Horizontal" Margin="2,10,0,14" Visibility="{PluginSettings Plugin=Kippix, Path=HasHubShots, FallbackValue=Collapsed}">
                                                <Border Width="4" Height="20" CornerRadius="2" Background="{DynamicResource KX_AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=HubShotsTitle}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="17" Opacity="0.85" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ItemsControl x:Name="KX_HubShotList" ItemsSource="{PluginSettings Plugin=Kippix, Path=HubShots}" Focusable="False" Margin="0,0,0,26"
                                                          Visibility="{PluginSettings Plugin=Kippix, Path=HasHubShots, FallbackValue=Collapsed}">
                                                <ItemsControl.Template>
                                                    <ControlTemplate TargetType="ItemsControl">
                                                        <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Margin="-20,-18,-20,-8">
                                                            <Border Padding="20,18,20,8"><ItemsPresenter /></Border>
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ButtonEx Command="{Binding Command}" FocusVisualStyle="{x:Null}" Foreground="{DynamicResource KX_TextBrush}" Margin="0,0,20,0" Width="352" RenderTransformOrigin="0.5,0.5">
                                                            <ButtonEx.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></ButtonEx.RenderTransform>
                                                            <ButtonEx.Template>
                                                                <ControlTemplate TargetType="ButtonEx">
                                                                    <Grid Width="352" Height="198" Background="Transparent">
                                                                        <Border CornerRadius="14" Background="#FF1A1D23" />
                                                                        <Border CornerRadius="14"><Border.Background><ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" /></Border.Background></Border>
                                                                        <!-- the game and when, over a shade along the bottom -->
                                                                        <Border x:Name="Shade" CornerRadius="0,0,14,14" VerticalAlignment="Bottom" Height="92" IsHitTestVisible="False">
                                                                            <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                    <GradientStop Color="#00000000" Offset="0" />
                                                                                    <GradientStop Color="#D9000000" Offset="1" />
                                                                                </LinearGradientBrush>
                                                                            </Border.Background>
                                                                        </Border>
                                                                        <StackPanel x:Name="Words" VerticalAlignment="Bottom" Margin="16,0,16,12">
                                                                            <TextBlock Text="{Binding Caption}" Style="{StaticResource KX_Text}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding SubText}" Style="{StaticResource KX_TextSub}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <!-- a clip: play mark and its length -->
                                                                        <Grid x:Name="PlayMark" Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,26" Visibility="Collapsed" IsHitTestVisible="False">
                                                                            <Ellipse Fill="#99000000" Stroke="#66FFFFFF" StrokeThickness="1.5" />
                                                                            <Path Data="{StaticResource KX_IconPlay}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" Margin="4,0,0,0" Stroke="White" Fill="White" />
                                                                        </Grid>
                                                                        <Border CornerRadius="8" Background="#CC000000" Padding="8,2" Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                                Visibility="{Binding HasLength, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <TextBlock Text="{Binding LengthText}" Style="{StaticResource KX_Text}" FontSize="13" />
                                                                        </Border>
                                                                        <!-- the last card: open the gallery -->
                                                                        <Grid x:Name="More" Visibility="Collapsed">
                                                                            <Border CornerRadius="14" Background="#FF14161B" BorderBrush="#22FFFFFF" BorderThickness="1" />
                                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                                <Path Data="{StaticResource KX_IconGallery}" Style="{StaticResource KX_IconPath}" Width="40" Height="40" />
                                                                                <TextBlock Text="{Binding MoreText}" Style="{StaticResource KX_Text}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                        <Border x:Name="Ring" CornerRadius="17" Margin="-5" BorderThickness="3" BorderBrush="{DynamicResource KX_AccentBrush}" Opacity="0" IsHitTestVisible="False">
                                                                            <Border.Effect><DropShadowEffect Color="White" BlurRadius="20" ShadowDepth="0" Opacity="0.45" /></Border.Effect>
                                                                        </Border>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter TargetName="PlayMark" Property="Visibility" Value="Visible" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsMore}" Value="True">
                                                                            <Setter TargetName="More" Property="Visibility" Value="Visible" />
                                                                            <Setter TargetName="Shade" Property="Visibility" Value="Collapsed" />
                                                                            <Setter TargetName="Words" Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.5" /></Trigger>
                                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.04" Duration="0:0:0.18" />
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.04" Duration="0:0:0.18" />
                                                                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.18" />
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.18" />
                                                                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ButtonEx.Template>
                                                        </ButtonEx>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- RECENT ACHIEVEMENTS -->
                                            <StackPanel Orientation="Horizontal" Margin="2,10,0,14" Visibility="{PluginSettings Plugin=Kippix, Path=HasHubAchs, FallbackValue=Collapsed}">
                                                <Border Width="4" Height="20" CornerRadius="2" Background="{DynamicResource KX_AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
