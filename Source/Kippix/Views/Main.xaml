                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource KX_TextSub}" FontSize="15" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding RarityText}" Style="{StaticResource KX_TextDim}" FontSize="13" HorizontalAlignment="Right"
                                                               Visibility="{Binding HasRarity, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </ButtonEx>
                                    </DataTemplate>

                                </Border.Resources>
                                <Grid ClipToBounds="True">
                                <!-- Background › Game background: the highlighted game's picture (set from the helper, faded in over the last one), dimmed so the text stays easy to read -->
                                <Image x:Name="KX_AchBgBack" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0" />
                                <Image x:Name="KX_AchBgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0" />
                                <Rectangle IsHitTestVisible="False" Visibility="{PluginSettings Plugin=Kippix, Path=IsAchGameBg, FallbackValue=Collapsed}">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#C40A0B0E" Offset="0" />
                                            <GradientStop Color="#D20A0B0E" Offset="0.45" />
                                            <GradientStop Color="#EB0A0B0E" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Grid Margin="{PluginSettings Plugin=Kippix, Path=AchPageMargin, FallbackValue='80,56,80,36'}">

                                    <!-- ===== all games ===== -->
                                    <DockPanel Visibility="{PluginSettings Plugin=Kippix, Path=IsAchGamesPage, FallbackValue=Visible}">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4" HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=AchHeaderAlignment, FallbackValue=Left}" Tag="KX_AchTidy093">
                                            <Path Data="{StaticResource KX_IconTrophy}" Style="{StaticResource KX_IconPath}" Stroke="{DynamicResource KX_TextBrush}" Width="40" Height="40" Margin="0,0,16,0" />
                                            <TextBlock Text="{DynamicResource LOC_KX_Achievements}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="46" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=AchSummaryText}" Style="{StaticResource KX_TextSub}" Margin="0,0,0,14" HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=AchHeaderAlignment, FallbackValue=Left}"
                                                   Visibility="{PluginSettings Plugin=Kippix, Path=ShowAchSummaryLine, FallbackValue=Visible}" />
                                        <!-- (0.89) Layout › Showcase, Trophy rings: the big numbers -->
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,6,0,20" HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=AchHeaderAlignment, FallbackValue=Left}"
                                                    Visibility="{PluginSettings Plugin=Kippix, Path=IsAchHeroStats, FallbackValue=Collapsed}">
                                            <Border CornerRadius="18" Background="#14FFFFFF" BorderBrush="#409300C5" BorderThickness="1" Padding="26,10,30,12" Margin="7,0,7,0" MinWidth="190">
                                                <StackPanel>
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchStatUnlocked}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="42" />
                                                    <TextBlock Text="{DynamicResource LOC_KX_AchStatUnlocked}" Style="{StaticResource KX_TextDim}" FontSize="15" Margin="0,-4,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="18" Background="#14FFFFFF" BorderBrush="#409300C5" BorderThickness="1" Padding="26,10,30,12" Margin="7,0,7,0" MinWidth="190">
                                                <StackPanel>
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchStatPercent}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="42" Foreground="{StaticResource KX_AchKBrush}" />
                                                    <TextBlock Text="{DynamicResource LOC_KX_AchStatPercent}" Style="{StaticResource KX_TextDim}" FontSize="15" Margin="0,-4,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="18" Background="#14FFFFFF" BorderBrush="#409300C5" BorderThickness="1" Padding="26,10,30,12" Margin="7,0,7,0" MinWidth="190">
                                                <StackPanel>
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchStatPerfect}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="42" Foreground="#FFFBBF24" />
                                                    <TextBlock Text="{DynamicResource LOC_KX_AchStatPerfect}" Style="{StaticResource KX_TextDim}" FontSize="15" Margin="0,-4,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="18" Background="#14FFFFFF" BorderBrush="#409300C5" BorderThickness="1" Padding="26,10,30,12" Margin="7,0,7,0" MinWidth="190">
                                                <StackPanel>
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchStatGames}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="42" />
                                                    <TextBlock Text="{DynamicResource LOC_KX_AchStatGames}" Style="{StaticResource KX_TextDim}" FontSize="15" Margin="0,-4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <!-- unlocked per rarity tier, with a score (or level) beside it -->
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,22" HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=AchHeaderAlignment, FallbackValue=Left}"
                                                    Visibility="{PluginSettings Plugin=Kippix, Path=HasAchTiers, FallbackValue=Collapsed}">
                                            <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=AchTiers}" Focusable="False" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="14" Background="#1AFFFFFF" Padding="12,6,16,6" Margin="5,0,5,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource KX_IconTrophy}" Stroke="{Binding Color}" StrokeThickness="2" Stretch="Uniform" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Count}" Style="{StaticResource KX_Text}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource KX_TextDim}" FontSize="16" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border CornerRadius="14" Background="#26FFFFFF" Padding="16,6" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{PluginSettings Plugin=Kippix, Path=ShowAchScore, FallbackValue=Collapsed}">
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchScoreText}" Style="{StaticResource KX_Text}" FontSize="19" FontWeight="SemiBold" />
                                            </Border>
                                            <Border CornerRadius="14" Background="#26FFFFFF" Padding="16,6" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{PluginSettings Plugin=Kippix, Path=ShowAchLevel, FallbackValue=Collapsed}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchLevelText}" Style="{StaticResource KX_Text}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Grid Width="180" Height="6" HorizontalAlignment="Left">
                                                            <Border CornerRadius="3" Background="#33FFFFFF" />
                                                            <Border CornerRadius="3" Background="{DynamicResource KX_AccentBrush}" HorizontalAlignment="Left" Width="{PluginSettings Plugin=Kippix, Path=AchLevelBarWidth, FallbackValue=4}" />
                                                        </Grid>
                                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchLevelNextText}" Style="{StaticResource KX_TextDim}" FontSize="13" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- search / sort / filter (drawn above the cards so the dropdowns overlap them) -->
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,22" Panel.ZIndex="10" HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=AchHeaderAlignment, FallbackValue=Left}">
                                            <ButtonEx Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=AchSearchCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource KX_IconSearch}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" Margin="0,0,10,0" />
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchSearchText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ButtonEx>
                                            <ButtonEx Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=AchClearSearchCommand}"
                                                      Visibility="{PluginSettings Plugin=Kippix, Path=HasAchSearch, FallbackValue=Collapsed}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource KX_IconClose}" Style="{StaticResource KX_IconPath}" Width="18" Height="18" Margin="0,0,10,0" />
                                                    <TextBlock Text="{DynamicResource LOC_KX_ClearSearch}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ButtonEx>

                                            <!-- sort: chip + dropdown -->
                                            <Grid>
                                                <ButtonEx x:Name="KX_AchSortChip" Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=AchSortCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource KX_IconSort}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" Margin="0,0,10,0" />
                                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchSortText}" VerticalAlignment="Center" />
                                                        <Path Style="{StaticResource KX_ChipChevron}" />
                                                    </StackPanel>
                                                </ButtonEx>
                                                <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                    <Border Canvas.Top="6" Style="{StaticResource KX_Dropdown}"
                                                            Visibility="{PluginSettings Plugin=Kippix, Path=IsAchSortPickerOpen, FallbackValue=Collapsed}">
                                                        <ItemsControl x:Name="KX_AchSortPicker" Focusable="False"
                                                                      ItemsSource="{PluginSettings Plugin=Kippix, Path=AchPickerOptions}"
                                                                      ItemTemplate="{StaticResource KX_PickOptionTemplate}" />
                                                    </Border>
                                                </Canvas>
                                            </Grid>

                                            <!-- filter: chip + dropdown -->
                                            <Grid>
                                                <ButtonEx x:Name="KX_AchFilterChip" Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=AchFilterCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource KX_IconFilter}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" Margin="0,0,10,0" />
                                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchFilterText}" VerticalAlignment="Center" />
                                                        <Path Style="{StaticResource KX_ChipChevron}" />
                                                    </StackPanel>
                                                </ButtonEx>
                                                <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                    <Border Canvas.Top="6" Style="{StaticResource KX_Dropdown}"
                                                            Visibility="{PluginSettings Plugin=Kippix, Path=IsAchFilterPickerOpen, FallbackValue=Collapsed}">
                                                        <ItemsControl x:Name="KX_AchFilterPicker" Focusable="False"
                                                                      ItemsSource="{PluginSettings Plugin=Kippix, Path=AchPickerOptions}"
                                                                      ItemTemplate="{StaticResource KX_PickOptionTemplate}" />
                                                    </Border>
                                                </Canvas>
                                            </Grid>
                                            <!-- achievements settings: background + layout -->
                                            <Grid>
                                                <ButtonEx x:Name="KX_AchSettingsChip" Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=AchSettingsCommand}" ToolTip="{DynamicResource LOC_KX_AchSettings}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource KX_IconTune}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" />
                                                        <Path Style="{StaticResource KX_ChipChevron}" />
                                                    </StackPanel>
                                                </ButtonEx>
                                                <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                    <Border Canvas.Top="6" Style="{StaticResource KX_Dropdown}" MinWidth="400"
                                                            Visibility="{PluginSettings Plugin=Kippix, Path=IsAchSettingsPickerOpen, FallbackValue=Collapsed}">
                                                        <ItemsControl x:Name="KX_AchSettingsPicker" Focusable="False"
                                                                      ItemsSource="{PluginSettings Plugin=Kippix, Path=AchPickerOptions}"
                                                                      ItemTemplate="{StaticResource KX_PickOptionTemplate}" />
                                                    </Border>
                                                </Canvas>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0" Opacity="0.75" HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=AchHeaderAlignment, FallbackValue=Left}">
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptA}" Width="24" Height="24" Focusable="False" />
                                            <TextBlock Text="{DynamicResource LOC_KX_OpenGame}" Style="{StaticResource KX_TextDim}" Margin="8,0,24,0" VerticalAlignment="Center" />
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptY}" Width="24" Height="24" Focusable="False" />
                                            <TextBlock Text="{DynamicResource LOC_KX_Search}" Style="{StaticResource KX_TextDim}" Margin="8,0,24,0" VerticalAlignment="Center" />
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Width="24" Height="24" Focusable="False" />
                                            <TextBlock Text="{DynamicResource LOC_KX_Back}" Style="{StaticResource KX_TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOC_KX_Loading}" Style="{StaticResource KX_TextSub}" Margin="12,0,0,12"
                                                   Visibility="{PluginSettings Plugin=Kippix, Path=AchLoading, FallbackValue=Collapsed}" HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=AchHeaderAlignment, FallbackValue=Left}" />
                                        <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=AchEmptyText}" Style="{StaticResource KX_TextSub}" Margin="12,0,0,12" TextWrapping="Wrap"
                                                   Visibility="{PluginSettings Plugin=Kippix, Path=HasAchEmptyText, FallbackValue=Collapsed}" HorizontalAlignment="{PluginSettings Plugin=Kippix, Path=AchHeaderAlignment, FallbackValue=Left}" />

                                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                                            <ItemsControl x:Name="KX_AchGameList" ItemsSource="{PluginSettings Plugin=Kippix, Path=AchGames}" Focusable="False" HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <!-- (0.94) the page's layout picks the card: Classic (0) or a design (1-4); a binding, so changing it redraws every card -->
                                                    <DataTemplate>
                                                        <ContentControl Content="{Binding}" Focusable="False" IsTabStop="False">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource KX_AchGameTpl0}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=AchGameDesignNow}" Value="1"><Setter Property="ContentTemplate" Value="{StaticResource KX_AchGameTpl1}" /></DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=AchGameDesignNow}" Value="2"><Setter Property="ContentTemplate" Value="{StaticResource KX_AchGameTpl2}" /></DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=AchGameDesignNow}" Value="3"><Setter Property="ContentTemplate" Value="{StaticResource KX_AchGameTpl3}" /></DataTrigger>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=Kippix, Path=AchGameDesignNow}" Value="4"><Setter Property="ContentTemplate" Value="{StaticResource KX_AchGameTpl4}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>

                                    <!-- ===== one game ===== -->
                                    <DockPanel Visibility="{PluginSettings Plugin=Kippix, Path=IsAchGamePage, FallbackValue=Collapsed}">
                                        <!-- (0.93) header: the cover, the name and numbers (centred on the screen: a spacer as wide as the cover on the other
                                             side), then NEXT UP and the chips, each centred -->
                                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18" Panel.ZIndex="10" HorizontalAlignment="Center" Tag="KX_AchHeadV3">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="10" Background="#26FFFFFF" Width="96" Height="128" HorizontalAlignment="Right" />
                                            <Grid Width="96" Height="128" HorizontalAlignment="Right">
                                                <Grid.Clip>
                                                    <RectangleGeometry Rect="0,0,96,128" RadiusX="10" RadiusY="10" />
                                                </Grid.Clip>
                                                <Image Source="{PluginSettings Plugin=Kippix, Path=AchGameCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="28,0,28,0" VerticalAlignment="Center" MinWidth="520" MaxWidth="1100">
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchGameCountText}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="26" Margin="0,0,0,10" HorizontalAlignment="Center" TextAlignment="Center" />
                                                <!-- this game's unlocked achievements per rarity tier -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Center" Visibility="{PluginSettings Plugin=Kippix, Path=HasAchGameTiers, FallbackValue=Collapsed}">
                                                    <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=AchGameTiers}" Focusable="False" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="12" Background="#1AFFFFFF" Padding="10,4,14,4" Margin="4,0,4,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Path Data="{StaticResource KX_IconTrophy}" Stroke="{Binding Color}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Count}" Style="{StaticResource KX_Text}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource KX_TextDim}" FontSize="15" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border CornerRadius="12" Background="#26FFFFFF" Padding="14,4" Margin="4,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{PluginSettings Plugin=Kippix, Path=ShowAchGameScore, FallbackValue=Collapsed}">
                                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchGameScoreText}" Style="{StaticResource KX_Text}" FontSize="17" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <Grid Width="520" Height="8" HorizontalAlignment="Center" Visibility="{PluginSettings Plugin=Kippix, Path=ShowAchGameBar, FallbackValue=Visible}">
                                                    <Border CornerRadius="4" Background="#33FFFFFF" />
                                                    <Border CornerRadius="4" HorizontalAlignment="Left" Background="{DynamicResource KX_AccentBrush}"
                                                            Width="{PluginSettings Plugin=Kippix, Path=AchGameProgressWidth, FallbackValue=0}" />
                                                </Grid>
                                            </StackPanel>
                                            <!-- (0.89) Layout: a ring (Trophy rings) or a big % (Showcase) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{PluginSettings Plugin=Kippix, Path=IsAchGameDesignStat, FallbackValue=Collapsed}">
                                                <Grid Width="88" Height="88" Visibility="{PluginSettings Plugin=Kippix, Path=IsAchGameRingShown, FallbackValue=Collapsed}">
                                                    <Ellipse Stroke="#26FFFFFF" StrokeThickness="8" />
                                                    <Path Data="{PluginSettings Plugin=Kippix, Path=AchGameRing}" Stroke="{DynamicResource KX_AccentBrush}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchGamePercentText}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchGamePercentText}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="58" Foreground="{StaticResource KX_AchKBrush}"
                                                           Visibility="{PluginSettings Plugin=Kippix, Path=IsAchGameBigPercent, FallbackValue=Collapsed}" />
                                            </StackPanel>

                                        </Grid>
                                                <!-- NEXT UP: the locked achievements you're closest to (ThemeApi.NextUp.cs; A opens one) -->
                                                <StackPanel Margin="0,18,0,0" HorizontalAlignment="Center" Visibility="{PluginSettings Plugin=Kippix, Path=HasAchNextUp, FallbackValue=Collapsed}">
                                                    <TextBlock Text="{DynamicResource LOC_KX_NextUpHeader}" Style="{StaticResource KX_SectionHeader}" Margin="0,0,0,8" HorizontalAlignment="Center" />
                                                    <ItemsControl x:Name="KX_AchNextList" ItemsSource="{PluginSettings Plugin=Kippix, Path=AchNextUp}" Focusable="False" HorizontalAlignment="Center">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{Binding Command}" Width="250" MinHeight="0" Margin="0,0,10,0" Padding="10,8">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="44" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Width="40" Height="40" CornerRadius="8" Background="#26FFFFFF" VerticalAlignment="Center">
                                                                            <Border.Clip><RectangleGeometry Rect="0,0,40,40" RadiusX="8" RadiusY="8" /></Border.Clip>
                                                                            <Image Source="{Binding Row.Icon}" Stretch="UniformToFill" Opacity="0.8" RenderOptions.BitmapScalingMode="Fant" />
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource KX_Text}" FontSize="16" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource KX_TextDim}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                            <Grid Width="170" Height="4" Margin="0,5,0,0" HorizontalAlignment="Left" Visibility="{Binding HasFill, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <Border CornerRadius="2" Background="#33FFFFFF" />
                                                                                <Border CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource KX_AccentBrush}" Width="{Binding Fill}" />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </ButtonEx>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Center">
                                                    <Grid>
                                                        <ButtonEx x:Name="KX_AchItemsChip" Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=AchItemFilterCommand}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource KX_IconFilter}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" Margin="0,0,10,0" />
                                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=AchItemFilterText}" VerticalAlignment="Center" />
                                                                <Path Style="{StaticResource KX_ChipChevron}" />
                                                            </StackPanel>
                                                        </ButtonEx>
                                                        <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <Border Canvas.Top="6" Style="{StaticResource KX_Dropdown}"
                                                                    Visibility="{PluginSettings Plugin=Kippix, Path=IsAchItemsPickerOpen, FallbackValue=Collapsed}">
                                                                <ItemsControl x:Name="KX_AchItemsPicker" Focusable="False"
                                                                              ItemsSource="{PluginSettings Plugin=Kippix, Path=AchPickerOptions}"
                                                                              ItemTemplate="{StaticResource KX_PickOptionTemplate}" />
                                                            </Border>
                                                        </Canvas>
                                                    </Grid>
                                                    <!-- achievements settings: background + layout -->
                                                    <Grid>
                                                        <ButtonEx x:Name="KX_AchSettingsChip2" Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=AchSettingsCommand}" ToolTip="{DynamicResource LOC_KX_AchSettings}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource KX_IconTune}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" />
                                                                <Path Style="{StaticResource KX_ChipChevron}" />
                                                            </StackPanel>
                                                        </ButtonEx>
                                                        <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <Border Canvas.Top="6" Style="{StaticResource KX_Dropdown}" MinWidth="400"
                                                                    Visibility="{PluginSettings Plugin=Kippix, Path=IsAchSettingsPicker2Open, FallbackValue=Collapsed}">
