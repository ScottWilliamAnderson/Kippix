                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Wide}" Value="True">
                                                                <Setter TargetName="Pic" Property="Width" Value="150" />
                                                                <Setter TargetName="Pic" Property="Height" Value="70" />
                                                                <Setter TargetName="Pic" Property="CornerRadius" Value="10" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="IconBadge" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Icon}" Value=""><Setter TargetName="IconBadge" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#16FFFFFF" /></Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                                <Setter TargetName="Card" Property="Background" Value="#1EFFFFFF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ButtonEx.Template>
                                            </ButtonEx>
                                        </Grid>
                                    </DataTemplate>

                                    <!-- covers: one shelf you move along (the scroller has room inside for the highlight's glow and growth) -->
                                    <ItemsPanelTemplate x:Key="KX_HubTilePanel"><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    <ControlTemplate x:Key="KX_HubTileShell" TargetType="ItemsControl">
                                        <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Margin="-20,-18,-20,-8">
                                            <Border Padding="20,18,20,8"><ItemsPresenter /></Border>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                    <DataTemplate x:Key="KX_HubTileItemTemplate">
                                        <ButtonEx Command="{Binding Command}" FocusVisualStyle="{x:Null}" Foreground="{DynamicResource KX_TextBrush}" Margin="0,0,22,0" Width="184" RenderTransformOrigin="0.5,0.42">
                                            <ButtonEx.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></ButtonEx.RenderTransform>
                                            <ButtonEx.Template>
                                                <ControlTemplate TargetType="ButtonEx">
                                                    <StackPanel Background="Transparent">
                                                        <Grid Width="184" Height="276">
                                                            <Border CornerRadius="14" Background="#FF1A1D23" />
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource KX_Text}" FontSize="17" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12" />
                                                            <Border CornerRadius="14"><Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" /></Border.Background></Border>
                                                            <Border CornerRadius="14" BorderBrush="#1AFFFFFF" BorderThickness="1" />
                                                            <Border x:Name="Ring" CornerRadius="17" Margin="-5" BorderThickness="3" BorderBrush="{DynamicResource KX_AccentBrush}" Opacity="0" IsHitTestVisible="False">
                                                                <Border.Effect><DropShadowEffect Color="White" BlurRadius="20" ShadowDepth="0" Opacity="0.45" /></Border.Effect>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock x:Name="TileName" Text="{Binding Name}" Style="{StaticResource KX_Text}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,12,2,0" Opacity="0.85" />
                                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource KX_TextDim}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="2,1,2,0" />
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.5" /></Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                            <Setter TargetName="TileName" Property="Opacity" Value="1" />
                                                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.18" />
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.18" />
                                                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.18" />
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.18" />
                                                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ButtonEx.Template>
                                        </ButtonEx>
                                    </DataTemplate>
                                </Border.Resources>
                                <Grid>
                                <!-- the profile: a plain black page -->
                                <Rectangle Fill="Black" IsHitTestVisible="False" Visibility="{PluginSettings Plugin=Kippix, Path=IsProfileHub, FallbackValue=Collapsed}" />
                                <!-- the art of the game you played last, faint behind the profile and faded into the black (0.99.24: every tab, the card has it too) -->
                                <Grid VerticalAlignment="Top" Height="760" IsHitTestVisible="False" Visibility="{PluginSettings Plugin=Kippix, Path=HasHubBanner, FallbackValue=Collapsed}">
                                    <Image Source="{PluginSettings Plugin=Kippix, Path=HubBanner}" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0.13" />
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#66000000" Offset="0" />
                                                <GradientStop Color="#FF000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#CC000000" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="0.6" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                                <DockPanel Margin="{PluginSettings Plugin=Kippix, Path=PagesMargin, FallbackValue='120,60,120,28'}">
                                    <!-- ========== (0.99.24) THE PROFILE CARD, on the left of every profile tab: the last game's art, your picture, name, what kind of
                                         profile it is, what you played last, your numbers, then the tabs as a list (A on one, or LB / RB) ========== -->
                                    <Border DockPanel.Dock="Left" Width="372" Margin="0,0,44,0" CornerRadius="28" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                            Visibility="{PluginSettings Plugin=Kippix, Path=IsProfileHub, FallbackValue=Collapsed}">
                                        <Grid>
                                            <!-- the art across the top of the card, fading out downwards (clipped to the card's round corners) -->
                                            <Image Source="{PluginSettings Plugin=Kippix, Path=HubBanner}" Stretch="UniformToFill" VerticalAlignment="Top" Height="210" Opacity="0.75" IsHitTestVisible="False"
                                                   Visibility="{PluginSettings Plugin=Kippix, Path=HasHubBanner, FallbackValue=Collapsed}">
                                                <Image.Clip><RectangleGeometry Rect="0,0,370,210" RadiusX="27" RadiusY="27" /></Image.Clip>
                                                <Image.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FF000000" Offset="0" />
                                                        <GradientStop Color="#99000000" Offset="0.55" />
                                                        <GradientStop Color="#00000000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Image.OpacityMask>
                                            </Image>
                                            <DockPanel Margin="26,0,26,22">
                                                <StackPanel DockPanel.Dock="Top">
                                                    <!-- your picture, over the art -->
                                                    <Grid Width="116" Height="116" Margin="0,92,0,0" HorizontalAlignment="Center">
                                                        <Ellipse Margin="-7" Stroke="{DynamicResource KX_AccentBrush}" StrokeThickness="3">
                                                            <Ellipse.Effect><DropShadowEffect Color="White" BlurRadius="22" ShadowDepth="0" Opacity="0.35" /></Ellipse.Effect>
                                                        </Ellipse>
                                                        <Ellipse Fill="#FF1A1D23" />
                                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ProfileInitial}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{PluginSettings Plugin=Kippix, Path=ProfilePicture}" Stretch="UniformToFill" Width="116" Height="116" Visibility="{PluginSettings Plugin=Kippix, Path=HasProfilePicture, FallbackValue=Collapsed}">
                                                            <Image.Clip><EllipseGeometry Center="58,58" RadiusX="58" RadiusY="58" /></Image.Clip>
                                                        </Image>
                                                    </Grid>
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=ProfileName}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="36"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,14,0,0" />
                                                    <TextBlock Text="{PluginSettings Plugin=Kippix, Path=HubKindText}" Style="{StaticResource KX_TextDim}" FontSize="16" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,-2,0,0" />
                                                    <!-- what you played last / are playing now -->
                                                    <Border CornerRadius="16" Background="#14FFFFFF" Padding="14,7" Margin="0,14,0,0" HorizontalAlignment="Center" MaxWidth="318"
                                                            Visibility="{PluginSettings Plugin=Kippix, Path=HasHubNow, FallbackValue=Collapsed}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource KX_IconPlay}" Style="{StaticResource KX_IconPath}" Width="13" Height="13" Margin="0,0,9,0" Stroke="{DynamicResource KX_AccentBrush}" Fill="{DynamicResource KX_AccentBrush}" />
                                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=HubNowText}" Style="{StaticResource KX_TextSub}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- your numbers -->
                                                    <ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=HubStats}" Focusable="False" Margin="0,18,0,0"
                                                                  Visibility="{PluginSettings Plugin=Kippix, Path=HasHubStats, FallbackValue=Collapsed}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="4,0,4,0" Height="32">
                                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource KX_TextDim}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,90,0" />
                                                                    <TextBlock Text="{Binding Value}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border Height="1" Background="#14FFFFFF" Margin="4,14,4,12" />
                                                </StackPanel>
                                                <!-- the tabs -->
                                                <ItemsControl x:Name="KX_HubTabList" ItemsSource="{PluginSettings Plugin=Kippix, Path=HubTabs}" Focusable="False" VerticalAlignment="Top">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ButtonEx Command="{Binding Command}" FocusVisualStyle="{x:Null}" Foreground="{DynamicResource KX_TextBrush}" Height="46" Margin="0,1">
                                                                <ButtonEx.Template>
                                                                    <ControlTemplate TargetType="ButtonEx">
                                                                        <Grid Background="Transparent">
                                                                            <Border x:Name="Pill" CornerRadius="14" Background="Transparent" BorderThickness="2" BorderBrush="Transparent" />
                                                                            <Border x:Name="TabBar" Width="4" Height="22" CornerRadius="2" HorizontalAlignment="Left" Margin="8,0,0,0" Background="{DynamicResource KX_AccentBrush}" Opacity="0" />
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,12,0">
                                                                                <Path x:Name="TabIcon" Width="20" Height="20" Margin="0,0,14,0" Opacity="0.55">
                                                                                    <Path.Style>
                                                                                        <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Icon}" Value="profile"><Setter Property="Data" Value="{StaticResource KX_IconProfile}" /></DataTrigger>
                                                                                                <DataTrigger Binding="{Binding Icon}" Value="grid"><Setter Property="Data" Value="{StaticResource KX_IconGrid}" /></DataTrigger>
                                                                                                <DataTrigger Binding="{Binding Icon}" Value="friends"><Setter Property="Data" Value="{StaticResource KX_IconFriends}" /></DataTrigger>
                                                                                                <DataTrigger Binding="{Binding Icon}" Value="heart"><Setter Property="Data" Value="{StaticResource KX_IconHeart}" /></DataTrigger>
                                                                                                <DataTrigger Binding="{Binding Icon}" Value="shelf"><Setter Property="Data" Value="{StaticResource KX_IconShelf}" /></DataTrigger>
                                                                                                <DataTrigger Binding="{Binding Icon}" Value="chart"><Setter Property="Data" Value="{StaticResource KX_IconChart}" /></DataTrigger>
                                                                                                <DataTrigger Binding="{Binding Icon}" Value="forward"><Setter Property="Data" Value="{StaticResource KX_IconForward}" /></DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Path.Style>
                                                                                </Path>
                                                                                <TextBlock x:Name="TabText" Text="{Binding Text}" Style="{StaticResource KX_TextDim}" FontSize="18" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter TargetName="Pill" Property="Background" Value="#1CFFFFFF" />
                                                                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource KX_TextBrush}" />
                                                                                <Setter TargetName="TabText" Property="FontFamily" Value="{DynamicResource FontTitilliumWebBold}" />
                                                                                <Setter TargetName="TabIcon" Property="Opacity" Value="1" />
                                                                                <Setter TargetName="TabBar" Property="Opacity" Value="1" />
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="#33FFFFFF" /></Trigger>
                                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource KX_AccentBrush}" />
                                                                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource KX_TextBrush}" />
                                                                                <Setter TargetName="TabIcon" Property="Opacity" Value="1" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </ButtonEx.Template>
                                                            </ButtonEx>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <!-- (0.99.24) the profile tab's own heading, right of the card: its name, what it shows, and LT / RT for another month / year -->
                                    <Grid DockPanel.Dock="Top" Margin="2,6,0,22" Visibility="{PluginSettings Plugin=Kippix, Path=IsProfileHub, FallbackValue=Collapsed}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Bottom">
                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=HubTabTitle}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="46" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{PluginSettings Plugin=Kippix, Path=PageSub}" Style="{StaticResource KX_TextDim}" FontSize="18" TextTrimming="CharacterEllipsis" Margin="2,-4,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{PluginSettings Plugin=Kippix, Path=PageHint}" Style="{StaticResource KX_TextDim}" FontSize="16" VerticalAlignment="Bottom" Margin="24,0,4,10"
                                                   Visibility="{PluginSettings Plugin=Kippix, Path=HasHubPlainHint, FallbackValue=Collapsed}" />
                                        <Border Grid.Column="1" VerticalAlignment="Bottom" CornerRadius="22" Background="#12FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="10,6" Margin="24,0,0,4"
                                                Visibility="{PluginSettings Plugin=Kippix, Path=HasHubStepper, FallbackValue=Collapsed}">
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl ContentTemplate="{DynamicResource ButtonPromptLT}" Width="26" Height="26" Focusable="False" />
                                                <TextBlock Text="{PluginSettings Plugin=Kippix, Path=PageHint}" Style="{StaticResource KX_TextSub}" FontSize="16" Margin="12,0" VerticalAlignment="Center" />
                                                <ContentControl ContentTemplate="{DynamicResource ButtonPromptRT}" Width="26" Height="26" Focusable="False" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18" Visibility="{PluginSettings Plugin=Kippix, Path=IsNotProfileHub, FallbackValue=Visible}">
                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=PageTitle}" Style="{StaticResource KX_Text}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="48" />
                                        <TextBlock Text="{PluginSettings Plugin=Kippix, Path=PageSub}" Style="{StaticResource KX_TextSub}" FontSize="21" />
                                    </StackPanel>
                                    <!-- ========== COMMUNITY tabs (Settings › Community, the profile menu's Community): All, Layouts, Look packs, Widgets, Yours; LB / RB or A on one (ThemeApi.CommunityHub.cs) ========== -->
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,18" Visibility="{PluginSettings Plugin=Kippix, Path=IsCommunityHub, FallbackValue=Collapsed}">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptLB}" Width="30" Height="30" Focusable="False" Opacity="0.7" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <ItemsControl x:Name="KX_CommunityTabList" ItemsSource="{PluginSettings Plugin=Kippix, Path=CommunityTabs}" Focusable="False">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ButtonEx Command="{Binding Command}" FocusVisualStyle="{x:Null}" Margin="0,0,6,0">
                                                            <ButtonEx.Template>
                                                                <ControlTemplate TargetType="ButtonEx">
                                                                    <Grid Background="Transparent">
                                                                        <Border x:Name="Pill" CornerRadius="24" Height="48" Padding="20,0" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <Path x:Name="TabIcon" Width="20" Height="20" Margin="0,0,10,0" Opacity="0.6">
                                                                                    <Path.Style>
                                                                                        <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                                                            <Setter Property="Data" Value="{StaticResource KX_IconStar}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Icon}" Value="layout"><Setter Property="Data" Value="{StaticResource KX_IconLayout}" /></DataTrigger>
                                                                                                <DataTrigger Binding="{Binding Icon}" Value="palette"><Setter Property="Data" Value="{StaticResource KX_IconPalette}" /></DataTrigger>
                                                                                                <DataTrigger Binding="{Binding Icon}" Value="grid"><Setter Property="Data" Value="{StaticResource KX_IconGrid}" /></DataTrigger>
                                                                                                <DataTrigger Binding="{Binding Icon}" Value="controller"><Setter Property="Data" Value="{StaticResource KX_IconController}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="profile"><Setter Property="Data" Value="{StaticResource KX_IconProfile}" /></DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Path.Style>
                                                                                </Path>
                                                                                <TextBlock x:Name="TabText" Text="{Binding Text}" Style="{StaticResource KX_TextDim}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="18" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border x:Name="TabBar" Height="3" Width="28" CornerRadius="1.5" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-9" Background="{DynamicResource KX_AccentBrush}" Opacity="0" />
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter TargetName="Pill" Property="Background" Value="#24FFFFFF" />
                                                                            <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource KX_TextBrush}" />
                                                                            <Setter TargetName="TabIcon" Property="Opacity" Value="1" />
                                                                            <Setter TargetName="TabBar" Property="Opacity" Value="1" />
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="#44FFFFFF" /></Trigger>
                                                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource KX_AccentBrush}" /></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ButtonEx.Template>
                                                        </ButtonEx>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptRB}" Width="30" Height="30" Focusable="False" Opacity="0.7" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Grid.Row="1" Height="1" Background="#14FFFFFF" Margin="0,16,0,0" />
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{PluginSettings Plugin=Kippix, Path=PageHint}" Style="{StaticResource KX_TextDim}" FontSize="17" Margin="0,14,0,0"
                                               Visibility="{PluginSettings Plugin=Kippix, Path=IsNotProfileHub, FallbackValue=Visible}" />
                                    <!-- the profile's hints: LB / RB tabs, A open, B back (0.99.24: LT / RT for the month / year are by the tab's heading) -->
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0" Opacity="0.8" Visibility="{PluginSettings Plugin=Kippix, Path=IsProfileHub, FallbackValue=Collapsed}">
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptLB}" Width="24" Height="24" Focusable="False" />
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptRB}" Width="24" Height="24" Focusable="False" Margin="6,0,0,0" />
                                        <TextBlock Text="{DynamicResource LOC_KX_HubHintTabs}" Style="{StaticResource KX_TextDim}" FontSize="17" Margin="8,0,28,0" VerticalAlignment="Center" />
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptA}" Width="24" Height="24" Focusable="False" />
                                        <TextBlock Text="{DynamicResource LOC_KX_HubHintOpen}" Style="{StaticResource KX_TextDim}" FontSize="17" Margin="8,0,28,0" VerticalAlignment="Center" />
                                        <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Width="24" Height="24" Focusable="False" />
                                        <TextBlock Text="{DynamicResource LOC_KX_Back}" Style="{StaticResource KX_TextDim}" FontSize="17" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Grid>
                                    <!-- the profile's Library tab: every game you own, in rows that are only drawn (and their covers only read) when they're on screen -->
                                    <DockPanel Visibility="{PluginSettings Plugin=Kippix, Path=IsHubLibrary, FallbackValue=Collapsed}">
                                        <ItemsControl x:Name="KX_HubLibChips" DockPanel.Dock="Top" ItemsSource="{PluginSettings Plugin=Kippix, Path=PageChips}" Focusable="False" Margin="0,0,0,4" HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ButtonEx Style="{StaticResource KX_ChipButton}" Command="{Binding Command}" Margin="6,0,6,10">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Width="20" Height="20" Margin="0,0,10,0">
                                                                <Path.Style>
                                                                    <Style TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Icon}" Value="sort"><Setter Property="Data" Value="{StaticResource KX_IconSort}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Icon}" Value="filter"><Setter Property="Data" Value="{StaticResource KX_IconFilter}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Icon}" Value="search"><Setter Property="Data" Value="{StaticResource KX_IconSearch}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Icon}" Value="store"><Setter Property="Data" Value="{StaticResource KX_IconStore}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Icon}" Value="close"><Setter Property="Data" Value="{StaticResource KX_IconClose}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                                            <Ellipse Width="9" Height="9" Margin="12,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource KX_AccentBrush}"
                                                                     Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </ButtonEx>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock DockPanel.Dock="Top" Text="{PluginSettings Plugin=Kippix, Path=HubLibStatus}" Style="{StaticResource KX_TextSub}" TextWrapping="Wrap" MaxWidth="1100" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,24,0,18"
                                                   Visibility="{PluginSettings Plugin=Kippix, Path=HasHubLibStatus, FallbackValue=Collapsed}" />
                                        <!-- (a ScrollViewer clips inside its Padding, so the room for a highlighted cover's glow is inside: the list reaches 24 px past the page on
                                              each side with the rows centred in it, and each cover has 18 px of clear space above it inside its button, so a cover at an edge
                                              or a row scrolled to the top keeps its whole glow) -->
                                        <ItemsControl x:Name="KX_HubLibList" ItemsSource="{PluginSettings Plugin=Kippix, Path=HubLibRows}" Focusable="False" Margin="-24,-12,-24,0"
                                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                                            <ItemsControl.Template>
                                                <ControlTemplate TargetType="ItemsControl">
                                                    <ScrollViewer Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
