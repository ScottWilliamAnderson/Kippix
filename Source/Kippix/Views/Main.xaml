<ButtonEx x:Name="KX_GalleryShowVideos" Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=GalleryShowCommand}" CommandParameter="2"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource LOC_KX_VideosOnly}" VerticalAlignment="Center" /></StackPanel><Border Height="3" CornerRadius="1.5" Background="{DynamicResource KX_AccentBrush}" Margin="0,4,0,-7" Visibility="{PluginSettings Plugin=Kippix, Path=GalleryShowVideos, FallbackValue=Collapsed}" /></StackPanel></ButtonEx>
