<ButtonEx x:Name="KX_GallerySelDelete" Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=GallerySelectionDeleteCommand}"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="{StaticResource KX_IconTrash}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" Margin="0,0,10,0" /><TextBlock Text="{DynamicResource LOC_KX_Delete}" VerticalAlignment="Center" /></StackPanel></StackPanel></ButtonEx>
<ButtonEx x:Name="KX_GallerySelMove" Style="{StaticResource KX_ChipButton}" Command="{PluginSettings Plugin=Kippix, Path=GallerySelectionMoveCommand}"><StackPanel><StackPanel Orientation="Horizontal"><Path Data="{StaticResource KX_IconFolder}" Style="{StaticResource KX_IconPath}" Width="20" Height="20" Margin="0,0,10,0" /><TextBlock Text="{DynamicResource LOC_KX_MoveToGame}" VerticalAlignment="Center" /></StackPanel></StackPanel></ButtonEx>
