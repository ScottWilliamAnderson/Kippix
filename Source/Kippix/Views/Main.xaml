                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ButtonEx Style="{StaticResource KX_MenuButton}" Command="{Binding OpenCommand}" Margin="0,0,8,8" Padding="16,0" Height="60" MinHeight="0">
