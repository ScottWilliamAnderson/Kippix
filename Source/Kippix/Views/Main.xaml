taTrigger><DataTrigger Binding="{Binding Icon}" Value="hide"><Setter Property="Data" Value="{StaticResource KX_IconEyeOff}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="home"><Setter Property="Data" Value="{StaticResource KX_IconHome}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="hourglass"><Setter Property="Data" Value="{StaticResource KX_IconHourglass}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="info"><Setter Property="Data" Value="{StaticResource KX_IconInfo}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="keyboard"><Setter Property="Data" Value="{StaticResource KX_IconHash}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="layout"><Setter Property="Data" Value="{StaticResource KX_IconLayout}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="leave"><Setter Property="Data" Value="{StaticResource KX_IconLeave}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="link"><Setter Property="Data" Value="{StaticResource KX_IconLink}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="lock"><Setter Property="Data" Value="{StaticResource KX_IconLock}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="media"><Setter Property="Data" Value="{StaticResource KX_IconMedia}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="localmedia"><Setter Property="Data" Value="{StaticResource KX_IconLocalMedia}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="menu"><Setter Property="Data" Value="{StaticResource KX_IconMenu}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="mic"><Setter Property="Data" Value="{StaticResource KX_IconMic}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="moon"><Setter Property="Data" Value="{StaticResource KX_IconMoon}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="more"><Setter Property="Data" Value="{StaticResource KX_IconDots}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="move"><Setter Property="Data" Value="{StaticResource KX_IconMove}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="mute"><Setter Property="Data" Value="{StaticResource KX_IconMute}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="netflix"><Setter Property="Data" Value="{StaticResource KX_IconTv}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="news"><Setter Property="Data" Value="{StaticResource KX_IconNews}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="note"><Setter Property="Data" Value="{StaticResource KX_IconNote}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="options"><Setter Property="Data" Value="{StaticResource KX_IconDots}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="palette"><Setter Property="Data" Value="{StaticResource KX_IconPalette}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="paste"><Setter Property="Data" Value="{StaticResource KX_IconNote}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="pause"><Setter Property="Data" Value="{StaticResource KX_IconPause}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="phone"><Setter Property="Data" Value="{StaticResource KX_IconPhone}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="picture"><Setter Property="Data" Value="{StaticResource KX_IconGallery}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="pin"><Setter Property="Data" Value="{StaticResource KX_IconPin}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="place"><Setter Property="Data" Value="{StaticResource KX_IconFolder}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="play"><Setter Property="Data" Value="{StaticResource KX_IconPlay}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="power"><Setter Property="Data" Value="{StaticResource KX_IconPower}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="preset"><Setter Property="Data" Value="{StaticResource KX_IconStar}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="prime"><Setter Property="Data" Value="{StaticResource KX_IconFilmStrip}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="profile"><Setter Property="Data" Value="{StaticResource KX_IconProfile}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="refresh"><Setter Property="Data" Value="{StaticResource KX_IconRefresh}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="remove"><Setter Property="Data" Value="{StaticResource KX_IconClose}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="reply"><Setter Property="Data" Value="{StaticResource KX_IconReply}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="rewind"><Setter Property="Data" Value="{StaticResource KX_IconRewind}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="search"><Setter Property="Data" Value="{StaticResource KX_IconSearch}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="select"><Setter Property="Data" Value="{StaticResource KX_IconSelect}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="servers"><Setter Property="Data" Value="{StaticResource KX_IconServers}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="settings"><Setter Property="Data" Value="{StaticResource KX_IconGear}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="shape"><Setter Property="Data" Value="{StaticResource KX_IconSelect}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="shelf"><Setter Property="Data" Value="{StaticResource KX_IconShelf}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="sliders"><Setter Property="Data" Value="{StaticResource KX_IconSliders}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="sort"><Setter Property="Data" Value="{StaticResource KX_IconSort}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="speaker"><Setter Property="Data" Value="{StaticResource KX_IconSpeaker}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="star"><Setter Property="Data" Value="{StaticResource KX_IconStar}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="store"><Setter Property="Data" Value="{StaticResource KX_IconStore}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="sun"><Setter Property="Data" Value="{StaticResource KX_IconSun}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="tag"><Setter Property="Data" Value="{StaticResource KX_IconTag}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="trash"><Setter Property="Data" Value="{StaticResource KX_IconTrash}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="trophy"><Setter Property="Data" Value="{StaticResource KX_IconTrophy}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="tune"><Setter Property="Data" Value="{StaticResource KX_IconTune}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="tv"><Setter Property="Data" Value="{StaticResource KX_IconTv}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="up"><Setter Property="Data" Value="{StaticResource KX_IconUp}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="upload"><Setter Property="Data" Value="{StaticResource KX_IconUpload}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="use"><Setter Property="Data" Value="{StaticResource KX_IconCheck}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="video"><Setter Property="Data" Value="{StaticResource KX_IconVideo}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="weather"><Setter Property="Data" Value="{StaticResource KX_IconCloud}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="wifi"><Setter Property="Data" Value="{StaticResource KX_IconWifi}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="youtube"><Setter Property="Data" Value="{StaticResource KX_IconVideo}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="zoomin"><Setter Property="Data" Value="{StaticResource KX_IconZoomIn}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="zoomout"><Setter Property="Data" Value="{StaticResource KX_IconZoomOut}" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Icon}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding HasThumb}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                    <!-- rows: cards two to a line; a heading takes the whole line (so the cards after it start a new one) -->
                                    <ItemsPanelTemplate x:Key="KX_HubRowPanel"><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    <DataTemplate x:Key="KX_HubRowItemTemplate">
