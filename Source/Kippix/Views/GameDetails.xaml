                                       Visibility="{PluginSettings Plugin=Kippix, Path=DetShowDate, FallbackValue=Collapsed}" />
                        </Grid>
                    </Grid>

                    <!-- (0.99.69) the entrance (the page's fade, the background settling in, the parts fading and rising into place) is
