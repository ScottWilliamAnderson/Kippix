<!-- (0.99.55) the row runs edge to edge (it reaches over the lower page's 96 px side margins; the pictures start 96 px in, where the
     other parts line up) and slides sideways to keep the highlighted one in sight (the helper moves it). Not a scroll view: one of
     those keeps Up / Down for itself, so the highlight couldn't leave the row. -->
<Canvas x:Name="KX_DetCapturesClip" ClipToBounds="True" Height="138" Margin="-96,0,-96,0">
<ItemsControl x:Name="KX_DetCapturesList" ItemsSource="{PluginSettings Plugin=Kippix, Path=DetCaptures}" Focusable="False" Canvas.Left="96">
<ItemsControl.RenderTransform><TranslateTransform /></ItemsControl.RenderTransform>
<ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate><DataTemplate>
<ButtonEx Command="{Binding Command}" FocusVisualStyle="{x:Null}" Margin="0,0,2,0" Focusable="{PluginSettings Plugin=Kippix, Path=DetIntCaptures, FallbackValue=True}">
<ButtonEx.Template><ControlTemplate TargetType="ButtonEx">
<!-- (0.99.20) the size is on the picture, not round the ring: a sized box cut its ring off on every side -->
<!-- (0.99.51) and the room for the ring is inside the part (no negative margins reaching past it): the part's own edges, or the lower page's top, cut it off -->
<Grid Margin="6">
<Grid Width="224" Height="126">
<Border CornerRadius="10" Background="#1FFFFFFF" />
<Border CornerRadius="10"><Border.Background><ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" /></Border.Background></Border>
<Border CornerRadius="8" Background="#CC0D0F12" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
<Path Data="{StaticResource KX_IconPlay}" Style="{StaticResource KX_IconPath}" Stroke="White" Fill="White" Width="10" Height="10" /></Border>
</Grid>
<Border x:Name="Ring" CornerRadius="12" Margin="-4" BorderThickness="2.5" BorderBrush="{DynamicResource KX_AccentBrush}" Opacity="0" IsHitTestVisible="False" />
</Grid>
<ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.5" /></Trigger></ControlTemplate.Triggers>
</ControlTemplate></ButtonEx.Template>
</ButtonEx>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</Canvas>
</StackPanel>
                                        <StackPanel x:Name="KX_SecSimilar" Margin="0,0,0,90" Visibility="{PluginSettings Plugin=Kippix, Path=SlotDetSimilar, FallbackValue=Collapsed}">
<TextBlock Text="{DynamicResource LOC_KX_SecMoreLikeThis}" Style="{StaticResource KX_SectionHeader}" Margin="6,0,0,4" />
<!-- room round the covers for the highlight ring (and above the button hints at the bottom of the screen). The row reaches 12 px past the
     covers on every side (negative margin, padding back in: the covers sit where they did), so the ring is never cut off at its edges.
     The covers' size is set in Free move (Y on More like this) or the part's settings; as many as fit across are shown. -->
<ItemsControl ItemsSource="{PluginSettings Plugin=Kippix, Path=DetSimilar}" Focusable="False" Margin="0" Padding="6,6,6,10">
<ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<!-- the highlighted cover draws over its neighbours (triangles fit together, overlapping) -->
<ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Panel.ZIndex" Value="90" /></Trigger></Style.Triggers></Style></ItemsControl.ItemContainerStyle>
<!-- each cover's shape (More like this's Cover shape: the home cards' shapes) comes with it: the helper sets its outline, clip and the room after it -->
<ItemsControl.ItemTemplate><DataTemplate>
<ButtonEx Command="{Binding Command}" FocusVisualStyle="{x:Null}" Margin="{Binding TileMargin}" ToolTip="{Binding Name}" Focusable="{PluginSettings Plugin=Kippix, Path=DetIntSimilar, FallbackValue=True}"
          Width="{PluginSettings Plugin=Kippix, Path=DetSimilarTileW, FallbackValue=150}" Height="{PluginSettings Plugin=Kippix, Path=DetSimilarTileH, FallbackValue=225}">
<ButtonEx.Template><ControlTemplate TargetType="ButtonEx">
<Grid>
<Grid Clip="{Binding Clip}">
<Border Background="#FF1E2229" />
<TextBlock Text="{Binding Name}" Style="{StaticResource KX_Text}" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="10" />
<Border><Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" /></Border.Background></Border>
</Grid>
<Border x:Name="Ring" CornerRadius="12" Margin="-4" BorderThickness="2.5" BorderBrush="{DynamicResource KX_AccentBrush}" Opacity="0" IsHitTestVisible="False"
        Visibility="{Binding IsRounded, Converter={StaticResource BooleanToVisibilityConverter}}" />
<Path x:Name="RingShape" Data="{Binding Outline}" Stretch="Fill" Margin="-4" StrokeThickness="2.5" Stroke="{DynamicResource KX_AccentBrush}" Opacity="0" IsHitTestVisible="False"
      Visibility="{Binding IsCut, Converter={StaticResource BooleanToVisibilityConverter}}" />
</Grid>
<ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /><Setter TargetName="RingShape" Property="Opacity" Value="1" /></Trigger>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.5" /><Setter TargetName="RingShape" Property="Opacity" Value="0.5" /></Trigger></ControlTemplate.Triggers>
</ControlTemplate></ButtonEx.Template>
</ButtonEx>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel>
