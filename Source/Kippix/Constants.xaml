    <!-- Text sizes (Settings › Accessibility › Text size scales these) -->
    <sys:Double x:Key="KX_FontText">22</sys:Double>
    <sys:Double x:Key="KX_FontSub">20</sys:Double>
    <sys:Double x:Key="KX_FontDim">17</sys:Double>
    <sys:Double x:Key="KX_FontHeader">15</sys:Double>
    <sys:Double x:Key="KX_FontTitle">54</sys:Double>
    <sys:Double x:Key="KX_FontPill">24</sys:Double>
    <sys:Double x:Key="KX_FontChip">19</sys:Double>
    <!-- focus ring (Accessibility › High contrast makes it stronger) -->
    <SolidColorBrush x:Key="KX_FocusRingBrush" Color="#E9FFFFFF" />
    <Thickness x:Key="KX_FocusRingThickness">1.5</Thickness>

    <!-- Text styles -->
    <Style x:Key="KX_Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWeb}" />
        <Setter Property="FontSize" Value="{DynamicResource KX_FontText}" />
        <Setter Property="Foreground" Value="{DynamicResource KX_TextBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>
    <Style x:Key="KX_TextSub" TargetType="TextBlock" BasedOn="{StaticResource KX_Text}">
        <Setter Property="Foreground" Value="{DynamicResource KX_TextSubBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource KX_FontSub}" />
    </Style>
    <Style x:Key="KX_TextDim" TargetType="TextBlock" BasedOn="{StaticResource KX_Text}">
        <Setter Property="Foreground" Value="{DynamicResource KX_TextDimBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource KX_FontDim}" />
    </Style>
    <!-- a row that steps through values on A: what A changes it to, dim, after the value it has now ("Lower  ›  Tall").
         The helper's ...TextNext properties give the text (ThemeApi.CycleNext.cs); with none, nothing shows. -->
    <Style x:Key="KX_CycleNext" TargetType="TextBlock" BasedOn="{StaticResource KX_TextDim}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="MaxWidth" Value="260" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
        </Style.Triggers>
    </Style>
    <!-- small heading over a group of rows in the options -->
    <Style x:Key="KX_SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource KX_Text}">
        <Setter Property="Foreground" Value="{DynamicResource KX_TextDimBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWebBold}" />
        <Setter Property="FontSize" Value="{DynamicResource KX_FontHeader}" />
        <Setter Property="Margin" Value="20,18,16,4" />
    </Style>
    <Style x:Key="KX_TextTitle" TargetType="TextBlock" BasedOn="{StaticResource KX_Text}">
        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWebBold}" />
        <Setter Property="FontSize" Value="{DynamicResource KX_FontTitle}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Outline icon used inside buttons: follows the button's Foreground -->
    <Style x:Key="KX_IconPath" TargetType="Path">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
    </Style>

    <!-- Round icon button for the top bar -->
    <Style x:Key="KX_TopBarButton" TargetType="ButtonEx">
        <Setter Property="Foreground" Value="{DynamicResource KX_TextBrush}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="54" />
        <Setter Property="Height" Value="54" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="27" Background="Transparent"
                                BorderThickness="{DynamicResource KX_FocusRingThickness}" BorderBrush="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource KX_FocusFillBrush}" />
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource KX_FocusRingBrush}" />
                            <Setter TargetName="Fill" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="White" BlurRadius="12" ShadowDepth="0" Opacity="0.45" />
                                </Setter.Value>
                            </Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.1" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource KX_FocusFillBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Wide row button used in the side panels (options, downloads, Discord) -->
    <Style x:Key="KX_MenuButton" TargetType="ButtonEx">
        <Setter Property="Foreground" Value="{DynamicResource KX_TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="{DynamicResource KX_RowCorner}" Background="Transparent"
                                BorderThickness="{DynamicResource KX_FocusRingThickness}" BorderBrush="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource KX_FocusFillBrush}" />
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource KX_FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource KX_CardBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On/off switch row used for shortcut pinning -->
    <Style x:Key="KX_SwitchRow" TargetType="CheckBoxEx">
        <Setter Property="Foreground" Value="{DynamicResource KX_TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBoxEx">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="{DynamicResource KX_RowCorner}" Background="Transparent"
                                BorderThickness="{DynamicResource KX_FocusRingThickness}" BorderBrush="Transparent" />
                        <Grid Margin="20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Width="58" Height="32" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="16" Background="#33FFFFFF" />
                                <Ellipse x:Name="Knob" Width="24" Height="24" Fill="#FFB8C0CC"
                                         HorizontalAlignment="Left" Margin="4,0" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource KX_AccentBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="#FF101216" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource KX_FocusFillBrush}" />
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource KX_FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource KX_CardBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Large pill buttons on the game details page -->
    <Style x:Key="KX_PillButton" TargetType="ButtonEx">
        <Setter Property="Foreground" Value="{DynamicResource KX_TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Height" Value="62" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Padding" Value="30,0" />
        <Setter Property="FontSize" Value="{DynamicResource KX_FontPill}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="{DynamicResource KX_PillCorner}" Background="#1FFFFFFF"
                                BorderThickness="1.5" BorderBrush="#40FFFFFF" />
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{DynamicResource FontTitilliumWebBold}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource KX_PillFocusBrush}" />
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource KX_PillFocusBrush}" />
                            <Setter Property="Foreground" Value="#FF0D0F12" />
                            <Setter TargetName="Fill" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="White" BlurRadius="18" ShadowDepth="0" Opacity="0.35" />
                                </Setter.Value>
                            </Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small pill button (search, sort, filter on the achievements screen).
         Text inside should be a plain TextBlock (no style) so it turns dark when focused. -->
    <Style x:Key="KX_ChipButton" TargetType="ButtonEx" BasedOn="{StaticResource KX_PillButton}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="52" />
        <Setter Property="FontSize" Value="{DynamicResource KX_FontChip}" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- Side panel shell -->
    <Style x:Key="KX_Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource KX_PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KX_HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource KX_PanelCorner}" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.6" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Info chip: icon + text, no background -->
    <Style x:Key="KX_InfoIcon" TargetType="Path" BasedOn="{StaticResource KX_IconPath}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Stroke" Value="{DynamicResource KX_TextSubBrush}" />
        <Setter Property="Margin" Value="0,0,9,0" />
    </Style>
</ResourceDictionary>
