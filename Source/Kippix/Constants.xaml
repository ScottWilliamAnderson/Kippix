    <!-- invisible button over a video: shows a white ring when highlighted -->
    <Style x:Key="KX_VideoButton" TargetType="ButtonEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Grid Background="Transparent">
                        <Border x:Name="Ring" CornerRadius="14" BorderThickness="3" BorderBrush="Transparent" />
                        <Border x:Name="Hint" CornerRadius="20" Background="#CC111317" Padding="14,6" Margin="0,0,0,14"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#F2FFFFFF" />
                            <Setter TargetName="Hint" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#99FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
