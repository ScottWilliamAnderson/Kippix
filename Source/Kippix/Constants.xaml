    <!-- ============================================================
         Kippix - colours, brushes and shared styles.
         Overriding Playnite's default keys here also restyles Playnite's
         own menus (main menu, game menu, settings) to match the theme.
         ============================================================ -->

    <!-- (1.0.0) a game with no cover: nothing instead of Playnite's controller picture, so the card shows the game's name
         (the card's own fallback, ListGameItemTemplate) -->
    <BitmapImage x:Key="DefaultGameCover" UriSource="{ThemeFile 'Images/no-cover.png'}" />

    <!-- Playnite default keys (overridden) -->
    <Color x:Key="GlyphColor">#FFFFFFFF</Color>
    <Color x:Key="GlyphLightColor">#FFDCE3EE</Color>
    <Color x:Key="SelectionLightColor">#FFB8C0CC</Color>
    <Color x:Key="OverlayColor">#CC000000</Color>
    <Color x:Key="ControlBackgroundColor">#FF262A33</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF14171C</Color>
    <Color x:Key="TextColor">#FFF4F6FA</Color>
    <Color x:Key="TextColorDark">#FF8A919C</Color>

    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="{DynamicResource GlyphLightColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="{DynamicResource SelectionLightColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{DynamicResource OverlayColor}" />

    <SolidColorBrush x:Key="MainBackgourndBrush" Color="#FF07080A" />
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="BottomBarBackgroundBrush" Color="Transparent" />
