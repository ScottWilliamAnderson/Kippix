    <sys:String x:Key="LOC_KX_AnimNoArtPicture">When there's no animated art: Show the picture</sys:String>
    <sys:String x:Key="LOC_KX_AnimNoArtTrailerSub">Plays the game's trailer muted instead</sys:String>
    <sys:String x:Key="LOC_KX_AnimNoArtPictureSub">Keeps the normal cover and background</sys:String>
    <sys:String x:Key="LOC_KX_AnimPreviewCard">Trailer previews play in the card (Home settings), so the card waits for those; the background can still use the trailer</sys:String>
    <sys:String x:Key="LOC_KX_AnimPreviewBg">Trailer previews play in the background (Home settings), so the background waits for those; the card can still use the trailer</sys:String>
